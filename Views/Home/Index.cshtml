@{
    ViewData["Title"] = "Home";
}

<div class="hero-section bg-primary text-white py-5 mb-5">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-lg-6">
                <h1 class="display-4 fw-bold">Welcome to Airline Reservation System</h1>
                <p class="lead">Book your flights easily and manage your travel plans with our comprehensive airline reservation system.</p>
                
                <div class="mt-4">
                    <a class="btn btn-light btn-lg me-3" asp-controller="User" asp-action="Flights">
                        <i class="fas fa-search"></i> Find Flights
                    </a>
                    
                    @if (User.IsInRole("Admin"))
                    {
                        <a class="btn btn-outline-light btn-lg" asp-controller="Admin" asp-action="Dashboard">
                            <i class="fas fa-tachometer-alt"></i> Admin Dashboard
                        </a>
                    }
                    else
                    {
                        <a class="btn btn-outline-light btn-lg me-2" asp-controller="Home" asp-action="Dashboard">
                            <i class="fas fa-tachometer-alt"></i> My Dashboard
                        </a>
                        <a class="btn btn-outline-light btn-lg" asp-controller="User" asp-action="MyBookings">
                            <i class="fas fa-ticket-alt"></i> My Bookings
                        </a>
                    }
                </div>
            </div>
            <div class="col-lg-6 text-center">
                <i class="fas fa-plane-departure" style="font-size: 15rem; opacity: 0.8;"></i>
            </div>
        </div>
    </div>
</div>

<div class="container">
    <div class="row text-center mb-5">
        <div class="col-md-4">
            <div class="card border-0 shadow-sm">
                <div class="card-body">
                    <i class="fas fa-search text-primary mb-3" style="font-size: 3rem;"></i>
                    <h4>Search Flights</h4>
                    <p>Find the perfect flight from our extensive database of available routes.</p>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 shadow-sm">
                <div class="card-body">
                    <i class="fas fa-ticket-alt text-success mb-3" style="font-size: 3rem;"></i>
                    <h4>Book Instantly</h4>
                    <p>Secure your seats with our easy and fast booking process.</p>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 shadow-sm">
                <div class="card-body">
                    <i class="fas fa-cog text-warning mb-3" style="font-size: 3rem;"></i>
                    <h4>Manage Bookings</h4>
                    <p>Easily view, modify, or cancel your bookings anytime.</p>
                </div>
            </div>
        </div>
    </div>
</div>