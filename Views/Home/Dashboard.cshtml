 @model AirlineReservationSystem.ViewModels.DashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
    
    // Auto-update booking statuses based on flight times
    var updatedBookings = Model.UserBookings.Select(booking =>
    {
        // Check if flight has departed and should be marked as completed
        if (booking.Status == "Confirmed" && 
            (booking.RescheduledArrivalTime ?? booking.Flight.ArrivalTime) < DateTime.Now)
        {
            booking.Status = "Completed";
        }
        return booking;
    }).ToList(); 
} 

<div class="container">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="mb-0">My Dashboard</h2>
        <div class="text-muted fw-medium">
            <i class="fas fa-chart-line me-2"></i>Flight Overview 
        </div>
    </div>
    
    <!-- Statistics Cards -->
    <div class="row g-3 mb-4">
        <div class="col-xl-3 col-md-6 col-12">
            <div class="card text-white bg-primary h-100 shadow-sm">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="card-title mb-2 opacity-90">Total Bookings</h6>
                            <h2 class="mb-1">@Model.UserBookings.Count</h2>
                            <small class="opacity-75">All bookings</small>
                        </div>
                        <div class="stat-icon">
                            <i class="fas fa-ticket-alt fa-2x opacity-75"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6 col-12">
            <div class="card text-white bg-success h-100 shadow-sm">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="card-title mb-2 opacity-90">Confirmed</h6>
                            <h2 class="mb-1">@Model.UserBookings.Count(b => b.Status == "Confirmed")</h2>
                            <small class="opacity-75">Active bookings</small>
                        </div>
                        <div class="stat-icon">
                            <i class="fas fa-check-circle fa-2x opacity-75"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6 col-12">
            <div class="card text-white bg-info h-100 shadow-sm">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="card-title mb-2 opacity-90">Completed</h6>
                            <h2 class="mb-1">@Model.UserBookings.Count(b => b.Status == "Completed")</h2>
                            <small class="opacity-75">Finished journeys</small>
                        </div>
                        <div class="stat-icon">
                            <i class="fas fa-flag-checkered fa-2x opacity-75"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6 col-12">
            <div class="card text-white bg-danger h-100 shadow-sm">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="card-title mb-2 opacity-90">Cancelled</h6>
                            <h2 class="mb-1">@Model.UserBookings.Count(b => b.Status == "Cancelled")</h2>
                            <small class="opacity-75">Cancelled bookings</small>
                        </div>
                        <div class="stat-icon">
                            <i class="fas fa-times-circle fa-2x opacity-75"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Quick Actions -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="card shadow-sm">
                <div class="card-header bg-dark text-white">
                    <h6 class="mb-0"><i class="fas fa-bolt me-2"></i>Quick Actions</h6>
                </div>
                <div class="card-body">
                    <div class="row g-3">
                        <div class="col-md-6 col-12">
                            <a asp-controller="User" asp-action="Flights" class="btn btn-primary w-100 h-100 py-3">
                                <i class="fas fa-plane fa-2x mb-2"></i>
                                <div>Book New Flight</div>
                                <small class="text-light opacity-75">Find available flights</small>
                            </a>
                        </div>
                        <div class="col-md-6 col-12">
                            <a asp-controller="User" asp-action="MyBookings" class="btn btn-success w-100 h-100 py-3">
                                <i class="fas fa-list fa-2x mb-2"></i>
                                <div>View All Bookings</div>
                                <small class="text-light opacity-75">Manage reservations</small>
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    
    <!-- Recent Bookings -->
    <div class="row">
        <div class="col-12">
            <div class="card shadow-sm">
                <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center">
                    <h6 class="mb-0"><i class="fas fa-clock me-2"></i>Recent Bookings</h6>
                    <a asp-controller="User" asp-action="MyBookings" class="btn btn-sm btn-light">
                        <i class="fas fa-external-link-alt me-1"></i>View All
                    </a>
                </div>
                <div class="card-body p-0">
                    @if (Model.UserBookings.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-hover mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th>Booking</th>
                                        <th>Flight Details</th>
                                        <th>Travel Date</th>
                                        <th>Passengers</th>
                                        <th>Amount</th>
                                        <th>Status</th>
                                        <th>Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var booking in Model.UserBookings.Take(5))
                                    {
                                        var isRescheduled = booking.RescheduledDepartureTime.HasValue && booking.RescheduledArrivalTime.HasValue;
                                        var flightTime = isRescheduled ? booking.RescheduledArrivalTime : booking.Flight.ArrivalTime;
                                        var isFlightCompleted = flightTime.HasValue && flightTime.Value < DateTime.Now;
                                        
                                        <tr>
                                            <td>
                                                <div class="d-flex flex-column">
                                                    <small class="text-muted mb-1">Booking ID</small>
                                                    <strong class="text-primary">@booking.BookingId.ToString().Substring(0, 8)...</strong>
                                                    <small class="text-muted">@booking.BookingDate.ToString("MMM dd, yyyy")</small>
                                                    @if (isRescheduled)
                                                    {
                                                        <span class="badge bg-warning text-white mt-1">
                                                            <i class="fas fa-clock me-1"></i>Rescheduled
                                                        </span>
                                                    }
                                                </div>
                                            </td>
                                            <td>
                                                <div class="d-flex flex-column">
                                                    <div class="d-flex align-items-center mb-1">
                                                        <i class="fas fa-plane text-primary me-2"></i>
                                                        <strong class="text-dark">@booking.Flight.FlightNumber</strong>
                                                    </div>
                                                    <div class="route-badge mb-1">
                                                        <span class="badge bg-light text-dark border">
                                                            <i class="fas fa-route me-1"></i>
                                                            @booking.Flight.DepartureCity → @booking.Flight.ArrivalCity
                                                        </span>
                                                    </div>
                                                    <small class="text-muted">
                                                        <i class="fas fa-building me-1"></i>@booking.Flight.Airline
                                                    </small>
                                                </div>
                                            </td>
                                            <td>
                                                <div class="d-flex flex-column">
                                                    @if (isRescheduled)
                                                    {
                                                        <!-- Rescheduled Flight Times -->
                                                        <div class="rescheduled-flight-times mb-2 p-2 bg-warning bg-opacity-20 rounded border border-warning">
                                                            <small class="text-dark fw-bold d-block mb-1">
                                                                <i class="fas fa-clock me-1 text-warning"></i>New Schedule
                                                            </small>
                                                            <div class="d-flex align-items-center mb-1">
                                                                <i class="fas fa-plane-departure text-warning me-2"></i>
                                                                <strong class="text-dark">@booking.RescheduledDepartureTime?.ToString("MMM dd, yyyy")</strong>
                                                            </div>
                                                            <div class="d-flex justify-content-between small">
                                                                <span class="text-dark fw-bold">@booking.RescheduledDepartureTime?.ToString("HH:mm")</span>
                                                                <i class="fas fa-arrow-right text-dark mx-2"></i>
                                                                <span class="text-dark fw-bold">@booking.RescheduledArrivalTime?.ToString("HH:mm")</span>
                                                            </div>
                                                            <small class="text-dark d-block mt-1">
                                                                @booking.RescheduledArrivalTime?.ToString("MMM dd")
                                                            </small>
                                                        </div>
                                                        
                                                        <!-- Original Flight Times -->
                                                        <div class="original-flight-times p-2 bg-light rounded border">
                                                            <small class="text-muted d-block mb-1">Original Schedule</small>
                                                            <div class="d-flex justify-content-between small text-muted">
                                                                <span>@booking.Flight.DepartureTime.ToString("MMM dd, HH:mm")</span>
                                                                <i class="fas fa-arrow-right mx-2"></i>
                                                                <span>@booking.Flight.ArrivalTime.ToString("MMM dd, HH:mm")</span>
                                                            </div>
                                                        </div>
                                                    }
                                                    else
                                                    {
                                                        <!-- Regular Flight Times -->
                                                        <div class="regular-flight-times">
                                                            <div class="d-flex align-items-center mb-1">
                                                                <i class="fas fa-plane-departure text-primary me-2"></i>
                                                                <strong class="text-dark">@booking.Flight.DepartureTime.ToString("MMM dd, yyyy")</strong>
                                                            </div>
                                                            <div class="d-flex justify-content-between align-items-center mb-1">
                                                                <span class="fw-bold text-dark">@booking.Flight.DepartureTime.ToString("HH:mm")</span>
                                                                <i class="fas fa-arrow-right text-muted mx-2"></i>
                                                                <span class="fw-bold text-dark">@booking.Flight.ArrivalTime.ToString("HH:mm")</span>
                                                            </div>
                                                            <div class="d-flex justify-content-between small text-muted">
                                                                <span>@booking.Flight.DepartureCity</span>
                                                                <span>@booking.Flight.ArrivalCity</span>
                                                            </div>
                                                            <small class="text-muted d-block mt-1">
                                                                Duration: @GetFlightDuration(booking.Flight.DepartureTime, booking.Flight.ArrivalTime)
                                                            </small>
                                                        </div>
                                                    }
                                                </div>
                                            </td>
                                            <td>
                                                <div class="text-center">
                                                    <span class="passenger-count fw-bold text-dark">@booking.NumberOfPassengers</span>
                                                    <small class="d-block text-muted">passenger@(booking.NumberOfPassengers != 1 ? "s" : "")</small>
                                                </div>
                                            </td>
                                            <td>
                                                <div class="text-end">
                                                    <strong class="text-success">$@booking.TotalAmount.ToString("N2")</strong>
                                                    @if (booking.NumberOfPassengers > 1)
                                                    {
                                                        <small class="d-block text-muted">
                                                            $@((booking.TotalAmount / booking.NumberOfPassengers).ToString("N2")) each
                                                        </small>
                                                    }
                                                </div>
                                            </td>
                                            <td>
                                                <span class="badge @GetStatusBadgeClass(booking.Status) px-2 py-1">
                                                    @if (isRescheduled && booking.Status == "Confirmed")
                                                    {
                                                        <i class="fas fa-clock me-1"></i>
                                                    }
                                                    else if (booking.Status == "Completed")
                                                    {
                                                        <i class="fas fa-flag-checkered me-1"></i>
                                                    }
                                                    @booking.Status
                                                    @if (isFlightCompleted && booking.Status == "Completed")
                                                    {
                                                        <i class="fas fa-sync-alt ms-1" title="Auto-completed"></i>
                                                    }
                                                </span>
                                            </td>
                                            <td>
                                                <div class="action-buttons">
                                                    <!-- View Receipt Button - Available for ALL Statuses -->
                                                    <div class="btn-group-vertical btn-group-sm">
                                                        <!-- View Receipt Button - Always Visible -->
                                                        <a href="#" class="btn btn-outline-info mb-1" 
                                                           data-bs-toggle="modal" data-bs-target="#receiptModal"
                                                           onclick="setReceiptDetails('@booking.BookingId', '@booking.BookingReference', '@booking.Flight.FlightNumber', '@booking.Flight.DepartureCity', '@booking.Flight.ArrivalCity', '@(isRescheduled && booking.RescheduledDepartureTime.HasValue ? booking.RescheduledDepartureTime.Value.ToString("MMM dd, yyyy HH:mm") : booking.Flight.DepartureTime.ToString("MMM dd, yyyy HH:mm"))', '@(isRescheduled && booking.RescheduledArrivalTime.HasValue ? booking.RescheduledArrivalTime.Value.ToString("MMM dd, yyyy HH:mm") : booking.Flight.ArrivalTime.ToString("MMM dd, yyyy HH:mm"))', '@booking.PassengerName', '@booking.NumberOfPassengers', '@booking.CarryOnBags', '@booking.CheckedBags', '@booking.TotalAmount.ToString("N2")', '@booking.BookingDate.ToString("MMM dd, yyyy")', '@booking.Status')">
                                                            <i class="fas fa-receipt me-1"></i> View Receipt
                                                        </a>

                                                        @if (booking.Status == "Confirmed")
                                                        {
                                                            <!-- Reschedule and Cancel only for Confirmed bookings -->
                                                            <a asp-controller="User" asp-action="EditBooking" asp-route-id="@booking.BookingId" 
                                                               class="btn btn-warning text-dark mb-1" title="Reschedule Booking">
                                                                <i class="fas fa-clock me-1"></i> Reschedule
                                                            </a>
                                                            <button type="button" class="btn btn-outline-danger" 
                                                                    onclick="confirmCancelBooking('@booking.BookingId', '@booking.Flight.FlightNumber', '@(isRescheduled ? booking.RescheduledDepartureTime?.ToString("MMM dd, yyyy HH:mm") : booking.Flight.DepartureTime.ToString("MMM dd, yyyy HH:mm"))')"
                                                                    title="Cancel Booking">
                                                                <i class="fas fa-times me-1"></i> Cancel
                                                            </button>
                                                        }
                                                        else
                                                        {
                                                            <!-- Print Receipt for Completed/Cancelled bookings -->
                                                            <a asp-controller="User" asp-action="BookingReceipt" asp-route-bookingId="@booking.BookingId" class="btn btn-outline-secondary" target="_blank">
                                                                <i class="fas fa-print me-1"></i> Print Receipt
                                                            </a>
                                                        }
                                                    </div>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-5">
                            <i class="fas fa-ticket-alt fa-3x text-muted mb-3"></i>
                            <h5 class="text-muted mb-2">No Bookings Yet</h5>
                            <p class="text-muted mb-4">You haven't made any flight bookings yet.</p>
                            <a asp-controller="User" asp-action="Flights" class="btn btn-primary btn-lg">
                                <i class="fas fa-plane me-2"></i>Book Your First Flight
                            </a>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Upcoming Trips -->
    @{
        var upcomingTrips = Model.UserBookings
            .Where(b => b.Status == "Confirmed" && 
                   (b.RescheduledDepartureTime ?? b.Flight.DepartureTime) > DateTime.Now)
            .OrderBy(b => b.RescheduledDepartureTime ?? b.Flight.DepartureTime)
            .Take(3)
            .ToList();
    }
    
    @if (upcomingTrips.Any())
    {
        <div class="row mt-4">
            <div class="col-12">
                <div class="card shadow-sm">
                    <div class="card-header bg-dark text-white">
                        <h6 class="mb-0"><i class="fas fa-plane-departure me-2"></i>Upcoming Trips</h6>
                    </div>
                    <div class="card-body">
                        <div class="row g-3">
                            @foreach (var trip in upcomingTrips)
                            {
                                var isRescheduled = trip.RescheduledDepartureTime.HasValue;
                                var departureTime = isRescheduled ? trip.RescheduledDepartureTime.Value : trip.Flight.DepartureTime;
                                var arrivalTime = isRescheduled ? trip.RescheduledArrivalTime.Value : trip.Flight.ArrivalTime;
                                
                                <div class="col-md-4">
                                    <div class="card border-success h-100">
                                        <div class="card-header bg-success text-white">
                                            <h6 class="mb-0">
                                                @trip.Flight.DepartureCity → @trip.Flight.ArrivalCity
                                                @if (isRescheduled)
                                                {
                                                    <span class="badge bg-warning text-white float-end">
                                                        <i class="fas fa-clock me-1"></i>Rescheduled
                                                    </span>
                                                }
                                            </h6>
                                        </div>
                                        <div class="card-body">
                                            <div class="mb-2">
                                                <small class="text-muted">Flight Number</small>
                                                <p class="fw-bold mb-1 text-dark">@trip.Flight.FlightNumber</p>
                                            </div>
                                            <div class="mb-2">
                                                <small class="text-muted">Airline</small>
                                                <p class="mb-1 text-dark">@trip.Flight.Airline</p>
                                            </div>
                                            <div class="mb-2">
                                                <small class="text-muted">Departure</small>
                                                <p class="fw-bold mb-1 text-dark">@departureTime.ToString("MMM dd, yyyy HH:mm")</p>
                                            </div>
                                            <div class="mb-2">
                                                <small class="text-muted">Arrival</small>
                                                <p class="fw-bold mb-1 text-dark">@arrivalTime.ToString("MMM dd, yyyy HH:mm")</p>
                                            </div>
                                            <div class="d-flex justify-content-between align-items-center">
                                                <span class="badge bg-primary">@trip.NumberOfPassengers passenger(s)</span>
                                                <strong class="text-success">$@trip.TotalAmount.ToString("N2")</strong>
                                            </div>
                                        </div>
                                        <div class="card-footer bg-transparent">
                                            <!-- Add Receipt Button to Upcoming Trips -->
                                            <a href="#" class="btn btn-sm btn-outline-info w-100 mb-2" 
                                               data-bs-toggle="modal" data-bs-target="#receiptModal"
                                               onclick="setReceiptDetails('@trip.BookingId', '@trip.BookingReference', '@trip.Flight.FlightNumber', '@trip.Flight.DepartureCity', '@trip.Flight.ArrivalCity', '@(isRescheduled ? trip.RescheduledDepartureTime?.ToString("MMM dd, yyyy HH:mm") : trip.Flight.DepartureTime.ToString("MMM dd, yyyy HH:mm"))', '@(isRescheduled ? trip.RescheduledArrivalTime?.ToString("MMM dd, yyyy HH:mm") : trip.Flight.ArrivalTime.ToString("MMM dd, yyyy HH:mm"))', '@trip.PassengerName', '@trip.NumberOfPassengers', '@trip.CarryOnBags', '@trip.CheckedBags', '@trip.TotalAmount.ToString("N2")', '@trip.BookingDate.ToString("MMM dd, yyyy")', '@trip.Status')">
                                                <i class="fas fa-receipt me-1"></i> View Receipt
                                            </a>
                                            <a asp-controller="User" asp-action="EditBooking" asp-route-id="@trip.BookingId" class="btn btn-sm btn-warning w-100">
                                                <i class="fas fa-clock me-1"></i> Reschedule
                                            </a>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

<!-- Receipt Modal -->
<div class="modal fade" id="receiptModal" tabindex="-1" aria-labelledby="receiptModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header bg-success text-white">
                <h5 class="modal-title" id="receiptModalLabel">
                    <i class="fas fa-receipt me-2"></i>Booking Receipt
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="receipt-content">
                    <div class="text-center mb-4">
                        <i class="fas fa-check-circle fa-3x text-success mb-3"></i>
                        <h4 class="text-success">Booking Confirmed</h4>
                        <p class="text-muted">Booking Reference: <strong id="receiptBookingReference"></strong></p>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-6">
                            <h6>Flight Details</h6>
                            <p class="mb-1"><strong>Flight:</strong> <span id="receiptFlightNumber"></span></p>
                            <p class="mb-1"><strong>Route:</strong> <span id="receiptRoute"></span></p>
                            <p class="mb-1"><strong>Departure:</strong> <span id="receiptDeparture"></span></p>
                            <p class="mb-1"><strong>Arrival:</strong> <span id="receiptArrival"></span></p>
                        </div>
                        <div class="col-md-6">
                            <h6>Passenger Details</h6>
                            <p class="mb-1"><strong>Name:</strong> <span id="receiptPassengerName"></span></p>
                            <p class="mb-1"><strong>Passengers:</strong> <span id="receiptPassengers"></span></p>
                            <p class="mb-1"><strong>Bags:</strong> <span id="receiptBags"></span></p>
                            <p class="mb-1"><strong>Status:</strong> <span id="receiptStatus"></span></p>
                        </div>
                    </div>

                    <div class="payment-section bg-light rounded p-3">
                        <h6>Payment Summary</h6>
                        <div class="row">
                            <div class="col-6">
                                <p class="mb-1">Total Amount:</p>
                            </div>
                            <div class="col-6 text-end">
                                <p class="mb-1 fw-bold text-success fs-5">$<span id="receiptTotalAmount"></span></p>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-6">
                                <p class="mb-0 text-muted">Booked on: <span id="receiptBookingDate"></span></p>
                            </div>
                            <div class="col-6 text-end">
                                <p class="mb-0 text-muted">Booking ID: <span id="receiptBookingId"></span></p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                <a href="#" class="btn btn-primary" id="printReceiptBtn">
                    <i class="fas fa-print me-2"></i>Print Receipt
                </a>
            </div>
        </div>
    </div>
</div>

<!-- Confirmation Modal -->
<div class="modal fade" id="cancelBookingModal" tabindex="-1" aria-labelledby="cancelBookingModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header bg-warning text-dark">
                <h5 class="modal-title" id="cancelBookingModalLabel">
                    <i class="fas fa-exclamation-triangle me-2"></i>Confirm Cancellation
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p>Are you sure you want to cancel your booking for flight <strong id="modalFlightNumber"></strong> on <strong id="modalDepartureTime"></strong>?</p>
                <div class="alert alert-danger mb-0">
                    <i class="fas fa-info-circle me-2"></i>
                    <strong>This action cannot be undone.</strong> Any payment will be refunded according to our cancellation policy.
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                    <i class="fas fa-times me-1"></i>Keep Booking
                </button>
                <form id="confirmCancelForm" method="post" asp-controller="User" asp-action="CancelBooking">
                    <input type="hidden" name="id" id="cancelBookingId" />
                    <button type="submit" class="btn btn-danger">
                        <i class="fas fa-check me-1"></i>Yes, Cancel Booking
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

@functions {
    public string GetStatusBadgeClass(string status)
    {
        return status switch
        {
            "Confirmed" => "bg-success",
            "Cancelled" => "bg-danger",
            "Completed" => "bg-info",
            _ => "bg-secondary"
        };
    }

    public string GetFlightDuration(DateTime departure, DateTime arrival)
    {
        var duration = arrival - departure;
        return $"{(int)duration.TotalHours}h {duration.Minutes}m";
    }
}

@section Scripts {
    <script>
        // Set receipt details for modal
        function setReceiptDetails(bookingId, bookingReference, flightNumber, departureCity, arrivalCity, departureTime, arrivalTime, passengerName, passengers, carryOnBags, checkedBags, totalAmount, bookingDate, status) {
            document.getElementById('receiptBookingId').textContent = bookingId.substring(0, 8) + '...';
            document.getElementById('receiptBookingReference').textContent = bookingReference;
            document.getElementById('receiptFlightNumber').textContent = flightNumber;
            document.getElementById('receiptRoute').textContent = departureCity + ' → ' + arrivalCity;
            document.getElementById('receiptDeparture').textContent = departureTime;
            document.getElementById('receiptArrival').textContent = arrivalTime;
            document.getElementById('receiptPassengerName').textContent = passengerName;
            document.getElementById('receiptPassengers').textContent = passengers + ' passenger' + (passengers > 1 ? 's' : '');
            document.getElementById('receiptBags').textContent = carryOnBags + ' carry-on, ' + checkedBags + ' checked';
            document.getElementById('receiptTotalAmount').textContent = totalAmount;
            document.getElementById('receiptBookingDate').textContent = bookingDate;
            document.getElementById('receiptStatus').textContent = status;

            // Set print button link
            document.getElementById('printReceiptBtn').href = '@Url.Action("BookingReceipt", "User")?bookingId=' + bookingId;
        }

        function confirmCancelBooking(bookingId, flightNumber, departureTime) {
            document.getElementById('modalFlightNumber').textContent = flightNumber;
            document.getElementById('modalDepartureTime').textContent = departureTime;
            document.getElementById('cancelBookingId').value = bookingId;
            
            const modal = new bootstrap.Modal(document.getElementById('cancelBookingModal'));
            modal.show();
            
            return false;
        }

        // Auto-refresh page every 60 seconds to update statuses
        setInterval(() => {
            console.log('Auto-refreshing dashboard...');
            window.location.reload();
        }, 60000);

        // Initialize tooltips
        document.addEventListener('DOMContentLoaded', function() {
            var tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'));
            var tooltipList = tooltipTriggerList.map(function (tooltipTriggerEl) {
                return new bootstrap.Tooltip(tooltipTriggerEl);
            });
        });
    </script>

    <style>
        .hover-scale {
            transition: transform 0.2s ease-in-out;
        }
        .hover-scale:hover {
            transform: scale(1.05);
        }
        a.text-decoration-none {
            text-decoration: none !important;
        }
        
        .receipt-content {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }
        
        .payment-section {
            border-left: 4px solid #28a745;
        }
    </style>
