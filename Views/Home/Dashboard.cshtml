@model AirlineReservationSystem.ViewModels.DashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
}

<div class="container">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="mb-0">My Dashboard</h2>
        <div class="text-muted fw-medium">
            <i class="fas fa-chart-line me-2"></i>Flight Overview
        </div>
    </div>
    
    <!-- Statistics Cards -->
    <div class="row g-3 mb-4">
        <div class="col-xl-3 col-md-6 col-12">
            <div class="card text-white bg-primary h-100 shadow-sm">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="card-title mb-2 opacity-90">Total Bookings</h6>
                            <h2 class="mb-1">@Model.UserBookings.Count</h2>
                            <small class="opacity-75">All bookings</small>
                        </div>
                        <div class="stat-icon">
                            <i class="fas fa-ticket-alt fa-2x opacity-75"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6 col-12">
            <div class="card text-white bg-success h-100 shadow-sm">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="card-title mb-2 opacity-90">Confirmed</h6>
                            <h2 class="mb-1">@Model.UserBookings.Count(b => b.Status == "Confirmed")</h2>
                            <small class="opacity-75">Active bookings</small>
                        </div>
                        <div class="stat-icon">
                            <i class="fas fa-check-circle fa-2x opacity-75"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6 col-12">
            <div class="card text-white bg-info h-100 shadow-sm">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="card-title mb-2 opacity-90">Rescheduled</h6>
                            <h2 class="mb-1">@Model.UserBookings.Count(b => b.RescheduledDepartureTime.HasValue)</h2>
                            <small class="opacity-75">Modified flights</small>
                        </div>
                        <div class="stat-icon">
                            <i class="fas fa-clock fa-2x opacity-75"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6 col-12">
            <div class="card text-white bg-danger h-100 shadow-sm">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="card-title mb-2 opacity-90">Cancelled</h6>
                            <h2 class="mb-1">@Model.UserBookings.Count(b => b.Status == "Cancelled")</h2>
                            <small class="opacity-75">Cancelled bookings</small>
                        </div>
                        <div class="stat-icon">
                            <i class="fas fa-times-circle fa-2x opacity-75"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Quick Actions -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="card shadow-sm">
                <div class="card-header bg-dark text-white">
                    <h6 class="mb-0"><i class="fas fa-bolt me-2"></i>Quick Actions</h6>
                </div>
                <div class="card-body">
                    <div class="row g-3">
                        <div class="col-md-4 col-6">
                            <a asp-controller="User" asp-action="Flights" class="btn btn-primary w-100 h-100 py-3">
                                <i class="fas fa-plane fa-2x mb-2"></i>
                                <div>Book New Flight</div>
                                <small class="text-light opacity-75">Find available flights</small>
                            </a>
                        </div>
                        <div class="col-md-4 col-6">
                            <a asp-controller="User" asp-action="MyBookings" class="btn btn-success w-100 h-100 py-3">
                                <i class="fas fa-list fa-2x mb-2"></i>
                                <div>View All Bookings</div>
                                <small class="text-light opacity-75">Manage reservations</small>
                            </a>
                        </div>
                        <div class="col-md-4 col-6">
                            <a href="#" class="btn btn-info w-100 h-100 py-3">
                                <i class="fas fa-plane-departure fa-2x mb-2"></i>
                                <div>Travel History</div>
                                <small class="text-light opacity-75">Past journeys</small>
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    
    <!-- Recent Bookings -->
    <div class="row">
        <div class="col-12">
            <div class="card shadow-sm">
                <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center">
                    <h6 class="mb-0"><i class="fas fa-clock me-2"></i>Recent Bookings</h6>
                    <a asp-controller="User" asp-action="MyBookings" class="btn btn-sm btn-light">
                        <i class="fas fa-external-link-alt me-1"></i>View All
                    </a>
                </div>
                <div class="card-body p-0">
                    @if (Model.UserBookings.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-hover mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th>Booking</th>
                                        <th>Flight Details</th>
                                        <th>Travel Date</th>
                                        <th>Passengers</th>
                                        <th>Amount</th>
                                        <th>Status</th>
                                        <th>Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var booking in Model.UserBookings.Take(5))
                                    {
                                        var isRescheduled = booking.RescheduledDepartureTime.HasValue && booking.RescheduledArrivalTime.HasValue;
                                        <tr>
                                            <td>
                                                <div class="d-flex flex-column">
                                                    <small class="text-muted mb-1">Booking ID</small>
                                                    <strong class="text-primary">@booking.BookingId.ToString().Substring(0, 8)...</strong>
                                                    <small class="text-muted">@booking.BookingDate.ToString("MMM dd, yyyy")</small>
                                                    @if (isRescheduled)
                                                    {
                                                        <small class="text-warning">
                                                            <i class="fas fa-clock me-1"></i>Rescheduled
                                                        </small>
                                                    }
                                                </div>
                                            </td>
                                            <td>
                                                <div class="d-flex flex-column">
                                                    <div class="d-flex align-items-center mb-1">
                                                        <i class="fas fa-plane text-primary me-2"></i>
                                                        <strong class="text-dark">@booking.Flight.FlightNumber</strong>
                                                    </div>
                                                    <div class="route-badge mb-1">
                                                        <span class="badge bg-light text-dark border">
                                                            <i class="fas fa-route me-1"></i>
                                                            @booking.Flight.DepartureCity → @booking.Flight.ArrivalCity
                                                        </span>
                                                    </div>
                                                    <small class="text-muted">
                                                        <i class="fas fa-building me-1"></i>@booking.Flight.Airline
                                                    </small>
                                                </div>
                                            </td>
                                            <td>
                                                <div class="d-flex flex-column">
                                                    @if (isRescheduled)
                                                    {
                                                        <div class="mb-1">
                                                            <small class="text-warning fw-bold">Rescheduled</small>
                                                            <strong class="text-dark">@booking.RescheduledDepartureTime?.ToString("MMM dd, HH:mm")</strong>
                                                            <small class="text-muted d-block">
                                                                <i class="fas fa-arrow-right me-1"></i>
                                                                @booking.RescheduledArrivalTime?.ToString("MMM dd, HH:mm")
                                                            </small>
                                                        </div>
                                                        <div class="border-top pt-1">
                                                            <small class="text-muted">Original</small>
                                                            <small class="text-muted d-block">@booking.Flight.DepartureTime.ToString("MMM dd, HH:mm")</small>
                                                        </div>
                                                    }
                                                    else
                                                    {
                                                        <strong class="text-dark">@booking.Flight.DepartureTime.ToString("MMM dd, yyyy")</strong>
                                                        <small class="text-muted">@booking.Flight.DepartureTime.ToString("HH:mm")</small>
                                                        <small class="text-muted d-block">
                                                            <i class="fas fa-arrow-right me-1"></i>
                                                            @booking.Flight.ArrivalTime.ToString("MMM dd, HH:mm")
                                                        </small>
                                                    }
                                                </div>
                                            </td>
                                            <td>
                                                <div class="text-center">
                                                    <span class="passenger-count">@booking.NumberOfPassengers</span>
                                                    <small class="d-block text-muted">passenger@(booking.NumberOfPassengers != 1 ? "s" : "")</small>
                                                </div>
                                            </td>
                                            <td>
                                                <div class="text-end">
                                                    <strong class="text-success">$@booking.TotalAmount.ToString("N2")</strong>
                                                    @if (booking.NumberOfPassengers > 1)
                                                    {
                                                        <small class="d-block text-muted">
                                                            $@((booking.TotalAmount / booking.NumberOfPassengers).ToString("N2")) each
                                                        </small>
                                                    }
                                                </div>
                                            </td>
                                            <td>
                                                <span class="badge @GetStatusBadgeClass(booking.Status) px-2 py-1">
                                                    @if (isRescheduled && booking.Status == "Confirmed")
                                                    {
                                                        <i class="fas fa-clock me-1"></i>
                                                    }
                                                    @booking.Status
                                                </span>
                                            </td>
                                            <td>
                                                <div class="action-buttons">
                                                    @if (booking.Status == "Confirmed")
                                                    {
                                                        <div class="btn-group-vertical btn-group-sm">
                                                            <a asp-controller="User" asp-action="EditBooking" asp-route-id="@booking.BookingId" 
                                                               class="btn btn-outline-warning mb-1" title="Reschedule Booking">
                                                                <i class="fas fa-clock"></i> Reschedule
                                                            </a>
                                                            <form method="post" asp-controller="User" asp-action="CancelBooking" class="d-inline">
                                                                <input type="hidden" name="id" value="@booking.BookingId" />
                                                                <button type="submit" class="btn btn-outline-danger" 
                                                                        onclick="return confirmCancelBooking('@booking.Flight.FlightNumber', '@(isRescheduled ? booking.RescheduledDepartureTime?.ToString("MMM dd, yyyy HH:mm") : booking.Flight.DepartureTime.ToString("MMM dd, yyyy HH:mm"))')"
                                                                        title="Cancel Booking">
                                                                    <i class="fas fa-times"></i> Cancel
                                                                </button>
                                                            </form>
                                                        </div>
                                                    }
                                                    else
                                                    {
                                                        <span class="text-muted small">No actions</span>
                                                    }
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-5">
                            <i class="fas fa-ticket-alt fa-3x text-muted mb-3"></i>
                            <h5 class="text-muted mb-2">No Bookings Yet</h5>
                            <p class="text-muted mb-4">You haven't made any flight bookings yet.</p>
                            <a asp-controller="User" asp-action="Flights" class="btn btn-primary btn-lg">
                                <i class="fas fa-plane me-2"></i>Book Your First Flight
                            </a>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Upcoming Trips -->
    @{
        var upcomingTrips = Model.UserBookings
            .Where(b => b.Status == "Confirmed" && 
                   (b.RescheduledDepartureTime ?? b.Flight.DepartureTime) > DateTime.Now)
            .OrderBy(b => b.RescheduledDepartureTime ?? b.Flight.DepartureTime)
            .Take(3)
            .ToList();
    }
    
    @if (upcomingTrips.Any())
    {
        <div class="row mt-4">
            <div class="col-12">
                <div class="card shadow-sm">
                    <div class="card-header bg-dark text-white">
                        <h6 class="mb-0"><i class="fas fa-plane-departure me-2"></i>Upcoming Trips</h6>
                    </div>
                    <div class="card-body">
                        <div class="row g-3">
                            @foreach (var trip in upcomingTrips)
                            {
                                var isRescheduled = trip.RescheduledDepartureTime.HasValue;
                                var departureTime = isRescheduled ? trip.RescheduledDepartureTime.Value : trip.Flight.DepartureTime;
                                var arrivalTime = isRescheduled ? trip.RescheduledArrivalTime.Value : trip.Flight.ArrivalTime;
                                
                                <div class="col-md-4">
                                    <div class="card border-success h-100">
                                        <div class="card-header bg-success text-white">
                                            <h6 class="mb-0">
                                                @trip.Flight.DepartureCity → @trip.Flight.ArrivalCity
                                                @if (isRescheduled)
                                                {
                                                    <span class="badge bg-warning float-end">
                                                        <i class="fas fa-clock me-1"></i>Rescheduled
                                                    </span>
                                                }
                                            </h6>
                                        </div>
                                        <div class="card-body">
                                            <div class="mb-2">
                                                <small class="text-muted">Flight Number</small>
                                                <p class="fw-bold mb-1">@trip.Flight.FlightNumber</p>
                                            </div>
                                            <div class="mb-2">
                                                <small class="text-muted">Airline</small>
                                                <p class="mb-1">@trip.Flight.Airline</p>
                                            </div>
                                            <div class="mb-2">
                                                <small class="text-muted">Departure</small>
                                                <p class="fw-bold mb-1">@departureTime.ToString("MMM dd, yyyy HH:mm")</p>
                                            </div>
                                            <div class="mb-2">
                                                <small class="text-muted">Arrival</small>
                                                <p class="fw-bold mb-1">@arrivalTime.ToString("MMM dd, yyyy HH:mm")</p>
                                            </div>
                                            <div class="d-flex justify-content-between align-items-center">
                                                <span class="badge bg-primary">@trip.NumberOfPassengers passenger(s)</span>
                                                <strong class="text-success">$@trip.TotalAmount.ToString("N2")</strong>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@functions {
    public string GetStatusBadgeClass(string status)
    {
        return status switch
        {
            "Confirmed" => "bg-success",
            "Cancelled" => "bg-danger",
            "Pending" => "bg-warning",
            _ => "bg-secondary"
        };
    }
}

@section Scripts {
    <script>
        function confirmCancelBooking(flightNumber, departureTime) {
            return confirm(`Are you sure you want to cancel your booking for flight ${flightNumber} on ${departureTime}?\n\nThis action cannot be undone.`);
        }
    </script>
}

<style>
    .card {
        border: 1px solid #e3e6f0;
        border-radius: 12px;
        background: #ffffff;
    }

    .card-header.bg-dark {
        background: linear-gradient(135deg, #2c3e50, #34495e) !important;
        border-radius: 12px 12px 0 0 !important;
    }

    .bg-primary {
        background: linear-gradient(135deg, #3498db, #2980b9) !important;
    }

    .bg-success {
        background: linear-gradient(135deg, #27ae60, #219a52) !important;
    }

    .bg-info {
        background: linear-gradient(135deg, #17a2b8, #138496) !important;
    }

    .bg-danger {
        background: linear-gradient(135deg, #e74c3c, #c0392b) !important;
    }

    .bg-warning {
        background: linear-gradient(135deg, #f39c12, #e67e22) !important;
    }

    .stat-icon {
        opacity: 0.8;
    }

    .table th {
        border-top: none;
        font-weight: 700;
        font-size: 0.8rem;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        background-color: #f8f9fa;
        color: #495057;
        padding: 1rem 0.75rem;
        border-bottom: 2px solid #dee2e6;
    }

    .table td {
        vertical-align: middle;
        padding: 1.25rem 0.75rem;
        border-bottom: 1px solid #e9ecef;
        background: #ffffff;
    }

    .passenger-count {
        font-size: 1.25rem;
        font-weight: bold;
        color: #2c3e50;
    }

    .route-badge .badge {
        font-size: 0.75rem;
        padding: 0.4rem 0.75rem;
        background-color: #f8f9fa !important;
        border: 1px solid #dee2e6;
        color: #495057 !important;
        font-weight: 500;
    }

    .action-buttons .btn-group-vertical {
        min-width: 100px;
    }

    .btn-primary, .btn-success, .btn-info {
        border: none;
        transition: all 0.3s ease;
    }

    .btn-primary:hover, .btn-success:hover, .btn-info:hover {
        transform: translateY(-2px);
    }

    /* Responsive design */
    @@media (max-width: 768px) {
        .table-responsive {
            font-size: 0.85rem;
        }
        
        .table th,
        .table td {
            padding: 0.75rem 0.5rem;
        }
        
        .action-buttons .btn-group-vertical {
            min-width: 80px;
        }
        
        .btn-group-vertical .btn {
            font-size: 0.75rem;
            padding: 0.4rem 0.6rem;
        }
        
        .stat-icon {
            display: none;
        }
    }
</style>