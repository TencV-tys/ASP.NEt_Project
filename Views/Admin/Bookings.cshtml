@model List<AirlineReservationSystem.Models.Booking>
@{
    ViewData["Title"] = "Manage Bookings";
    
    // Auto-update booking statuses based on flight times
    var updatedBookings = Model.Select(booking =>
    {
        // Check if flight has departed and should be marked as completed
        if (booking.Status == "Confirmed" && 
            booking.Flight?.ArrivalTime < DateTime.Now)
        {
            booking.Status = "Completed";
        }
        return booking;
    }).ToList();

    // Get counts for each status
    var totalCount = Model.Count;
    var confirmedCount = Model.Count(b => b.Status == "Confirmed");
    var completedCount = Model.Count(b => b.Status == "Completed");
    var cancelledCount = Model.Count(b => b.Status == "Cancelled");
}

<div class="container">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Manage Bookings</h2>
        <div>
            <span class="text-muted me-3">
                <i class="fas fa-ticket-alt me-1"></i><span id="bookingCount">@Model.Count</span> bookings
            </span>
        </div>
    </div>

    <!-- Filter Buttons -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="card">
                <div class="card-body">
                    <h6 class="card-title mb-3">Filter by Status</h6>
                    <div class="btn-group w-100" role="group" aria-label="Booking status filter">
                        <button type="button" class="btn btn-outline-primary active" data-status="all">
                            <i class="fas fa-list me-1"></i>All Bookings
                            <span class="badge bg-primary ms-1">@totalCount</span>
                        </button>
                        <button type="button" class="btn btn-outline-success" data-status="Confirmed">
                            <i class="fas fa-check-circle me-1"></i>Confirmed
                            <span class="badge bg-success ms-1">@confirmedCount</span>
                        </button>
                        <button type="button" class="btn btn-outline-info" data-status="Completed">
                            <i class="fas fa-flag-checkered me-1"></i>Completed
                            <span class="badge bg-info ms-1">@completedCount</span>
                        </button>
                        <button type="button" class="btn btn-outline-warning" data-status="Cancelled">
                            <i class="fas fa-times-circle me-1"></i>Cancelled
                            <span class="badge bg-warning ms-1">@cancelledCount</span>
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
    
    <div class="card">
        <div class="card-body p-0">
            @if (Model.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover mb-0 admin-bookings-table">
                        <thead class="table-light">
                            <tr>
                                <th>Booking</th>
                                <th>User</th>
                                <th>Flight Details</th>
                                <th>Travel Date</th>
                                <th>Passengers</th>
                                <th>Amount</th>
                                <th>Status</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody id="bookingsTableBody">
                            @foreach (var booking in Model)
                            {
                                var isRescheduled = booking.RescheduledDepartureTime.HasValue && booking.RescheduledArrivalTime.HasValue;
                                var flightTime = isRescheduled ? booking.RescheduledArrivalTime : booking.Flight?.ArrivalTime;
                                var isFlightCompleted = flightTime.HasValue && flightTime.Value < DateTime.Now;
                                
                                <tr class="booking-row" data-status="@booking.Status.ToLower()">
                                    <td>
                                        <div class="d-flex flex-column">
                                            <small class="text-muted mb-1">Booking ID</small>
                                            <strong class="text-primary">@booking.BookingId.ToString().Substring(0, 8)...</strong>
                                            <small class="text-muted">Booked: @booking.BookingDate.ToString("MMM dd, yyyy")</small>
                                            @if (isRescheduled)
                                            {
                                                <span class="badge bg-warning text-white mt-1">
                                                    <i class="fas fa-clock me-1"></i>Rescheduled
                                                </span>
                                            }
                                        </div>
                                    </td>
                                    <td>
                                        <div class="d-flex flex-column">
                                            <strong class="text-dark">@booking.User?.Email</strong>
                                            <small class="text-muted">@booking.User?.FirstName @booking.User?.LastName</small>
                                        </div>
                                    </td>
                                    <td>
                                        <div class="d-flex flex-column">
                                            <div class="d-flex align-items-center mb-1">
                                                <i class="fas fa-plane text-muted me-2"></i>
                                                <strong class="text-dark">@booking.Flight?.FlightNumber</strong>
                                            </div>
                                            <div class="admin-bookings-route-badge mb-2">
                                                <span class="badge bg-light text-dark border">
                                                    @booking.Flight?.DepartureCity → @booking.Flight?.ArrivalCity
                                                </span>
                                            </div>
                                            <small class="text-muted">
                                                <i class="fas fa-building me-1"></i>@booking.Flight?.Airline
                                            </small>
                                            @if (isFlightCompleted && booking.Status == "Confirmed")
                                            {
                                                <small class="text-info mt-1">
                                                    <i class="fas fa-info-circle me-1"></i>Flight completed - status auto-updated
                                                </small>
                                            }
                                        </div>
                                    </td>
                                    <td>
                                        <div class="d-flex flex-column">
                                            @if (isRescheduled)
                                            {
                                                <!-- Rescheduled Flight Times -->
                                                <div class="rescheduled-flight-times mb-2 p-2 bg-warning bg-opacity-20 rounded border border-warning">
                                                    <small class="text-dark fw-bold d-block mb-1">
                                                        <i class="fas fa-clock me-1 text-warning"></i>New Schedule
                                                    </small>
                                                    <div class="d-flex align-items-center mb-1">
                                                        <i class="fas fa-plane-departure text-warning me-2"></i>
                                                        <strong class="text-dark">@booking.RescheduledDepartureTime?.ToString("MMM dd, yyyy")</strong>
                                                    </div>
                                                    <div class="d-flex justify-content-between small">
                                                        <span class="text-dark fw-bold">@booking.RescheduledDepartureTime?.ToString("HH:mm")</span>
                                                        <i class="fas fa-arrow-right text-dark mx-2"></i>
                                                        <span class="text-dark fw-bold">@booking.RescheduledArrivalTime?.ToString("HH:mm")</span>
                                                    </div>
                                                    <small class="text-dark d-block mt-1">
                                                        @booking.RescheduledArrivalTime?.ToString("MMM dd")
                                                    </small>
                                                </div>
                                                
                                                <!-- Original Flight Times -->
                                                <div class="original-flight-times p-2 bg-light rounded border">
                                                    <small class="text-muted d-block mb-1">Original Schedule</small>
                                                    <div class="d-flex justify-content-between small text-muted">
                                                        <span>@booking.Flight?.DepartureTime.ToString("MMM dd, HH:mm")</span>
                                                        <i class="fas fa-arrow-right mx-2"></i>
                                                        <span>@booking.Flight?.ArrivalTime.ToString("MMM dd, HH:mm")</span>
                                                    </div>
                                                </div>
                                            }
                                            else
                                            {
                                                <!-- Regular Flight Times -->
                                                <div class="regular-flight-times">
                                                    <div class="d-flex align-items-center mb-1">
                                                        <i class="fas fa-plane-departure text-primary me-2"></i>
                                                        <strong class="text-dark">@booking.Flight?.DepartureTime.ToString("MMM dd, yyyy")</strong>
                                                    </div>
                                                    <div class="d-flex justify-content-between align-items-center mb-1">
                                                        <span class="fw-bold text-dark">@booking.Flight?.DepartureTime.ToString("HH:mm")</span>
                                                        <i class="fas fa-arrow-right text-muted mx-2"></i>
                                                        <span class="fw-bold text-dark">@booking.Flight?.ArrivalTime.ToString("HH:mm")</span>
                                                    </div>
                                                    <div class="d-flex justify-content-between small text-muted">
                                                        <span>@booking.Flight?.DepartureCity</span>
                                                        <span>@booking.Flight?.ArrivalCity</span>
                                                    </div>
                                                    <small class="text-muted d-block mt-1">
                                                        Duration: @GetFlightDuration(booking.Flight?.DepartureTime, booking.Flight?.ArrivalTime)
                                                    </small>
                                                </div>
                                            }
                                        </div>
                                    </td>
                                    <td>
                                        <div class="text-center">
                                            <div class="admin-bookings-passenger-info">
                                                <span class="admin-bookings-passenger-count">@booking.NumberOfPassengers</span>
                                                <small class="d-block text-muted">
                                                    passenger@(booking.NumberOfPassengers != 1 ? "s" : "")
                                                </small>
                                            </div>
                                        </div>
                                    </td>
                                    <td>
                                        <div class="text-end">
                                            <strong class="text-success">$@booking.TotalAmount.ToString("N2")</strong>
                                            @if (booking.NumberOfPassengers > 1)
                                            {
                                                <small class="d-block text-muted">
                                                    $@((booking.TotalAmount / booking.NumberOfPassengers).ToString("N2")) each
                                                </small>
                                            }
                                        </div>
                                    </td>
                                    <td>
                                        <span class="badge @GetStatusBadgeClass(booking.Status) px-2 py-1">
                                            <i class="fas @GetStatusIcon(booking.Status) me-1"></i>
                                            @booking.Status
                                            @if (isFlightCompleted && booking.Status == "Completed")
                                            {
                                                <i class="fas fa-sync-alt ms-1" title="Auto-completed"></i>
                                            }
                                        </span>
                                    </td>
                                    <td>
                                        <div class="admin-bookings-action-buttons">
                                            <button class="btn btn-sm btn-outline-primary w-100" 
                                                    data-bs-toggle="modal" 
                                                    data-bs-target="#adminBookingsDetailsModal"
                                                    onclick="loadBookingDetails('@booking.BookingId', '@booking.User?.FirstName @booking.User?.LastName', '@booking.User?.Email', '@booking.Flight?.FlightNumber', '@booking.Flight?.DepartureCity', '@booking.Flight?.ArrivalCity', '@booking.Flight?.DepartureTime.ToString("MMM dd, yyyy HH:mm")', '@booking.Flight?.ArrivalTime.ToString("MMM dd, yyyy HH:mm")', '@booking.NumberOfPassengers', '@booking.TotalAmount', '@booking.BookingDate.ToString("MMM dd, yyyy HH:mm")', '@booking.Status', '@isRescheduled', '@(isRescheduled ? booking.RescheduledDepartureTime?.ToString("MMM dd, yyyy HH:mm") : "")', '@(isRescheduled ? booking.RescheduledArrivalTime?.ToString("MMM dd, yyyy HH:mm") : "")')">
                                                <i class="fas fa-eye me-1"></i>View Details
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="text-center py-5">
                    <div class="admin-bookings-empty-state">
                        <i class="fas fa-ticket-alt fa-4x text-muted mb-4"></i>
                        <h3 class="text-muted">No Bookings Found</h3>
                        <p class="text-muted mb-4">There are no bookings in the system yet.</p>
                    </div>
                </div>
            }
        </div>
    </div>

    <!-- Booking Statistics -->
    @if (Model.Any())
    {
        <div class="row mt-4">
            <div class="col-md-3 col-6 mb-3">
                <div class="card bg-primary text-white admin-bookings-stat-card clickable-stat-card" data-status="all">
                    <div class="card-body text-center py-3">
                        <h4 class="mb-0">@totalCount</h4>
                        <small>Total Bookings</small>
                        <div class="stat-card-hover">
                            <i class="fas fa-mouse-pointer"></i> Click to view all
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-3 col-6 mb-3">
                <div class="card bg-success text-white admin-bookings-stat-card clickable-stat-card" data-status="confirmed">
                    <div class="card-body text-center py-3">
                        <h4 class="mb-0">@confirmedCount</h4>
                        <small>Confirmed</small>
                        <div class="stat-card-hover">
                            <i class="fas fa-mouse-pointer"></i> Click to filter
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-3 col-6 mb-3">
                <div class="card bg-info text-white admin-bookings-stat-card clickable-stat-card" data-status="completed">
                    <div class="card-body text-center py-3">
                        <h4 class="mb-0">@completedCount</h4>
                        <small>Completed</small>
                        <div class="stat-card-hover">
                            <i class="fas fa-mouse-pointer"></i> Click to filter
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-3 col-6 mb-3">
                <div class="card bg-warning text-white admin-bookings-stat-card clickable-stat-card" data-status="cancelled">
                    <div class="card-body text-center py-3">
                        <h4 class="mb-0">@cancelledCount</h4>
                        <small>Cancelled</small>
                        <div class="stat-card-hover">
                            <i class="fas fa-mouse-pointer"></i> Click to filter
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

<!-- Booking Details Modal -->
<div class="modal fade" id="adminBookingsDetailsModal" tabindex="-1" aria-labelledby="adminBookingsDetailsModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content admin-bookings-modal-content">
            <div class="modal-header bg-primary text-white admin-bookings-modal-header">
                <h5 class="modal-title" id="adminBookingsDetailsModalLabel">
                    <i class="fas fa-ticket-alt me-2"></i>Booking Details
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body admin-bookings-modal-body">
                <div class="row">
                    <!-- Booking Information -->
                    <div class="col-md-6">
                        <div class="card mb-4 admin-bookings-modal-card">
                            <div class="card-header admin-bookings-modal-card-header">
                                <h6 class="mb-0"><i class="fas fa-info-circle me-2"></i>Booking Information</h6>
                            </div>
                            <div class="card-body">
                                <div class="row mb-2">
                                    <div class="col-6">
                                        <small class="text-muted">Booking ID</small>
                                        <p class="fw-bold" id="adminBookingsModalBookingId">-</p>
                                    </div>
                                    <div class="col-6">
                                        <small class="text-muted">Status</small>
                                        <p><span class="badge bg-success" id="adminBookingsModalBookingStatus">-</span></p>
                                    </div>
                                </div>
                                <div class="row mb-2">
                                    <div class="col-6">
                                        <small class="text-muted">Passengers</small>
                                        <p class="fw-bold" id="adminBookingsModalPassengers">-</p>
                                    </div>
                                    <div class="col-6">
                                        <small class="text-muted">Total Amount</small>
                                        <p class="fw-bold text-success" id="adminBookingsModalTotalAmount">-</p>
                                    </div>
                                </div>
                                <div class="row">
                                    <div class="col-12">
                                        <small class="text-muted">Booking Date</small>
                                        <p class="fw-bold" id="adminBookingsModalBookingDate">-</p>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- User Information -->
                    <div class="col-md-6">
                        <div class="card mb-4 admin-bookings-modal-card">
                            <div class="card-header admin-bookings-modal-card-header">
                                <h6 class="mb-0"><i class="fas fa-user me-2"></i>User Information</h6>
                            </div>
                            <div class="card-body">
                                <div class="mb-2">
                                    <small class="text-muted">Full Name</small>
                                    <p class="fw-bold" id="adminBookingsModalUserName">-</p>
                                </div>
                                <div class="mb-2">
                                    <small class="text-muted">Email</small>
                                    <p class="fw-bold" id="adminBookingsModalUserEmail">-</p>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Flight Information -->
                    <div class="col-12">
                        <div class="card admin-bookings-modal-card">
                            <div class="card-header admin-bookings-modal-card-header">
                                <h6 class="mb-0"><i class="fas fa-plane me-2"></i>Flight Information</h6>
                            </div>
                            <div class="card-body">
                                <div id="adminBookingsModalFlightInfo">
                                    <!-- Flight info will be populated by JavaScript -->
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                    <i class="fas fa-times me-2"></i>Close
                </button>
                <button type="button" class="btn btn-primary" onclick="printBookingDetails()">
                    <i class="fas fa-print me-2"></i>Print
                </button>
            </div>
        </div>
    </div>
</div>

@functions {
    public string GetStatusBadgeClass(string status)
    {
        return status switch
        {
            "Confirmed" => "bg-success",
            "Cancelled" => "bg-danger",
            "Completed" => "bg-info",
            _ => "bg-secondary"
        };
    }

    public string GetStatusIcon(string status)
    {
        return status switch
        {
            "Confirmed" => "fa-check-circle",
            "Cancelled" => "fa-times-circle",
            "Completed" => "fa-flag-checkered",
            _ => "fa-circle"
        };
    }

    public string GetFlightDuration(DateTime? departure, DateTime? arrival)
    {
        if (!departure.HasValue || !arrival.HasValue)
            return "N/A";

        var duration = arrival.Value - departure.Value;
        return $"{(int)duration.TotalHours}h {duration.Minutes}m";
    }
}

@section Scripts {
    <script>
        // Filter functionality
        document.addEventListener('DOMContentLoaded', function() {
            // Filter button functionality
            const filterButtons = document.querySelectorAll('[data-status]');
            const bookingRows = document.querySelectorAll('.booking-row');
            const bookingCount = document.getElementById('bookingCount');
            const statCards = document.querySelectorAll('.clickable-stat-card');

            // Initialize counts
            const statusCounts = {
                'all': @totalCount,
                'confirmed': @confirmedCount,
                'completed': @completedCount,
                'cancelled': @cancelledCount
            };

            // Filter button click handler
            filterButtons.forEach(button => {
                button.addEventListener('click', function() {
                    const status = this.getAttribute('data-status');
                    
                    // Update active button
                    filterButtons.forEach(btn => {
                        btn.classList.remove('active', 'btn-primary', 'btn-success', 'btn-info', 'btn-warning');
                        btn.classList.add('btn-outline-primary', 'btn-outline-success', 'btn-outline-info', 'btn-outline-warning');
                    });
                    
                    this.classList.remove('btn-outline-primary', 'btn-outline-success', 'btn-outline-info', 'btn-outline-warning');
                    this.classList.add('active');
                    
                    // Set appropriate solid button class based on status
                    switch(status) {
                        case 'all':
                            this.classList.add('btn-primary');
                            break;
                        case 'Confirmed':
                            this.classList.add('btn-success');
                            break;
                        case 'Completed':
                            this.classList.add('btn-info');
                            break;
                        case 'Cancelled':
                            this.classList.add('btn-warning');
                            break;
                    }
                    
                    filterBookings(status);
                });
            });

            // Stat card click handler
            statCards.forEach(card => {
                card.addEventListener('click', function() {
                    const status = this.getAttribute('data-status');
                    
                    // Update filter buttons
                    filterButtons.forEach(btn => {
                        btn.classList.remove('active', 'btn-primary', 'btn-success', 'btn-info', 'btn-warning');
                        btn.classList.add('btn-outline-primary', 'btn-outline-success', 'btn-outline-info', 'btn-outline-warning');
                        
                        if (btn.getAttribute('data-status') === (status === 'all' ? 'all' : status.charAt(0).toUpperCase() + status.slice(1))) {
                            btn.classList.remove('btn-outline-primary', 'btn-outline-success', 'btn-outline-info', 'btn-outline-warning');
                            btn.classList.add('active');
                            
                            // Set appropriate solid button class
                            switch(status) {
                                case 'all':
                                    btn.classList.add('btn-primary');
                                    break;
                                case 'confirmed':
                                    btn.classList.add('btn-success');
                                    break;
                                case 'completed':
                                    btn.classList.add('btn-info');
                                    break;
                                case 'cancelled':
                                    btn.classList.add('btn-warning');
                                    break;
                            }
                        }
                    });
                    
                    filterBookings(status === 'all' ? 'all' : status.charAt(0).toUpperCase() + status.slice(1));
                });
            });

            function filterBookings(status) {
                let visibleCount = 0;
                
                bookingRows.forEach(row => {
                    if (status === 'all' || row.getAttribute('data-status') === status.toLowerCase()) {
                        row.style.display = '';
                        visibleCount++;
                    } else {
                        row.style.display = 'none';
                    }
                });
                
                // Update booking count
                bookingCount.textContent = visibleCount;
                
                // Show/hide empty state
                const emptyState = document.querySelector('.admin-bookings-empty-state');
                const tableBody = document.getElementById('bookingsTableBody');
                
                if (visibleCount === 0) {
                    if (!emptyState) {
                        const noResultsHtml = `
                            <div class="text-center py-5">
                                <div class="admin-bookings-empty-state">
                                    <i class="fas fa-search fa-4x text-muted mb-4"></i>
                                    <h3 class="text-muted">No Matching Bookings</h3>
                                    <p class="text-muted mb-4">No bookings found with the selected status filter.</p>
                                    <button class="btn btn-primary" onclick="resetFilters()">
                                        <i class="fas fa-refresh me-2"></i>Show All Bookings
                                    </button>
                                </div>
                            </div>
                        `;
                        tableBody.innerHTML = noResultsHtml;
                    }
                } else if (emptyState && tableBody.querySelector('.admin-bookings-empty-state')) {
                    // Reload the original table content if we had no results
                    location.reload();
                }
            }

            // Initialize with all bookings visible
            filterBookings('all');
        });

        // Reset filters function
        function resetFilters() {
            const allButton = document.querySelector('[data-status="all"]');
            if (allButton) {
                allButton.click();
            }
        }

        function loadBookingDetails(bookingId, userName, userEmail, flightNumber, departureCity, arrivalCity, departureTime, arrivalTime, passengers, totalAmount, bookingDate, status, isRescheduled, rescheduledDeparture, rescheduledArrival) {
            // Update modal content with booking details
            document.getElementById('adminBookingsModalBookingId').textContent = bookingId;
            document.getElementById('adminBookingsModalUserName').textContent = userName || 'Not available';
            document.getElementById('adminBookingsModalUserEmail').textContent = userEmail || 'Not available';
            document.getElementById('adminBookingsModalPassengers').textContent = passengers || '0';
            document.getElementById('adminBookingsModalTotalAmount').textContent = totalAmount ? `$${parseFloat(totalAmount).toFixed(2)}` : '$0.00';
            document.getElementById('adminBookingsModalBookingDate').textContent = bookingDate || 'Not available';
            
            // Update status badge
            const statusBadge = document.getElementById('adminBookingsModalBookingStatus');
            statusBadge.textContent = status || 'Unknown';
            statusBadge.className = 'badge ' + getStatusBadgeClass(status);

            // Update flight information
            const flightInfo = document.getElementById('adminBookingsModalFlightInfo');
            if (isRescheduled === 'True' && rescheduledDeparture && rescheduledArrival) {
                flightInfo.innerHTML = `
                    <div class="row">
                        <div class="col-md-3">
                            <small class="text-muted">Flight Number</small>
                            <p class="fw-bold">${flightNumber || 'Not available'}</p>
                        </div>
                        <div class="col-md-3">
                            <small class="text-muted">Route</small>
                            <p class="fw-bold">${departureCity || 'N/A'} → ${arrivalCity || 'N/A'}</p>
                        </div>
                    </div>
                    <div class="row mt-3">
                        <div class="col-md-6">
                            <div class="rescheduled-flight-times p-3 bg-warning bg-opacity-10 rounded border border-warning">
                                <small class="text-warning fw-bold d-block mb-2">
                                    <i class="fas fa-clock me-1"></i>Rescheduled Flight
                                </small>
                                <div class="row">
                                    <div class="col-6">
                                        <small class="text-muted">Departure</small>
                                        <p class="fw-bold">${rescheduledDeparture}</p>
                                    </div>
                                    <div class="col-6">
                                        <small class="text-muted">Arrival</small>
                                        <p class="fw-bold">${rescheduledArrival}</p>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="original-flight-times p-3 bg-light rounded border">
                                <small class="text-muted d-block mb-2">Original Schedule</small>
                                <div class="row">
                                    <div class="col-6">
                                        <small class="text-muted">Departure</small>
                                        <p class="fw-bold">${departureTime || 'Not available'}</p>
                                    </div>
                                    <div class="col-6">
                                        <small class="text-muted">Arrival</small>
                                        <p class="fw-bold">${arrivalTime || 'Not available'}</p>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                `;
            } else {
                flightInfo.innerHTML = `
                    <div class="row">
                        <div class="col-md-3">
                            <small class="text-muted">Flight Number</small>
                            <p class="fw-bold">${flightNumber || 'Not available'}</p>
                        </div>
                        <div class="col-md-3">
                            <small class="text-muted">Route</small>
                            <p class="fw-bold">${departureCity || 'N/A'} → ${arrivalCity || 'N/A'}</p>
                        </div>
                        <div class="col-md-3">
                            <small class="text-muted">Departure</small>
                            <p class="fw-bold">${departureTime || 'Not available'}</p>
                        </div>
                        <div class="col-md-3">
                            <small class="text-muted">Arrival</small>
                            <p class="fw-bold">${arrivalTime || 'Not available'}</p>
                        </div>
                    </div>
                `;
            }
        }

        function getStatusBadgeClass(status) {
            switch(status) {
                case 'Confirmed': return 'bg-success';
                case 'Cancelled': return 'bg-danger';
                case 'Completed': return 'bg-info';
                default: return 'bg-secondary';
            }
        }

        function printBookingDetails() {
            const modalContent = document.querySelector('#adminBookingsDetailsModal .admin-bookings-modal-content').cloneNode(true);
            const printWindow = window.open('', '_blank');
            
            printWindow.document.write(`
                <html>
                    <head>
                        <title>Booking Details</title>
                        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet">
                        <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
                        <style>
                            body { padding: 20px; }
                            .card { border: 1px solid #dee2e6; margin-bottom: 20px; }
                            .badge { font-size: 0.8em; }
                        </style>
                    </head>
                    <body>
                        <h2 class="mb-4"><i class="fas fa-ticket-alt me-2"></i>Booking Details</h2>
                        ${modalContent.innerHTML}
                    </body>
                </html>
            `);
            
            printWindow.document.close();
            printWindow.print();
        }

        // Auto-refresh page every 5 minutes to update statuses
        setInterval(() => {
            window.location.reload();
        }, 300000); // 5 minutes
    </script>
}

