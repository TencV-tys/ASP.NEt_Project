@model List<AirlineReservationSystem.Models.Booking>
@{
    ViewData["Title"] = "Manage Bookings";
    
    // Auto-update booking statuses based on flight times
    var updatedBookings = Model.Select(booking =>
    {
        if (booking.Status == "Confirmed" && booking.Flight?.ArrivalTime < DateTime.Now)
        {
            booking.Status = "Completed";
        }
        return booking;
    }).ToList();

    // Get counts for each status
    var totalCount = Model.Count;
    var confirmedCount = Model.Count(b => b.Status == "Confirmed");
    var completedCount = Model.Count(b => b.Status == "Completed");
    var cancelledCount = Model.Count(b => b.Status == "Cancelled");

    // Revenue calculations
    var totalRevenue = Model.Where(b => b.Status == "Confirmed" || b.Status == "Completed").Sum(b => b.TotalAmount);
    var todayRevenue = Model.Where(b => b.BookingDate.Date == DateTime.Today && (b.Status == "Confirmed" || b.Status == "Completed")).Sum(b => b.TotalAmount);
    var thisMonthRevenue = Model.Where(b => b.BookingDate.Month == DateTime.Now.Month && b.BookingDate.Year == DateTime.Now.Year && (b.Status == "Confirmed" || b.Status == "Completed")).Sum(b => b.TotalAmount);

    // Date ranges for filtering
    var minDate = Model.Any() ? Model.Min(b => b.BookingDate).ToString("yyyy-MM-dd") : DateTime.Today.ToString("yyyy-MM-dd");
    var maxDate = Model.Any() ? Model.Max(b => b.BookingDate).ToString("yyyy-MM-dd") : DateTime.Today.ToString("yyyy-MM-dd");
}

<div class="container-fluid admin-bookings-container">
    <!-- Header Section -->
    <div class="row align-items-center mb-4">
        <div class="col">
            <h2 class="mb-0">Manage Bookings</h2>
        </div>
        <div class="col-auto">
            <span class="text-muted">
                <i class="fas fa-ticket-alt me-1"></i>
                <span id="bookingCount">@Model.Count</span> bookings
            </span>
        </div>
    </div>

    <!-- Revenue Summary -->
    <div class="row g-3 mb-4">
        <div class="col-xl-4 col-md-6">
            <div class="card admin-revenue-card admin-revenue-total">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h4 class="mb-1">$@totalRevenue.ToString("N2")</h4>
                            <small class="text-muted">Total Revenue</small>
                        </div>
                        <i class="fas fa-money-bill-wave fa-2x opacity-50"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xl-4 col-md-6">
            <div class="card admin-revenue-card admin-revenue-today">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h4 class="mb-1">$@todayRevenue.ToString("N2")</h4>
                            <small class="text-muted">Today's Revenue</small>
                        </div>
                        <i class="fas fa-calendar-day fa-2x opacity-50"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xl-4 col-md-6">
            <div class="card admin-revenue-card admin-revenue-month">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h4 class="mb-1">$@thisMonthRevenue.ToString("N2")</h4>
                            <small class="text-muted">This Month</small>
                        </div>
                        <i class="fas fa-calendar-alt fa-2x opacity-50"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Filter Section -->
    <div class="card admin-filter-card mb-4">
        <div class="card-body">
            <h6 class="card-title mb-3">
                <i class="fas fa-filter me-2"></i>Filter Bookings
            </h6>
            
            <div class="row g-3">
                <!-- Status Filter -->
                <div class="col-lg-4 col-md-6">
                    <label class="form-label fw-semibold mb-2">Status Filter</label>
                    <div class="btn-group w-100 admin-status-filter" role="group">
                        <button type="button" class="btn btn-primary active admin-filter-btn" data-status="all">
                            <i class="fas fa-list me-1"></i>All
                            <span class="badge bg-light text-dark ms-1">@totalCount</span>
                        </button>
                        <button type="button" class="btn btn-outline-success admin-filter-btn" data-status="Confirmed">
                            <i class="fas fa-check-circle me-1"></i>Confirmed
                            <span class="badge bg-success ms-1">@confirmedCount</span>
                        </button>
                        <button type="button" class="btn btn-outline-info admin-filter-btn" data-status="Completed">
                            <i class="fas fa-flag-checkered me-1"></i>Completed
                            <span class="badge bg-info ms-1">@completedCount</span>
                        </button>
                        <button type="button" class="btn btn-outline-warning admin-filter-btn" data-status="Cancelled">
                            <i class="fas fa-times-circle me-1"></i>Cancelled
                            <span class="badge bg-warning ms-1">@cancelledCount</span>
                        </button>
                    </div>
                </div>

                <!-- Date Range Filter -->
                <div class="col-lg-4 col-md-6">
                    <label class="form-label fw-semibold mb-2">Date Range</label>
                    <div class="input-group admin-date-filter">
                        <span class="input-group-text">
                            <i class="fas fa-calendar"></i>
                        </span>
                        <input type="date" class="form-control" id="dateFrom" value="@minDate">
                        <span class="input-group-text">to</span>
                        <input type="date" class="form-control" id="dateTo" value="@maxDate">
                    </div>
                </div>

                <!-- Quick Date Filters -->
                <div class="col-lg-4 col-md-6">
                    <label class="form-label fw-semibold mb-2">Quick Filters</label>
                    <div class="btn-group w-100 admin-quick-filters" role="group">
                        <button type="button" class="btn btn-outline-secondary" data-days="1">Today</button>
                        <button type="button" class="btn btn-outline-secondary" data-days="7">Last 7 Days</button>
                        <button type="button" class="btn btn-outline-secondary" data-days="30">Last 30 Days</button>
                        <button type="button" class="btn btn-outline-secondary" onclick="resetDateFilter()">All Time</button>
                    </div>
                </div>
            </div>

            <!-- Active Filters Display -->
            <div id="activeFilters" class="mt-3 admin-active-filters" style="display: none;">
                <small class="text-muted">Active Filters:</small>
                <div id="filterTags" class="d-flex flex-wrap gap-2 mt-1"></div>
            </div>
        </div>
    </div>

    <!-- Bookings Table -->
    <div class="card admin-bookings-table-card">
        <div class="card-body p-0">
            @if (Model.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Booking Reference</th>
                                <th>User</th>
                                <th>Flight Details</th>
                                <th>Travel Date</th>
                                <th>Passengers</th>
                                <th>Amount</th>
                                <th>Status</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody id="bookingsTableBody">
                            @foreach (var booking in Model)
                            {
                                var isRescheduled = booking.RescheduledDepartureTime.HasValue && booking.RescheduledArrivalTime.HasValue;
                                var flightTime = isRescheduled ? booking.RescheduledArrivalTime : booking.Flight?.ArrivalTime;
                                var isFlightCompleted = flightTime.HasValue && flightTime.Value < DateTime.Now;
                                
                                <tr class="admin-booking-row" data-status="@booking.Status.ToLower()" data-date="@booking.BookingDate.ToString("yyyy-MM-dd")" data-amount="@booking.TotalAmount">
                                    <td>
                                        <div class="d-flex flex-column">
                                            <strong class="text-primary">@booking.BookingReference</strong>
                                            <small class="text-muted">@booking.BookingDate.ToString("MMM dd, yyyy HH:mm")</small>
                                            @if (isRescheduled)
                                            {
                                                <span class="badge bg-warning text-dark mt-1">
                                                    <i class="fas fa-clock me-1"></i>Rescheduled
                                                </span>
                                            }
                                        </div>
                                    </td>
                                    <td>
                                        <div class="d-flex flex-column">
                                            <strong>@booking.User?.Email</strong>
                                            <small class="text-muted">@booking.User?.FirstName @booking.User?.LastName</small>
                                        </div>
                                    </td>
                                    <td>
                                        <div class="d-flex flex-column">
                                            <div class="d-flex align-items-center mb-1">
                                                <i class="fas fa-plane text-muted me-2"></i>
                                                <strong>@booking.Flight?.FlightNumber</strong>
                                            </div>
                                            <span class="badge bg-light text-dark border">
                                                @GetAirportCode(booking.Flight?.DepartureCity) → @GetAirportCode(booking.Flight?.ArrivalCity)
                                            </span>
                                            <small class="text-muted mt-1">
                                                <i class="fas fa-building me-1"></i>@booking.Flight?.Airline
                                            </small>
                                        </div>
                                    </td>
                                    <td>
                                        <div class="d-flex flex-column">
                                            @if (isRescheduled)
                                            {
                                                <div class="bg-warning bg-opacity-10 p-2 rounded border border-warning mb-2">
                                                    <small class="text-warning fw-bold d-block mb-1">
                                                        <i class="fas fa-clock me-1"></i>New Schedule
                                                    </small>
                                                    <div class="d-flex justify-content-between small">
                                                        <span class="fw-bold">@booking.RescheduledDepartureTime?.ToString("MMM dd, HH:mm")</span>
                                                        <i class="fas fa-arrow-right text-warning mx-1"></i>
                                                        <span class="fw-bold">@booking.RescheduledArrivalTime?.ToString("MMM dd, HH:mm")</span>
                                                    </div>
                                                </div>
                                            }
                                            else
                                            {
                                                <div class="d-flex justify-content-between align-items-center">
                                                    <span class="fw-bold">@booking.Flight?.DepartureTime.ToString("MMM dd, HH:mm")</span>
                                                    <i class="fas fa-arrow-right text-muted mx-1"></i>
                                                    <span class="fw-bold">@booking.Flight?.ArrivalTime.ToString("MMM dd, HH:mm")</span>
                                                </div>
                                            }
                                        </div>
                                    </td>
                                    <td>
                                        <div class="text-center">
                                            <div class="fw-bold fs-5">@booking.NumberOfPassengers</div>
                                            <small class="text-muted">passengers</small>
                                            @if (booking.CheckedBags > 0 || booking.CarryOnBags > 0)
                                            {
                                                <div class="mt-1">
                                                    <small class="text-muted">
                                                        <i class="fas fa-suitcase me-1"></i>
                                                        @booking.CarryOnBags C / @booking.CheckedBags Ch
                                                    </small>
                                                </div>
                                            }
                                        </div>
                                    </td>
                                    <td>
                                        <div class="text-end">
                                            <strong class="text-success">$@booking.TotalAmount.ToString("N2")</strong>
                                            <small class="d-block text-muted">
                                                $@((booking.TotalAmount / booking.NumberOfPassengers).ToString("N2")) each
                                            </small>
                                        </div>
                                    </td>
                                    <td>
                                        <span class="badge @GetStatusBadgeClass(booking.Status) px-2 py-1">
                                            <i class="fas @GetStatusIcon(booking.Status) me-1"></i>
                                            @booking.Status
                                        </span>
                                    </td>
                                    <td>
                                        <div class="d-flex flex-column gap-1">
                                            <button class="btn btn-sm btn-outline-primary admin-action-btn" 
                                                    onclick="viewBookingReceipt('@booking.BookingId')">
                                                <i class="fas fa-receipt me-1"></i>Receipt
                                            </button>
                                            <button class="btn btn-sm btn-outline-info admin-action-btn" 
                                                    data-bs-toggle="modal" 
                                                    data-bs-target="#adminBookingsDetailsModal"
                                                    onclick="loadBookingDetails('@booking.BookingId')">
                                                <i class="fas fa-eye me-1"></i>Details
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="text-center py-5">
                    <i class="fas fa-ticket-alt fa-4x text-muted mb-3"></i>
                    <h4 class="text-muted">No Bookings Found</h4>
                    <p class="text-muted">There are no bookings in the system yet.</p>
                </div>
            }
        </div>
    </div>

    <!-- Statistics Cards -->
    @if (Model.Any())
    {
        <div class="row g-3 mt-4">
            <div class="col-xl-3 col-md-6">
                <div class="card bg-primary text-white admin-stat-card" data-status="all">
                    <div class="card-body text-center">
                        <h3 class="mb-1" id="statTotalBookings">@totalCount</h3>
                        <small>Total Bookings</small>
                    </div>
                </div>
            </div>
            <div class="col-xl-3 col-md-6">
                <div class="card bg-success text-white admin-stat-card" data-status="confirmed">
                    <div class="card-body text-center">
                        <h3 class="mb-1" id="statConfirmedBookings">@confirmedCount</h3>
                        <small>Confirmed</small>
                    </div>
                </div>
            </div>
            <div class="col-xl-3 col-md-6">
                <div class="card bg-info text-white admin-stat-card" data-status="completed">
                    <div class="card-body text-center">
                        <h3 class="mb-1" id="statCompletedBookings">@completedCount</h3>
                        <small>Completed</small>
                    </div>
                </div>
            </div>
            <div class="col-xl-3 col-md-6">
                <div class="card bg-warning text-white admin-stat-card" data-status="cancelled">
                    <div class="card-body text-center">
                        <h3 class="mb-1" id="statCancelledBookings">@cancelledCount</h3>
                        <small>Cancelled</small>
                    </div>
                </div>
            </div>
        </div>

        <!-- Revenue Summary -->
        <div class="row g-3 mt-3">
            <div class="col-md-4">
                <div class="card bg-success text-white">
                    <div class="card-body text-center">
                        <h4 class="mb-1" id="filteredRevenue">$@totalRevenue.ToString("N2")</h4>
                        <small>Filtered Revenue</small>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card bg-dark text-white">
                    <div class="card-body text-center">
                        <h4 class="mb-1" id="filteredBookingsCount">@totalCount</h4>
                        <small>Filtered Bookings</small>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card bg-purple text-white">
                    <div class="card-body text-center">
                        <h4 class="mb-1" id="averageBookingValue">$@((totalCount > 0 ? totalRevenue / totalCount : 0).ToString("N2"))</h4>
                        <small>Avg. Booking Value</small>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

<!-- Booking Details Modal -->
<div class="modal fade" id="adminBookingsDetailsModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title">
                    <i class="fas fa-ticket-alt me-2"></i>Booking Details
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div id="adminBookingsModalContent">
                    <!-- Content loaded by JavaScript -->
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                    <i class="fas fa-times me-2"></i>Close
                </button>
                <button type="button" class="btn btn-primary" onclick="printBookingDetails()">
                    <i class="fas fa-print me-2"></i>Print Receipt
                </button>
            </div>
        </div>
    </div>
</div>

@functions {
    public string GetStatusBadgeClass(string status)
    {
        return status switch
        {
            "Confirmed" => "bg-success",
            "Cancelled" => "bg-danger",
            "Completed" => "bg-info",
            _ => "bg-secondary"
        };
    }

    public string GetStatusIcon(string status)
    {
        return status switch
        {
            "Confirmed" => "fa-check-circle",
            "Cancelled" => "fa-times-circle",
            "Completed" => "fa-flag-checkered",
            _ => "fa-circle"
        };
    }

    public string GetAirportCode(string city)
    {
        if (string.IsNullOrEmpty(city)) return "N/A";
        if (city.Contains('(') && city.Contains(')'))
        {
            try
            {
                return city.Split('(')[1].Split(')')[0];
            }
            catch
            {
                return city.Length > 3 ? city.Substring(0, 3).ToUpper() : city.ToUpper();
            }
        }
        return city.Length > 3 ? city.Substring(0, 3).ToUpper() : city.ToUpper();
    }
}

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            initializeFilters();
            setupDateFilters();
            applyFilters();
        });

        function initializeFilters() {
            // Status filter
            document.querySelectorAll('.admin-filter-btn').forEach(btn => {
                btn.addEventListener('click', function() {
                    document.querySelectorAll('.admin-filter-btn').forEach(b => {
                        b.classList.remove('active', 'btn-primary');
                        b.classList.add('btn-outline-primary', 'btn-outline-success', 'btn-outline-info', 'btn-outline-warning');
                    });
                    this.classList.remove('btn-outline-primary', 'btn-outline-success', 'btn-outline-info', 'btn-outline-warning');
                    this.classList.add('active', 'btn-primary');
                    applyFilters();
                });
            });

            // Date range filter
            document.getElementById('dateFrom').addEventListener('change', applyFilters);
            document.getElementById('dateTo').addEventListener('change', applyFilters);

            // Quick date filters
            document.querySelectorAll('[data-days]').forEach(btn => {
                btn.addEventListener('click', function() {
                    const days = parseInt(this.getAttribute('data-days'));
                    const dateTo = new Date();
                    const dateFrom = new Date();
                    dateFrom.setDate(dateFrom.getDate() - days);
                    document.getElementById('dateFrom').value = dateFrom.toISOString().split('T')[0];
                    document.getElementById('dateTo').value = dateTo.toISOString().split('T')[0];
                    applyFilters();
                });
            });

            // Stat card clicks
            document.querySelectorAll('.admin-stat-card').forEach(card => {
                card.addEventListener('click', function() {
                    const status = this.getAttribute('data-status');
                    const button = document.querySelector(`[data-status="${status}"]`);
                    if (button) button.click();
                });
            });
        }

        function setupDateFilters() {
            const today = new Date().toISOString().split('T')[0];
            document.getElementById('dateFrom').max = today;
            document.getElementById('dateTo').max = today;
        }

        function resetDateFilter() {
            document.getElementById('dateFrom').value = '@minDate';
            document.getElementById('dateTo').value = '@maxDate';
            applyFilters();
        }

        function applyFilters() {
            const status = document.querySelector('.admin-filter-btn.active')?.getAttribute('data-status') || 'all';
            const dateFrom = document.getElementById('dateFrom').value;
            const dateTo = document.getElementById('dateTo').value;
            const rows = document.querySelectorAll('.admin-booking-row');

            let visibleCount = 0;
            let totalRevenue = 0;

            rows.forEach(row => {
                const rowStatus = row.getAttribute('data-status');
                const rowDate = row.getAttribute('data-date');
                const rowAmount = parseFloat(row.getAttribute('data-amount'));

                const statusMatch = status === 'all' || rowStatus === status.toLowerCase();
                const dateMatch = (!dateFrom || rowDate >= dateFrom) && (!dateTo || rowDate <= dateTo);

                if (statusMatch && dateMatch) {
                    row.style.display = '';
                    visibleCount++;
                    totalRevenue += rowAmount;
                } else {
                    row.style.display = 'none';
                }
            });

            // Update counters
            document.getElementById('bookingCount').textContent = visibleCount;
            document.getElementById('filteredBookingsCount').textContent = visibleCount;
            document.getElementById('filteredRevenue').textContent = '$' + totalRevenue.toFixed(2);
            document.getElementById('averageBookingValue').textContent = '$' + (visibleCount > 0 ? (totalRevenue / visibleCount).toFixed(2) : '0.00');

            // Update active filters display
            updateActiveFiltersDisplay(status, dateFrom, dateTo);
        }

        function updateActiveFiltersDisplay(status, dateFrom, dateTo) {
            const activeFilters = document.getElementById('activeFilters');
            const filterTags = document.getElementById('filterTags');
            filterTags.innerHTML = '';

            const filters = [];
            if (status !== 'all') filters.push(`Status: ${status}`);
            if (dateFrom && dateTo) filters.push(`Date: ${new Date(dateFrom).toLocaleDateString()} to ${new Date(dateTo).toLocaleDateString()}`);

            if (filters.length > 0) {
                filters.forEach(filter => {
                    const badge = document.createElement('span');
                    badge.className = 'badge bg-primary';
                    badge.textContent = filter;
                    filterTags.appendChild(badge);
                });
                activeFilters.style.display = 'block';
            } else {
                activeFilters.style.display = 'none';
            }
        }

        function viewBookingReceipt(bookingId) {
            window.open('@Url.Action("BookingReceipt", "Admin")/' + bookingId, '_blank');
        }

        function loadBookingDetails(bookingId) {
            // Simplified for demo - in real app, fetch from server
            const content = `
                <div class="text-center p-4">
                    <h4>Booking Details</h4>
                    <p>Loading details for booking: ${bookingId}</p>
                    <p class="text-muted">In a real application, this would fetch data from the server.</p>
                </div>
            `;
            document.getElementById('adminBookingsModalContent').innerHTML = content;
        }

        function printBookingDetails() {
            window.print();
        }
    </script>
}

<style>
    /* Base Styles */
    .admin-bookings-container {
        max-width: 100%;
        padding: 1rem;
    }

    /* Revenue Cards */
    .admin-revenue-card {
        border: none;
        border-radius: 12px;
        box-shadow: 0 4px 6px rgba(0,0,0,0.1);
        transition: transform 0.3s ease;
        min-height: 100px;
        display: flex;
        align-items: center;
    }

    .admin-revenue-card:hover {
        transform: translateY(-2px);
        box-shadow: 0 6px 12px rgba(0,0,0,0.15);
    }

    .admin-revenue-total {
        background: linear-gradient(135deg, #27ae60, #219a52) !important;
    }

    .admin-revenue-today {
        background: linear-gradient(135deg, #17a2b8, #138496) !important;
    }

    .admin-revenue-month {
        background: linear-gradient(135deg, #f39c12, #e67e22) !important;
    }

    /* Filter Section */
    .admin-filter-card {
        border: none;
        border-radius: 12px;
        box-shadow: 0 4px 6px rgba(0,0,0,0.1);
    }

    .admin-status-filter {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
    }

    .admin-filter-btn {
        flex: 1;
        min-width: 120px;
        padding: 0.5rem 0.75rem;
        font-size: 0.875rem;
        border-radius: 8px !important;
    }

    .admin-date-filter .input-group-text {
        background-color: #f8f9fa;
        border-color: #dee2e6;
    }

    .admin-quick-filters {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
    }

    .admin-quick-filters .btn {
        flex: 1;
        min-width: 80px;
        padding: 0.5rem 0.25rem;
        font-size: 0.875rem;
    }

    /* Table Styles */
    .admin-bookings-table-card {
        border: none;
        border-radius: 12px;
        box-shadow: 0 4px 6px rgba(0,0,0,0.1);
        overflow: hidden;
    }

    .admin-bookings-table-card .table {
        margin: 0;
    }

    .admin-bookings-table-card .table th {
        border-top: none;
        font-weight: 600;
        font-size: 0.875rem;
        text-transform: uppercase;
        letter-spacing: 0.5px;
