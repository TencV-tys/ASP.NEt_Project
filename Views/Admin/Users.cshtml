@model List<AirlineReservationSystem.ViewModels.UserWithRolesViewModel>
@{
    ViewData["Title"] = "Manage Users";
}

<div class="container">
    <h2>Manage Users</h2>
    
    <div class="card">
        <div class="card-body">
            <table class="table table-striped">
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Email</th>
                        <th>Roles</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var userWithRoles in Model)
                    {
                        <tr>
                            <td>@userWithRoles.User.FirstName @userWithRoles.User.LastName</td>
                            <td>@userWithRoles.User.Email</td>
                            <td>
                                @foreach (var role in userWithRoles.Roles)
                                {
                                    <span class="badge bg-primary">@role</span>
                                }
                            </td>
                            <td>
                                <form method="post" asp-action="AssignRole" class="d-inline">
                                    <input type="hidden" name="userId" value="@userWithRoles.User.Id" />
                                    <select name="role" class="form-select form-select-sm d-inline w-auto">
                                        <option value="User">User</option>
                                        <option value="Admin">Admin</option>
                                    </select>
                                    <button type="submit" class="btn btn-sm btn-primary">Assign Role</button>
                                </form>
                                
                                <form method="post" asp-action="DeleteUser" class="d-inline" 
                                      onsubmit="return confirm('Are you sure you want to delete this user?')">
                                    <input type="hidden" name="userId" value="@userWithRoles.User.Id" />
                                    <button type="submit" class="btn btn-sm btn-danger">Delete</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>