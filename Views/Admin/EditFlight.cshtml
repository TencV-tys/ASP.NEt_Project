@model AirlineReservationSystem.Models.Flight
@{
    ViewData["Title"] = "Edit Flight";
}

<div class="container">
    <h2>Edit Flight</h2>
    
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card">
                <div class="card-body">
                    <form asp-action="EditFlight" method="post">
                        <input type="hidden" asp-for="FlightId" />
                        
                        <!-- Show Flight Number as read-only -->
                        <div class="form-group mb-3">
                            <label class="form-label">Flight Number</label>
                            <input type="text" class="form-control" value="@Model.FlightNumber" readonly />
                            <small class="form-text text-muted">Flight number is automatically generated and cannot be changed.</small>
                        </div>
                        
                        <div class="row">
                            <div class="col-md-12">
                                <div class="form-group mb-3">
                                    <label asp-for="Airline" class="form-label"></label>
                                    <input asp-for="Airline" class="form-control" />
                                    <span asp-validation-for="Airline" class="text-danger"></span>
                                </div>
                            </div>
                        </div>
                        
                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-group mb-3">
                                    <label asp-for="DepartureCity" class="form-label"></label>
                                    <input asp-for="DepartureCity" class="form-control" />
                                    <span asp-validation-for="DepartureCity" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group mb-3">
                                    <label asp-for="ArrivalCity" class="form-label"></label>
                                    <input asp-for="ArrivalCity" class="form-control" />
                                    <span asp-validation-for="ArrivalCity" class="text-danger"></span>
                                </div>
                            </div>
                        </div>
                        
                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-group mb-3">
                                    <label asp-for="DepartureTime" class="form-label"></label>
                                    <input asp-for="DepartureTime" type="datetime-local" class="form-control" />
                                    <span asp-validation-for="DepartureTime" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group mb-3">
                                    <label asp-for="ArrivalTime" class="form-label"></label>
                                    <input asp-for="ArrivalTime" type="datetime-local" class="form-control" />
                                    <span asp-validation-for="ArrivalTime" class="text-danger"></span>
                                </div>
                            </div>
                        </div>
                        
                        <div class="row">
                            <div class="col-md-4">
                                <div class="form-group mb-3">
                                    <label asp-for="TotalSeats" class="form-label"></label>
                                    <input asp-for="TotalSeats" class="form-control" />
                                    <span asp-validation-for="TotalSeats" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="form-group mb-3">
                                    <label asp-for="AvailableSeats" class="form-label"></label>
                                    <input asp-for="AvailableSeats" class="form-control" />
                                    <span asp-validation-for="AvailableSeats" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="form-group mb-3">
                                    <label asp-for="Price" class="form-label"></label>
                                    <input asp-for="Price" class="form-control" />
                                    <span asp-validation-for="Price" class="text-danger"></span>
                                </div>
                            </div>
                        </div>
                        
                        <div class="form-group mb-3">
                            <div class="form-check form-switch">
                                <input asp-for="IsActive" class="form-check-input" />
                                <label class="form-check-label" asp-for="IsActive"></label>
                            </div>
                        </div>
                        
                        <div class="form-group">
                            <button type="submit" class="btn btn-success w-100">Update Flight</button>
                        </div>
                    </form>
                </div>
            </div>
            
            <div class="text-center mt-3">
                <a asp-action="Flights" class="btn btn-outline-secondary">Back to Flights</a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}