@model List<AirlineReservationSystem.Models.Flight>
@{
    ViewData["Title"] = "Manage Flights";
}

<div class="container">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Manage Flights</h2>
        <a asp-action="CreateFlight" class="btn btn-primary">
            <i class="fas fa-plus"></i> Add New Flight
        </a>
    </div>
    
    <div class="card">
        <div class="card-body">
            @if (Model.Any())
            {
                <div class="table-responsive">
                    <table class="table table-striped">
                        <thead>
                            <tr>
                                <th>Flight Number</th>
                                <th>Airline</th>
                                <th>Route</th>
                                <th>Departure</th>
                                <th>Arrival</th>
                                <th>Seats</th>
                                <th>Price</th>
                                <th>Status</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var flight in Model)
                            {
                                <tr>
                                    <td>@flight.FlightNumber</td>
                                    <td>@flight.Airline</td>
                                    <td>@flight.DepartureCity → @flight.ArrivalCity</td>
                                    <td>@flight.DepartureTime.ToString("MMM dd, yyyy HH:mm")</td>
                                    <td>@flight.ArrivalTime.ToString("MMM dd, yyyy HH:mm")</td>
                                    <td>@flight.AvailableSeats / @flight.TotalSeats</td>
                                    <td>$@flight.Price.ToString("N2")</td>
                                    <td>
                                        <span class="badge @(flight.IsActive ? "bg-success" : "bg-danger")">
                                            @(flight.IsActive ? "Active" : "Inactive")
                                        </span>
                                    </td>
                                    <td>
                                        <a asp-action="EditFlight" asp-route-id="@flight.FlightId" class="btn btn-sm btn-primary">
                                            <i class="fas fa-edit"></i> Edit
                                        </a>
                                        <form method="post" asp-action="DeleteFlight" class="d-inline">
                                            <input type="hidden" name="id" value="@flight.FlightId" />
                                            <button type="submit" class="btn btn-sm btn-danger" 
                                                    onclick="return confirm('Are you sure you want to delete this flight?')">
                                                <i class="fas fa-trash"></i> Delete
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="text-center py-4">
                    <i class="fas fa-plane fa-3x text-muted mb-3"></i>
                    <h4>No flights found</h4>
                    <p class="text-muted">Get started by adding your first flight.</p>
                    <a asp-action="CreateFlight" class="btn btn-primary">Add Flight</a>
                </div>
            }
        </div>
    </div>
</div>