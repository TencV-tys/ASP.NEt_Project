
@model AirlineReservationSystem.ViewModels.AdminDashboardViewModel
@{
    ViewData["Title"] = "Admin Dashboard";
}

<div class="container">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="mb-0">Admin Dashboard</h2>
        <div class="text-muted fw-medium">
            <i class="fas fa-chart-line me-2"></i>Real-time Overview
        </div>
    </div>
    
    <!-- Statistics Cards -->
    <div class="row g-3 mb-4"> 
        <div class="col-xl-3 col-md-6 col-12">
            <div class="card text-white bg-primary h-100 shadow-sm">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="card-title mb-2 opacity-90">Total Users</h6>
                            <h2 class="mb-1">@Model.TotalUsers</h2>
                            <small class="opacity-75">Registered users</small>
                        </div>
                        <div class="stat-icon">
                            <i class="fas fa-users fa-2x opacity-75"></i>
                        </div>
                    </div>
                    <div class="mt-3">
                        <small class="opacity-75">
                            <i class="fas fa-trending-up me-1"></i>
                            Active users in system
                        </small>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6 col-12">
            <div class="card text-white bg-success h-100 shadow-sm">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="card-title mb-2 opacity-90">Total Flights</h6>
                            <h2 class="mb-1">@Model.TotalFlights</h2>
                            <small class="opacity-75">Active flights</small>
                        </div>
                        <div class="stat-icon">
                            <i class="fas fa-plane fa-2x opacity-75"></i>
                        </div>
                    </div>
                    <div class="mt-3">
                        <small class="opacity-75">
                            <i class="fas fa-map-marker-alt me-1"></i>
                            Operating routes
                        </small>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6 col-12">
            <div class="card text-white bg-warning h-100 shadow-sm">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="card-title mb-2 opacity-90">Total Bookings</h6>
                            <h2 class="mb-1">@Model.TotalBookings</h2>
                            <small class="opacity-75">All bookings</small>
                        </div>
                        <div class="stat-icon">
                            <i class="fas fa-ticket-alt fa-2x opacity-75"></i>
                        </div>
                    </div>
                    <div class="mt-3">
                        <small class="opacity-75">
                            <i class="fas fa-calendar me-1"></i>
                            Current reservations
                        </small>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6 col-12">
            <div class="card text-white bg-info h-100 shadow-sm">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="card-title mb-2 opacity-90">Total Revenue</h6>
                            <h2 class="mb-1">$@Model.TotalRevenue.ToString("N2")</h2>
                            <small class="opacity-75">Confirmed bookings</small>
                        </div> 
                        <div class="stat-icon">
                            <i class="fas fa-dollar-sign fa-2x opacity-75"></i>
                        </div>
                    </div>
                    <div class="mt-3">
                        <small class="opacity-75">
                            <i class="fas fa-chart-bar me-1"></i>
                            Total earnings
                        </small>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Additional Stats and Recent Bookings -->
    <div class="row">
        <!-- Quick Stats -->
        <div class="col-lg-4 col-md-6 mb-4">
            <div class="card h-100 shadow-sm">
                <div class="card-header bg-dark text-white">
                    <h6 class="mb-0"><i class="fas fa-chart-pie me-2"></i>Booking Status</h6>
                </div>
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center mb-3 pb-2 border-bottom">
                        <span class="text-dark fw-medium">Confirmed Bookings</span>
                        <span class="badge bg-success">@Model.ConfirmedBookingsCount</span>
                    </div>
                    <div class="d-flex justify-content-between align-items-center mb-3 pb-2 border-bottom">
                        <span class="text-dark fw-medium">Cancelled Bookings</span>
                        <span class="badge bg-danger">@Model.CancelledBookingsCount</span>
                    </div>
                    <div class="d-flex justify-content-between align-items-center mb-3 pb-2 border-bottom">
                        <span class="text-dark fw-medium">Completed Bookings</span>
                        <span class="badge bg-info">@Model.CompletedBookingsCount</span>
                    </div>
                    <div class="d-flex justify-content-between align-items-center">
                        <span class="text-dark fw-medium">Today's Bookings</span>
                        <span class="badge bg-primary">@Model.TodaysBookingsCount</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Recent Bookings -->
        <div class="col-lg-8 col-md-6">
            <div class="card shadow-sm">
                <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center">
                    <h6 class="mb-0"><i class="fas fa-clock me-2"></i>Recent Bookings</h6>
                    <a asp-controller="Admin" asp-action="Bookings" class="btn btn-sm btn-light">
                        <i class="fas fa-external-link-alt me-1"></i>View All
                    </a>
                </div>
                <div class="card-body p-0">
                    @if (Model.RecentBookings?.Any() == true)
                    {
                        <div class="table-responsive">
                            <table class="table table-hover mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th>Booking</th>
                                        <th>User</th>
                                        <th>Flight</th>
                                        <th>Amount</th>
                                        <th>Date</th>
                                        <th>Status</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var booking in Model.RecentBookings)
                                    {
                                        <tr>
                                            <td>
                                                <div class="d-flex flex-column">
                                                    <small class="text-muted mb-1">Booking ID</small>
                                                    <strong class="text-primary">@booking.BookingId.ToString().Substring(0, 8)...</strong>
                                                </div>
                                            </td>
                                            <td>
                                                <div class="d-flex flex-column">
                                                    <strong class="text-dark">@booking.User?.Email</strong>
                                                    <small class="text-muted">@booking.User?.FirstName @booking.User?.LastName</small>
                                                </div>
                                            </td>
                                            <td>
                                                <div class="d-flex flex-column">
                                                    <strong class="text-dark">@booking.Flight?.FlightNumber</strong>
                                                    <small class="text-muted">
                                                        <i class="fas fa-route me-1"></i>
                                                        @booking.Flight?.DepartureCity → @booking.Flight?.ArrivalCity
                                                    </small>
                                                </div>
                                            </td>
                                            <td>
                                                <div class="text-end">
                                                    <strong class="text-success">$@booking.TotalAmount.ToString("N2")</strong>
                                                    <small class="d-block text-muted">@booking.NumberOfPassengers pax</small>
                                                </div>
                                            </td>
                                            <td>
                                                <div class="d-flex flex-column">
                                                    <small class="text-muted">Booked</small>
                                                    <strong class="text-dark">@booking.BookingDate.ToString("MMM dd, yyyy")</strong>
                                                    <small class="text-muted">@booking.BookingDate.ToString("HH:mm")</small>
                                                </div>
                                            </td>
                                            <td>
                                                <span class="badge @GetStatusBadgeClass(booking.Status) px-2 py-1">
                                                    <i class="fas @GetStatusIcon(booking.Status) me-1"></i>
                                                    @booking.Status
                                                </span>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-5">
                            <i class="fas fa-ticket-alt fa-3x text-muted mb-3"></i>
                            <h5 class="text-muted mb-2">No Recent Bookings</h5>
                            <p class="text-muted">New bookings will appear here.</p>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- System Actions -->
    <div class="row mt-4">
        <div class="col-12">
            <div class="card shadow-sm">
                <div class="card-header bg-dark text-white">
                    <h6 class="mb-0"><i class="fas fa-cogs me-2"></i>Quick Actions</h6>
                </div>
                <div class="card-body">
                    <div class="row g-3">
                        <div class="col-md-4 col-6">
                            <a asp-controller="Admin" asp-action="Flights" class="btn btn-primary w-100 h-100 py-3 text-white">
                                <i class="fas fa-plane fa-2x mb-2"></i>
                                <div class="fw-bold">Manage Flights</div>
                                <small class="text-light opacity-90">Add, edit flights</small>
                            </a>
                        </div>
                        <div class="col-md-4 col-6">
                            <a asp-controller="Admin" asp-action="Bookings" class="btn btn-success w-100 h-100 py-3 text-white">
                                <i class="fas fa-ticket-alt fa-2x mb-2"></i>
                                <div class="fw-bold">Manage Bookings</div>
                                <small class="text-light opacity-90">View all bookings</small>
                            </a>
                        </div>
                        <div class="col-md-4 col-6">
                            <a asp-controller="Admin" asp-action="Users" class="btn btn-warning w-100 h-100 py-3 text-white">
                                <i class="fas fa-users fa-2x mb-2"></i>
                                <div class="fw-bold">Manage Users</div>
                                <small class="text-light opacity-90">User management</small>
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@functions {
    public string GetStatusBadgeClass(string status)
    {
        return status switch
        {
            "Confirmed" => "bg-success",
            "Cancelled" => "bg-danger",
            "Completed" => "bg-info",
            _ => "bg-secondary"
        };
    }
 
    public string GetStatusIcon(string status)
    {
        return status switch
        {
            "Confirmed" => "fa-check-circle",
            "Cancelled" => "fa-times-circle",
            "Completed" => "fa-flag-checkered",
            _ => "fa-circle"
        };
    }
}

<style>
    .card {
        border: 1px solid #e3e6f0;
        border-radius: 12px;
        background: #ffffff;
        transition: transform 0.2s ease;
    }

    .card:hover {
        transform: translateY(-2px);
    }

    .card-header {
        border-bottom: 1px solid #e3e6f0;
        font-weight: 600;
        border-radius: 12px 12px 0 0 !important;
    }

    .bg-primary {
        background: linear-gradient(135deg, #3498db, #2980b9) !important;
    }

    .bg-success {
        background: linear-gradient(135deg, #27ae60, #219a52) !important;
    }

    .bg-warning {
        background: linear-gradient(135deg, #f39c12, #e67e22) !important;
    }

    .bg-info {
        background: linear-gradient(135deg, #17a2b8, #138496) !important;
    }

    .bg-dark {
        background: linear-gradient(135deg, #2c3e50, #34495e) !important;
    }

    .stat-icon {
        opacity: 0.8;
    }

    .table th {
        border-top: none;
        font-weight: 700;
        font-size: 0.8rem;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        background-color: #f8f9fa;
        color: #495057;
        padding: 1rem 0.75rem;
        border-bottom: 2px solid #dee2e6;
    }

    .table td {
        vertical-align: middle;
        padding: 1.25rem 0.75rem;
        border-bottom: 1px solid #e9ecef;
        background: #ffffff;
    }

    .table tbody tr {
        transition: background-color 0.15s ease;
    }

    .table tbody tr:hover {
        background-color: #f8f9fa;
    }

    .badge {
        font-size: 0.75rem;
        font-weight: 600;
        padding: 0.5rem 0.75rem;
    }

    /* Improved Quick Actions buttons */
    .btn-primary, .btn-success, .btn-warning {
        border: none;
        border-radius: 8px;
        font-weight: 600;
        transition: all 0.3s ease;
        box-shadow: 0 4px 6px rgba(0,0,0,0.1);
    }

    .btn-primary:hover, .btn-success:hover, .btn-warning:hover {
        transform: translateY(-3px);
        box-shadow: 0 6px 12px rgba(0,0,0,0.15);
    }

    .btn-primary {
        background: linear-gradient(135deg, #3498db, #2980b9);
    }

    .btn-primary:hover {
        background: linear-gradient(135deg, #2980b9, #2471a3);
    }

    .btn-success {
        background: linear-gradient(135deg, #27ae60, #219a52);
    }

    .btn-success:hover {
        background: linear-gradient(135deg, #219a52, #1e8449);
    }

    .btn-warning {
        background: linear-gradient(135deg, #f39c12, #e67e22);
    }

    .btn-warning:hover {
        background: linear-gradient(135deg, #e67e22, #d35400);
    }

    /* Text readability improvements */
    .text-dark {
        color: #2c3e50 !important;
        font-weight: 600;
    }

    .text-muted {
        color: #6c757d !important;
    }

    .text-primary {
        color: #3498db !important;
        font-weight: 600;
    }

    .text-success {
        color: #27ae60 !important;
        font-weight: 600;
    }

    /* Responsive design */
    @@media (max-width: 768px) {
        .table-responsive {
            font-size: 0.85rem;
            border: 1px solid #e9ecef;
            border-radius: 8px;
        }
        
        .table th,
        .table td {
            padding: 0.75rem 0.5rem;
        }
        
        .stat-icon {
            display: none;
        }
        
        .btn {
            padding: 0.8rem 0.5rem;
        }
        
        .btn i.fa-2x {
            font-size: 1.5rem !important;
        }
    }

    @@media (max-width: 576px) {
        .d-flex.justify-content-between {
            flex-direction: column;
            gap: 1rem;
            text-align: center;
        }
        
        .table th:nth-child(2),
        .table td:nth-child(2),
        .table th:nth-child(5),
        .table td:nth-child(5) {
            display: none;
        }
        
        .row.g-3 .col-6,
        .row.g-3 .col-md-4 {
            margin-bottom: 1rem;
        }
        
        .card-body .row .col-6 {
            margin-bottom: 0.5rem;
        }
        
        h2 {
            font-size: 1.5rem;
        }
        
        .card-body .btn {
            padding: 0.6rem 0.5rem;
        }
        
        .card-body .btn i.fa-2x {
            font-size: 1.25rem !important;
            margin-bottom: 0.25rem !important;
        }
    }

    @@media (max-width: 400px) {
        .table th:nth-child(3),
        .table td:nth-child(3) {
            display: none;
        }
        
        .container {
            padding-left: 10px;
            padding-right: 10px;
        }
        
        .card-body {
            padding: 1rem !important;
        }
        
        .row.g-3 .col-6 {
            flex: 0 0 100%;
            max-width: 100%;
        }
    }
</style> 