@model AirlineReservationSystem.Models.Flight
@{
    ViewData["Title"] = "Create Flight";
}

<div class="container">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="mb-0">Create New Flight</h2>
        <a asp-action="Flights" class="btn btn-outline-secondary">
            <i class="fas fa-arrow-left me-2"></i>Back to Flights
        </a>
    </div>
    
    <div class="row justify-content-center">
        <div class="col-md-10 col-lg-8">
            <div class="card shadow-sm">
                <div class="card-header bg-primary text-white py-3">
                    <h4 class="mb-0">
                        <i class="fas fa-plane me-2"></i>Create New Flight
                    </h4>
                    <small class="opacity-75">Add a new flight to the system</small>
                </div>
                <div class="card-body p-4">
                    <form id="createFlightForm" asp-action="CreateFlight" method="post">
                        <!-- Airline Information -->
                        <div class="form-group mb-4">
                            <label asp-for="Airline" class="form-label fw-bold">Airline Name</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light">
                                    <i class="fas fa-building text-primary"></i>
                                </span>
                                <input asp-for="Airline" class="form-control" placeholder="Enter airline name" />
                            </div>
                            <span asp-validation-for="Airline" class="text-danger small"></span>
                        </div>
                        
                        <!-- Route Information -->
                        <div class="row mb-4">
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label asp-for="DepartureCity" class="form-label fw-bold">Departure City</label>
                                    <div class="input-group">
                                        <span class="input-group-text bg-light">
                                            <i class="fas fa-plane-departure text-primary"></i>
                                        </span>
                                        <input asp-for="DepartureCity" class="form-control" placeholder="Departure city" />
                                    </div>
                                    <span asp-validation-for="DepartureCity" class="text-danger small"></span>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label asp-for="ArrivalCity" class="form-label fw-bold">Arrival City</label>
                                    <div class="input-group">
                                        <span class="input-group-text bg-light">
                                            <i class="fas fa-plane-arrival text-primary"></i>
                                        </span>
                                        <input asp-for="ArrivalCity" class="form-control" placeholder="Arrival city" />
                                    </div>
                                    <span asp-validation-for="ArrivalCity" class="text-danger small"></span>
                                </div>
                            </div>
                        </div>
                        
                        <!-- Schedule Times -->
                        <div class="row mb-4">
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label asp-for="DepartureTime" class="form-label fw-bold">Departure Time</label>
                                    <div class="input-group">
                                        <span class="input-group-text bg-light">
                                            <i class="fas fa-calendar-alt text-primary"></i>
                                        </span>
                                        <input asp-for="DepartureTime" type="datetime-local" class="form-control" />
                                    </div>
                                    <span asp-validation-for="DepartureTime" class="text-danger small"></span>
                                    <small class="text-muted mt-1">
                                        <i class="fas fa-info-circle me-1"></i>
                                        Departure time must be in the future
                                    </small>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label asp-for="ArrivalTime" class="form-label fw-bold">Arrival Time</label>
                                    <div class="input-group">
                                        <span class="input-group-text bg-light">
                                            <i class="fas fa-calendar-check text-primary"></i>
                                        </span>
                                        <input asp-for="ArrivalTime" type="datetime-local" class="form-control" />
                                    </div>
                                    <span asp-validation-for="ArrivalTime" class="text-danger small"></span>
                                    <small class="text-muted mt-1">
                                        <i class="fas fa-info-circle me-1"></i>
                                        Arrival time must be after departure time
                                    </small>
                                </div>
                            </div>
                        </div>
                        
                        <!-- Capacity and Pricing -->
                        <div class="row mb-4">
                            <div class="col-md-4">
                                <div class="form-group">
                                    <label asp-for="TotalSeats" class="form-label fw-bold">Total Seats</label>
                                    <div class="input-group">
                                        <span class="input-group-text bg-light">
                                            <i class="fas fa-chair text-primary"></i>
                                        </span>
                                        <input asp-for="TotalSeats" class="form-control" min="1" max="1000" value="150" />
                                    </div>
                                    <span asp-validation-for="TotalSeats" class="text-danger small"></span>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="form-group">
                                    <label asp-for="Price" class="form-label fw-bold">Price ($)</label>
                                    <div class="input-group">
                                        <span class="input-group-text bg-light text-success fw-bold">$</span>
                                        <input asp-for="Price" class="form-control" step="0.01" min="0" placeholder="0.00" />
                                    </div>
                                    <span asp-validation-for="Price" class="text-danger small"></span>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="form-group">
                                    <label class="form-label fw-bold">Available Seats</label>
                                    <div class="input-group">
                                        <span class="input-group-text bg-light">
                                            <i class="fas fa-ticket-alt text-primary"></i>
                                        </span>
                                        <input class="form-control" value="150" readonly />
                                        <span class="input-group-text bg-light text-muted small">Auto-set from total seats</span>
                                    </div>
                                    <small class="text-muted">Available seats will be set equal to total seats initially</small>
                                </div>
                            </div>
                        </div>
                        
                        <!-- Status Toggle -->
                        <div class="form-group mb-4">
                            <div class="card bg-light">
                                <div class="card-body py-3">
                                    <div class="form-check form-switch mb-0">
                                        <input asp-for="IsActive" class="form-check-input" style="transform: scale(1.2);" checked />
                                        <label class="form-check-label fw-bold fs-6" asp-for="IsActive">
                                            Flight is Active
                                        </label>
                                    </div>
                                    <small class="text-muted mt-1 d-block">
                                        <i class="fas fa-info-circle me-1"></i>
                                        When active, this flight will be available for bookings.
                                    </small>
                                </div>
                            </div>
                        </div>
                        
                        <!-- Action Buttons -->
                        <div class="form-group mt-4 pt-3 border-top">
                            <div class="row">
                                <div class="col-md-6 mb-2">
                                    <button type="button" class="btn btn-success w-100 py-2 fw-bold" onclick="confirmFlightCreation()">
                                        <i class="fas fa-plus-circle me-2"></i>Create Flight
                                    </button>
                                </div>
                                <div class="col-md-6 mb-2">
                                    <a asp-action="Flights" class="btn btn-outline-secondary w-100 py-2">
                                        <i class="fas fa-times me-2"></i>Cancel
                                    </a>
                                </div>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Create Confirmation Modal -->
<div class="modal fade" id="createFlightModal" tabindex="-1" aria-labelledby="createFlightModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header bg-success text-white">
                <h5 class="modal-title" id="createFlightModalLabel">
                    <i class="fas fa-check-circle me-2"></i>Confirm Flight Creation
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p>Are you sure you want to create the following flight?</p>
                <div class="card border-success mb-3">
                    <div class="card-body">
                        <div class="row mb-2">
                            <div class="col-12">
                                <strong id="modalAirline" class="text-success"></strong>
                            </div>
                        </div>
                        <div class="row mb-2">
                            <div class="col-12">
                                <small class="text-muted" id="modalFlightRoute"></small>
                            </div>
                        </div>
                        <div class="row mb-2">
                            <div class="col-6">
                                <small class="text-muted">Departure:</small>
                                <div><strong id="modalDepartureTime"></strong></div>
                            </div>
                            <div class="col-6">
                                <small class="text-muted">Arrival:</small>
                                <div><strong id="modalArrivalTime"></strong></div>
                            </div>
                        </div>
                        <div class="row mt-2">
                            <div class="col-6">
                                <small class="text-muted">Seats:</small>
                                <div><strong id="modalFlightSeats"></strong></div>
                            </div>
                            <div class="col-6">
                                <small class="text-muted">Price:</small>
                                <div><strong id="modalFlightPrice" class="text-success"></strong></div>
                            </div>
                        </div>
                        <div class="row mt-2">
                            <div class="col-12">
                                <small class="text-muted">Status:</small>
                                <div><span class="badge bg-success" id="modalFlightStatus"></span></div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="alert alert-info">
                    <i class="fas fa-info-circle me-2"></i>
                    <strong>Note:</strong> This will add a new flight to the system. Make sure all information is correct before proceeding.
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                    <i class="fas fa-times me-1"></i>Cancel
                </button>
                <button type="button" class="btn btn-success" onclick="submitFlightForm()">
                    <i class="fas fa-check me-1"></i>Yes, Create Flight
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function confirmFlightCreation() {
            // Validate form first
            const form = document.getElementById('createFlightForm');
            if (!form.checkValidity()) {
                form.reportValidity();
                return;
            }

            // Get form values for modal display
            const airline = document.querySelector('input[name="Airline"]').value;
            const departureCity = document.querySelector('input[name="DepartureCity"]').value;
            const arrivalCity = document.querySelector('input[name="ArrivalCity"]').value;
            const departureTime = document.querySelector('input[name="DepartureTime"]').value;
            const arrivalTime = document.querySelector('input[name="ArrivalTime"]').value;
            const totalSeats = document.querySelector('input[name="TotalSeats"]').value;
            const price = document.querySelector('input[name="Price"]').value;
            const isActive = document.querySelector('input[name="IsActive"]').checked;

            // Format dates for display
            const departureDate = new Date(departureTime).toLocaleString('en-US', {
                weekday: 'short',
                year: 'numeric',
                month: 'short',
                day: 'numeric',
                hour: '2-digit',
                minute: '2-digit'
            });
            
            const arrivalDate = new Date(arrivalTime).toLocaleString('en-US', {
                weekday: 'short',
                year: 'numeric',
                month: 'short',
                day: 'numeric',
                hour: '2-digit',
                minute: '2-digit'
            });

            // Update modal content
            document.getElementById('modalAirline').textContent = airline;
            document.getElementById('modalFlightRoute').textContent = `${departureCity} → ${arrivalCity}`;
            document.getElementById('modalDepartureTime').textContent = departureDate;
            document.getElementById('modalArrivalTime').textContent = arrivalDate;
            document.getElementById('modalFlightSeats').textContent = `${totalSeats} total seats`;
            document.getElementById('modalFlightPrice').textContent = `$${parseFloat(price).toFixed(2)}`;
            document.getElementById('modalFlightStatus').textContent = isActive ? 'Active' : 'Inactive';
            document.getElementById('modalFlightStatus').className = isActive ? 'badge bg-success' : 'badge bg-danger';

            // Show the modal
            const modal = new bootstrap.Modal(document.getElementById('createFlightModal'));
            modal.show();
        }

        function submitFlightForm() {
            // Submit the form
            document.getElementById('createFlightForm').submit();
        }

        document.addEventListener('DOMContentLoaded', function() {
            const totalSeatsInput = document.querySelector('input[name="TotalSeats"]');
            const availableSeatsInput = document.querySelector('input[name="AvailableSeats"]');
            
            // Set available seats equal to total seats when total seats changes
            if (totalSeatsInput) {
                totalSeatsInput.addEventListener('change', function() {
                    if (availableSeatsInput) {
                        availableSeatsInput.value = this.value;
                    }
                });
            }

            // Validate arrival time is after departure time
            const departureInput = document.querySelector('input[name="DepartureTime"]');
            const arrivalInput = document.querySelector('input[name="ArrivalTime"]');
            
            if (departureInput && arrivalInput) {
                departureInput.addEventListener('change', function() {
                    if (arrivalInput.value && new Date(arrivalInput.value) <= new Date(this.value)) {
                        arrivalInput.setCustomValidity('Arrival time must be after departure time');
                        showTimeError('Arrival time must be after departure time');
                    } else {
                        arrivalInput.setCustomValidity('');
                        hideTimeError();
                    }
                });
                
                arrivalInput.addEventListener('change', function() {
                    if (departureInput.value && new Date(this.value) <= new Date(departureInput.value)) {
                        this.setCustomValidity('Arrival time must be after departure time');
                        showTimeError('Arrival time must be after departure time');
                    } else {
                        this.setCustomValidity('');
                        hideTimeError();
                    }
                });
            }

            // Set minimum datetime for departure and arrival to current time
            const now = new Date();
            const timezoneOffset = now.getTimezoneOffset() * 60000;
            const localISOTime = new Date(now - timezoneOffset).toISOString().slice(0, 16);
            
            if (departureInput) {
                departureInput.min = localISOTime;
                
                // Add validation for past dates
                departureInput.addEventListener('change', function() {
                    if (new Date(this.value) < new Date()) {
                        this.setCustomValidity('Departure time cannot be in the past');
                        showTimeError('Departure time cannot be in the past');
                    } else {
                        this.setCustomValidity('');
                        hideTimeError();
                    }
                });
            }
            
            if (arrivalInput) {
                arrivalInput.min = localISOTime;
            }

            // Auto-refresh page every 5 minutes
            setInterval(() => {
                console.log('Auto-refreshing create flight page...');
                window.location.reload();
            }, 300000); // 5 minutes
        });

        function showTimeError(message) {
            // Remove existing error message
            hideTimeError();
            
            // Create error message element
            const errorDiv = document.createElement('div');
            errorDiv.className = 'alert alert-danger mt-2';
            errorDiv.innerHTML = `<i class="fas fa-exclamation-triangle me-2"></i>${message}`;
            errorDiv.id = 'timeError';
            
            // Insert after the arrival time input
            const arrivalInput = document.querySelector('input[name="ArrivalTime"]');
            arrivalInput.parentNode.parentNode.appendChild(errorDiv);
        }

        function hideTimeError() {
            const existingError = document.getElementById('timeError');
            if (existingError) {
                existingError.remove();
            }
        }
    </script>
}

<style>
    .card {
        border: 1px solid #e3e6f0;
        border-radius: 12px;
        background: #ffffff;
    }

    .card-header {
        border-radius: 12px 12px 0 0 !important;
        border-bottom: 1px solid #e3e6f0;
        background: linear-gradient(135deg, #3498db, #2980b9) !important;
    }

    .form-label {
        color: #2c3e50;
        margin-bottom: 0.5rem;
    }

    .form-control {
        border: 1px solid #d1d3e2;
        border-radius: 8px;
        padding: 0.75rem 1rem;
        transition: all 0.3s ease;
        background: #ffffff;
    }

    .form-control:focus {
        border-color: #3498db;
        box-shadow: 0 0 0 0.2rem rgba(52, 152, 219, 0.25);
        background: #ffffff;
    }

    .form-control:read-only {
        background-color: #f8f9fa;
        border-color: #e9ecef;
        color: #6c757d;
    }

    .input-group-text {
        background-color: #f8f9fa;
        border: 1px solid #d1d3e2;
        color: #495057;
        min-width: 45px;
        justify-content: center;
    }

    .btn-success {
        background: linear-gradient(135deg, #27ae60, #219a52);
        border: none;
        border-radius: 8px;
        padding: 0.75rem 2rem;
        font-weight: 600;
        transition: all 0.3s ease;
    }

    .btn-success:hover {
        background: linear-gradient(135deg, #219a52, #1e8449);
        transform: translateY(-1px);
        box-shadow: 0 4px 8px rgba(39, 174, 96, 0.3);
    }

    .btn-outline-secondary {
        border: 2px solid #6c757d;
        border-radius: 8px;
        padding: 0.75rem 2rem;
        font-weight: 600;
        transition: all 0.3s ease;
    }

    .btn-outline-secondary:hover {
        background-color: #6c757d;
        border-color: #6c757d;
        transform: translateY(-1px);
    }

    .form-check-input:checked {
        background-color: #27ae60;
        border-color: #27ae60;
    }

    .form-check-input:focus {
        box-shadow: 0 0 0 0.2rem rgba(39, 174, 96, 0.25);
    }

    .text-danger {
        font-weight: 500;
    }

    .bg-light {
        background-color: #f8f9fa !important;
    }

    /* Modal Styling */
    .modal-header.bg-success {
        background: linear-gradient(135deg, #27ae60, #219a52) !important;
        border-bottom: 2px solid rgba(255,255,255,0.1);
    }

    .modal-content {
        border: none;
        border-radius: 12px;
        box-shadow: 0 10px 30px rgba(0,0,0,0.3);
    }

    /* Error message styling */
    .alert-danger {
        border: 1px solid #e74c3c;
        border-radius: 8px;
        background: linear-gradient(135deg, #e74c3c, #c0392b);
        color: white;
        font-weight: 500;
    }

    /* Responsive design */
    @@media (max-width: 768px) {
        .container {
            padding: 0 15px;
        }
        
        .card-body {
            padding: 1.5rem !important;
        }
        
        .input-group-text {
            min-width: 40px;
        }
        
        .btn {
            padding: 0.6rem 1.5rem;
        }
    }

    @@media (max-width: 576px) {
        .d-flex.justify-content-between {
            flex-direction: column;
            text-align: center;
            gap: 1rem;
        }
        
        .card-body {
            padding: 1rem !important;
        }
        
        .row .col-md-6,
        .row .col-md-4 {
            margin-bottom: 1rem;
        }
    }

    /* Animation for form elements */
    .form-group {
        transition: all 0.3s ease;
    }

    .form-group:focus-within {
        transform: translateY(-2px);
    }
</style>