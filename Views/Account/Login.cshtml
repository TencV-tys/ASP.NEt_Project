@model AirlineReservationSystem.Models.LoginModel
@{
    ViewData["Title"] = "Login";
}

<div class="container">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">
            <div class="card shadow-sm">
                <div class="card-header bg-primary text-white text-center py-4">
                    <h3 class="mb-0">
                        <i class="fas fa-plane me-2"></i>Visayan Airlines
                    </h3>
                    <p class="mb-0 mt-2 opacity-75">Please login to continue</p>
                </div>
                <div class="card-body p-4">
                    <form method="post">
                        <div asp-validation-summary="All" class="alert alert-danger"></div>
                        
                        <div class="form-group mb-4">
                            <label asp-for="Email" class="form-label fw-bold">Email Address</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light">
                                    <i class="fas fa-envelope text-primary"></i>
                                </span>
                                <input asp-for="Email" class="form-control" placeholder="Enter your email" />
                            </div>
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>
                        
                        <div class="form-group mb-4">
                            <label asp-for="Password" class="form-label fw-bold">Password</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light">
                                    <i class="fas fa-lock text-primary"></i>
                                </span>
                                <input asp-for="Password" type="password" class="form-control password-input" placeholder="Enter your password" id="password" />
                                <button type="button" class="btn btn-outline-secondary password-toggle" onclick="togglePassword('password', this)">
                                    <i class="fas fa-eye"></i>
                                </button>
                            </div>
                            <span asp-validation-for="Password" class="text-danger small"></span>
                        </div>
                        
                        <div class="form-group mb-4">
                            <button type="submit" class="btn btn-primary w-100 py-2 fw-bold">
                                <i class="fas fa-sign-in-alt me-2"></i> Login
                            </button>
                        </div>
                    </form>
                </div>
                <div class="card-footer text-center py-3">
                    <p class="mb-0">Don't have an account? 
                        <a asp-action="Register" asp-controller="Account" class="fw-bold text-primary">Register here</a>
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function togglePassword(inputId, button) {
            const passwordInput = document.getElementById(inputId);
            const icon = button.querySelector('i');
            
            if (passwordInput.type === 'password') {
                passwordInput.type = 'text';
                icon.classList.remove('fa-eye');
                icon.classList.add('fa-eye-slash');
                button.classList.add('active');
            } else {
                passwordInput.type = 'password';
                icon.classList.remove('fa-eye-slash');
                icon.classList.add('fa-eye');
                button.classList.remove('active');
            }
        }
    </script>
}

<style>
    .card {
        border: 1px solid #e3e6f0;
        border-radius: 12px;
        background: #ffffff;
    }

    .card-header {
        border-radius: 12px 12px 0 0 !important;
        border-bottom: 1px solid rgba(255,255,255,0.1);
    }

    .bg-primary {
        background: linear-gradient(135deg, #3498db, #2980b9) !important;
    }

    .form-control {
        border: 1px solid #d1d3e2;
        border-radius: 8px;
        padding: 0.75rem 1rem;
        transition: all 0.3s ease;
    }

    .form-control:focus {
        border-color: #3498db;
        box-shadow: 0 0 0 0.2rem rgba(52, 152, 219, 0.25);
    }

    .input-group-text {
        background-color: #f8f9fa;
        border: 1px solid #d1d3e2;
        color: #495057;
        border-right: none;
    }

    .password-input {
        border-left: none;
        border-right: none;
        border-radius: 0;
    }

    .password-toggle {
        border: 1px solid #d1d3e2;
        border-left: none;
        border-radius: 0 8px 8px 0;
        background-color: #f8f9fa;
        transition: all 0.3s ease;
    }

    .password-toggle:hover {
        background-color: #e9ecef;
        border-color: #d1d3e2;
    }

    .password-toggle.active {
        background-color: #e9ecef;
        border-color: #3498db;
    }

    .input-group:focus-within .input-group-text {
        border-color: #3498db;
    }

    .input-group:focus-within .password-input {
        border-color: #3498db;
    }

    .input-group:focus-within .password-toggle {
        border-color: #3498db;
    }

    .btn-primary {
        background: linear-gradient(135deg, #3498db, #2980b9);
        border: none;
        border-radius: 8px;
        font-weight: 600;
        transition: all 0.3s ease;
    }

    .btn-primary:hover {
        background: linear-gradient(135deg, #2980b9, #2471a3);
        transform: translateY(-1px);
    }

    .alert-danger {
        background: linear-gradient(135deg, #f8d7da, #f5c6cb);
        border-color: #e74c3c;
        color: #721c24;
        border-radius: 8px;
    }

    /* Responsive design */
    @@media (max-width: 768px) {
        .container {
            padding: 0 15px;
        }
        
        .card-body {
            padding: 1.5rem !important;
        }
    }

    /* Form label styling */
    .form-label {
        color: #2c3e50;
        margin-bottom: 0.5rem;
    }

    /* Input group focus states */
    .input-group:focus-within {
        box-shadow: 0 0 0 0.2rem rgba(52, 152, 219, 0.1);
        border-radius: 8px;
    }

    /* Smooth transitions */
    .input-group,
    .form-control,
    .password-toggle {
        transition: all 0.3s ease;
    }
</style>