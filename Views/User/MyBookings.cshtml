@model List<AirlineReservationSystem.Models.Booking>
@{
    ViewData["Title"] = "My Bookings";
}

<div class="container">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>My Bookings</h2>
        <a asp-action="Flights" class="btn btn-primary">
            <i class="fas fa-plane"></i> Book New Flight
        </a>
    </div>
    
    <div class="card">
        <div class="card-body p-0">
            @if (Model.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Booking</th>
                                <th>Flight Details</th>
                                <th>Travel Date</th>
                                <th>Passengers</th>
                                <th>Amount</th>
                                <th>Status</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var booking in Model)
                            {
                                var isRescheduled = booking.RescheduledDepartureTime.HasValue && booking.RescheduledArrivalTime.HasValue;
                                <tr>
                                    <td>
                                        <div class="d-flex flex-column">
                                            <small class="text-muted">Booking ID</small>
                                            <strong class="text-primary">@booking.BookingId.ToString().Substring(0, 8)...</strong>
                                            <small class="text-muted">@booking.BookingDate.ToString("MMM dd, yyyy")</small>
                                            @if (isRescheduled)
                                            {
                                                <small class="text-warning">
                                                    <i class="fas fa-clock me-1"></i>Rescheduled
                                                </small>
                                            }
                                        </div>
                                    </td>
                                    <td>
                                        <div class="d-flex flex-column">
                                            <div class="d-flex align-items-center mb-1">
                                                <i class="fas fa-plane text-muted me-2"></i>
                                                <strong>@booking.Flight?.FlightNumber</strong>
                                            </div>
                                            <div class="route-badge mb-1">
                                                <span class="badge bg-light text-dark">
                                                    @booking.Flight?.DepartureCity → @booking.Flight?.ArrivalCity
                                                </span>
                                            </div>
                                            <small class="text-muted">@booking.Flight?.Airline</small>
                                        </div>
                                    </td>
                                    <td>
                                        <div class="d-flex flex-column">
                                            @if (isRescheduled)
                                            {
                                                <div class="mb-2">
                                                    <small class="text-warning fw-bold">Rescheduled</small>
                                                    <strong>@booking.RescheduledDepartureTime?.ToString("MMM dd, yyyy HH:mm")</strong>
                                                    <small class="text-muted d-block">
                                                        <i class="fas fa-arrow-right me-1"></i>
                                                        @booking.RescheduledArrivalTime?.ToString("MMM dd, yyyy HH:mm")
                                                    </small>
                                                </div>
                                                <div class="border-top pt-2">
                                                    <small class="text-muted">Original</small>
                                                    <small class="text-muted d-block">@booking.Flight?.DepartureTime.ToString("MMM dd, HH:mm")</small>
                                                    <small class="text-muted d-block">
                                                        <i class="fas fa-arrow-right me-1"></i>
                                                        @booking.Flight?.ArrivalTime.ToString("MMM dd, HH:mm")
                                                    </small>
                                                </div>
                                            }
                                            else
                                            {
                                                <strong>@booking.Flight?.DepartureTime.ToString("MMM dd, yyyy")</strong>
                                                <small class="text-muted">@booking.Flight?.DepartureTime.ToString("HH:mm")</small>
                                                <small class="text-muted d-block">
                                                    <i class="fas fa-arrow-right me-1"></i>
                                                    @booking.Flight?.ArrivalTime.ToString("MMM dd, yyyy HH:mm")
                                                </small>
                                            }
                                        </div>
                                    </td>
                                    <td>
                                        <div class="text-center">
                                            <span class="passenger-count">@booking.NumberOfPassengers</span>
                                            <small class="d-block text-muted">passenger@(booking.NumberOfPassengers != 1 ? "s" : "")</small>
                                        </div>
                                    </td>
                                    <td>
                                        <div class="text-end">
                                            <strong class="text-success">$@booking.TotalAmount.ToString("N2")</strong>
                                            @if (booking.NumberOfPassengers > 1)
                                            {
                                                <small class="d-block text-muted">
                                                    $@((booking.TotalAmount / booking.NumberOfPassengers).ToString("N2")) each
                                                </small>
                                            }
                                        </div>
                                    </td>
                                    <td>
                                        <span class="badge @GetStatusBadgeClass(booking.Status)">
                                            @if (isRescheduled && booking.Status == "Confirmed")
                                            {
                                                <i class="fas fa-clock me-1"></i>
                                            }
                                            @booking.Status
                                        </span>
                                    </td>
                                    <td>
                                        <div class="action-buttons">
                                            @if (booking.Status == "Confirmed")
                                            {
                                                <div class="btn-group-vertical btn-group-sm">
                                                    <a asp-action="EditBooking" asp-route-id="@booking.BookingId" 
                                                       class="btn btn-outline-warning mb-1" title="Reschedule Booking">
                                                        <i class="fas fa-clock"></i> Reschedule
                                                    </a>
                                                    <form method="post" asp-action="CancelBooking" class="d-inline">
                                                        <input type="hidden" name="id" value="@booking.BookingId" />
                                                        <button type="submit" class="btn btn-outline-danger" 
                                                                onclick="return confirmCancelBooking('@booking.Flight?.FlightNumber', '@(isRescheduled ? booking.RescheduledDepartureTime?.ToString("MMM dd, yyyy HH:mm") : booking.Flight?.DepartureTime.ToString("MMM dd, yyyy HH:mm"))')"
                                                                title="Cancel Booking">
                                                            <i class="fas fa-times"></i> Cancel
                                                        </button>
                                                    </form>
                                                </div>
                                            }
                                            else
                                            {
                                                <span class="text-muted small">No actions</span>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="text-center py-5">
                    <div class="empty-state">
                        <i class="fas fa-ticket-alt fa-4x text-muted mb-4"></i>
                        <h3 class="text-muted">No Bookings Yet</h3>
                        <p class="text-muted mb-4">You haven't made any flight bookings yet.</p>
                        <a asp-action="Flights" class="btn btn-primary btn-lg">
                            <i class="fas fa-plane me-2"></i>Book Your First Flight
                        </a>
                    </div>
                </div>
            }
        </div>
    </div>

    <!-- Booking Stats -->
    @if (Model.Any())
    {
        <div class="row mt-4">
            <div class="col-md-3 col-6 mb-3">
                <div class="card bg-primary text-white">
                    <div class="card-body text-center py-3">
                        <h4 class="mb-0">@Model.Count</h4>
                        <small>Total Bookings</small>
                    </div>
                </div>
            </div>
            <div class="col-md-3 col-6 mb-3">
                <div class="card bg-success text-white">
                    <div class="card-body text-center py-3">
                        <h4 class="mb-0">@Model.Count(b => b.Status == "Confirmed")</h4>
                        <small>Confirmed</small>
                    </div>
                </div>
            </div>
            <div class="col-md-3 col-6 mb-3">
                <div class="card bg-info text-white">
                    <div class="card-body text-center py-3">
                        <h4 class="mb-0">@Model.Count(b => b.RescheduledDepartureTime.HasValue)</h4>
                        <small>Rescheduled</small>
                    </div>
                </div>
            </div>
            <div class="col-md-3 col-6 mb-3">
                <div class="card bg-danger text-white">
                    <div class="card-body text-center py-3">
                        <h4 class="mb-0">@Model.Count(b => b.Status == "Cancelled")</h4>
                        <small>Cancelled</small>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@functions {
    public string GetStatusBadgeClass(string status)
    {
        return status switch
        {
            "Confirmed" => "bg-success",
            "Cancelled" => "bg-danger",
            "Pending" => "bg-warning",
            _ => "bg-secondary"
        };
    }
}

@section Scripts {
    <script>
        function confirmCancelBooking(flightNumber, departureTime) {
            return confirm(`Are you sure you want to cancel your booking for flight ${flightNumber} on ${departureTime}?\n\nThis action cannot be undone.`);
        }
    </script>
}