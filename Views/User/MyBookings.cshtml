@model List<AirlineReservationSystem.Models.Booking>
@{
    ViewData["Title"] = "My Bookings";
}

<div class="container">
    <h2>My Bookings</h2>
    
    <div class="card">
        <div class="card-body">
            @if (Model.Any())
            {
                <div class="table-responsive">
                    <table class="table table-striped">
                        <thead>
                            <tr>
                                <th>Booking ID</th>
                                <th>Flight Details</th>
                                <th>Travel Date</th>
                                <th>Passengers</th>
                                <th>Total Amount</th>
                                <th>Booking Date</th>
                                <th>Status</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var booking in Model)
                            {
                                <tr>
                                    <td>@booking.BookingId</td>
                                    <td>
                                        <strong>@booking.Flight.FlightNumber</strong><br>
                                        <small>@booking.Flight.DepartureCity → @booking.Flight.ArrivalCity</small><br>
                                        <small>@booking.Flight.Airline</small>
                                    </td>
                                    <td>@booking.Flight.DepartureTime.ToString("MMM dd, yyyy")</td>
                                    <td>@booking.NumberOfPassengers</td>
                                    <td>$@booking.TotalAmount.ToString("N2")</td>
                                    <td>@booking.BookingDate.ToString("MMM dd, yyyy")</td>
                                    <td>
                                        <span class="badge @(booking.Status == "Confirmed" ? "bg-success" : 
                                                      booking.Status == "Cancelled" ? "bg-danger" : "bg-warning")">
                                            @booking.Status
                                        </span>
                                    </td>
                                    <td>
                                        @if (booking.Status == "Confirmed")
                                        {
                                            <form method="post" asp-action="CancelBooking" class="d-inline">
                                                <input type="hidden" name="id" value="@booking.BookingId" />
                                                <button type="submit" class="btn btn-sm btn-danger" 
                                                        onclick="return confirm('Are you sure you want to cancel this booking?')">
                                                    Cancel
                                                </button>
                                            </form>
                                        }
                                        else if (booking.Status == "Cancelled")
                                        {
                                            <span class="text-muted">Cancelled</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="text-center py-4">
                    <i class="fas fa-ticket-alt fa-3x text-muted mb-3"></i>
                    <h4>No bookings found</h4>
                    <p class="text-muted">You haven't made any bookings yet.</p>
                    <a asp-action="Flights" class="btn btn-primary">Book Your First Flight</a>
                </div>
            }
        </div>
    </div>
</div>