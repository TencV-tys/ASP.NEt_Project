@model List<AirlineReservationSystem.Models.Booking>
@{
    ViewData["Title"] = "My Bookings";
    
    // Auto-update booking statuses based on flight times
    var updatedBookings = Model.Select(booking =>
    {
        if (booking.Status == "Confirmed" && 
            (booking.RescheduledArrivalTime ?? booking.Flight?.ArrivalTime) < DateTime.Now)
        {
            booking.Status = "Completed";
        }
        return booking;
    }).ToList();

    // Filter parameters
    var statusFilter = Context.Request.Query["status"].ToString();
    var dateFilter = Context.Request.Query["date"].ToString();
    
    // Apply filters
    var filteredBookings = Model;
    
    if (!string.IsNullOrEmpty(statusFilter) && statusFilter != "All")
    {
        filteredBookings = filteredBookings.Where(b => b.Status == statusFilter).ToList();
    }
    
    if (!string.IsNullOrEmpty(dateFilter))
    {
        if (dateFilter == "upcoming")
        {
            filteredBookings = filteredBookings.Where(b => 
                b.Status == "Confirmed" && 
                (b.RescheduledDepartureTime ?? b.Flight.DepartureTime) > DateTime.Now
            ).ToList();
        }
        else if (dateFilter == "past")
        {
            filteredBookings = filteredBookings.Where(b => 
                b.Status == "Completed" || 
                (b.RescheduledArrivalTime ?? b.Flight.ArrivalTime) < DateTime.Now
            ).ToList();
        }
    }

    // Stats
    var totalBookings = Model.Count;
    var confirmedBookings = Model.Count(b => b.Status == "Confirmed");
    var completedBookings = Model.Count(b => b.Status == "Completed");
    var cancelledBookings = Model.Count(b => b.Status == "Cancelled");
    var upcomingBookings = Model.Count(b => 
        b.Status == "Confirmed" && 
        (b.RescheduledDepartureTime ?? b.Flight.DepartureTime) > DateTime.Now
    );
}

<div class="container">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>My Bookings</h2>
        <a asp-action="Flights" class="btn btn-primary">
            <i class="fas fa-plane"></i> Book New Flight
        </a>
    </div>

    <!-- Filter Section -->
    <div class="card mb-4">
        <div class="card-header bg-light">
            <h5 class="mb-0">
                <i class="fas fa-filter me-2"></i>Filters
            </h5>
        </div>
        <div class="card-body">
            <form method="get" class="row g-3">
                <div class="col-md-4">
                    <label class="form-label">Status</label>
                    <select name="status" class="form-select" onchange="this.form.submit()">
                        <option value="All">All Statuses</option>
                        <option value="Confirmed" selected="@(statusFilter == "Confirmed")">Confirmed</option>
                        <option value="Completed" selected="@(statusFilter == "Completed")">Completed</option>
                        <option value="Cancelled" selected="@(statusFilter == "Cancelled")">Cancelled</option>
                    </select>
                </div>
                <div class="col-md-4">
                    <label class="form-label">Date</label>
                    <select name="date" class="form-select" onchange="this.form.submit()">
                        <option value="">All Dates</option>
                        <option value="upcoming" selected="@(dateFilter == "upcoming")">Upcoming</option>
                        <option value="past" selected="@(dateFilter == "past")">Past</option>
                    </select>
                </div>
                <div class="col-md-4 d-flex align-items-end">
                    <a asp-action="MyBookings" class="btn btn-outline-secondary w-100">
                        <i class="fas fa-refresh me-1"></i> Clear Filters
                    </a>
                </div>
            </form>
        </div>
    </div>
    
    <!-- Booking Stats -->
    <div class="row mb-4">
        <div class="col-md-3 col-6 mb-3">
            <a href="@Url.Action("MyBookings", new { status = "" })" class="text-decoration-none">
                <div class="card bg-primary text-white hover-scale">
                    <div class="card-body text-center py-3">
                        <h4 class="mb-0">@totalBookings</h4>
                        <small>Total Bookings</small>
                    </div>
                </div>
            </a>
        </div>
        <div class="col-md-3 col-6 mb-3">
            <a href="@Url.Action("MyBookings", new { status = "Confirmed", date = "upcoming" })" class="text-decoration-none">
                <div class="card bg-success text-white hover-scale">
                    <div class="card-body text-center py-3">
                        <h4 class="mb-0">@upcomingBookings</h4>
                        <small>Upcoming</small>
                    </div>
                </div>
            </a>
        </div>
        <div class="col-md-3 col-6 mb-3">
            <a href="@Url.Action("MyBookings", new { status = "Completed", date = "past" })" class="text-decoration-none">
                <div class="card bg-info text-white hover-scale">
                    <div class="card-body text-center py-3">
                        <h4 class="mb-0">@completedBookings</h4>
                        <small>Completed</small>
                    </div>
                </div>
            </a>
        </div>
        <div class="col-md-3 col-6 mb-3">
            <a href="@Url.Action("MyBookings", new { status = "Cancelled" })" class="text-decoration-none">
                <div class="card bg-danger text-white hover-scale">
                    <div class="card-body text-center py-3">
                        <h4 class="mb-0">@cancelledBookings</h4>
                        <small>Cancelled</small>
                    </div>
                </div>
            </a>
        </div>
    </div>

    <!-- Results Summary -->
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h5 class="text-muted">
            Showing @filteredBookings.Count booking@(filteredBookings.Count != 1 ? "s" : "")
            @if (!string.IsNullOrEmpty(statusFilter) && statusFilter != "All")
            {
                <span class="badge bg-primary ms-2">@statusFilter</span>
            }
            @if (!string.IsNullOrEmpty(dateFilter))
            {
                <span class="badge bg-secondary ms-2">@dateFilter</span>
            }
        </h5>
        
        @if (filteredBookings.Count != totalBookings)
        {
            <a asp-action="MyBookings" class="btn btn-sm btn-outline-secondary">
                <i class="fas fa-times me-1"></i> Clear
            </a>
        }
    </div>
    
    <div class="card">
        <div class="card-body p-0">
            @if (filteredBookings.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Booking Reference</th>
                                <th>Flight Details</th>
                                <th>Travel Date</th>
                                <th>Passengers</th>
                                <th>Amount</th>
                                <th>Status</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var booking in filteredBookings)
                            {
                                var isRescheduled = booking.RescheduledDepartureTime.HasValue && booking.RescheduledArrivalTime.HasValue;
                                var flightTime = isRescheduled ? booking.RescheduledArrivalTime : booking.Flight?.ArrivalTime;
                                var isFlightCompleted = flightTime.HasValue && flightTime.Value < DateTime.Now;
                                var isUpcoming = booking.Status == "Confirmed" && 
                                               (booking.RescheduledDepartureTime ?? booking.Flight?.DepartureTime) > DateTime.Now;
                                
                                <tr>
                                    <td>
                                        <div class="d-flex flex-column">
                                            <small class="text-muted mb-1">Booking Reference</small>
                                            <strong class="text-primary">@booking.BookingReference</strong>
                                            <small class="text-muted">Booked: @booking.BookingDate.ToString("MMM dd, yyyy")</small>
                                            @if (isRescheduled)
                                            {
                                                <span class="badge bg-warning text-white mt-1">
                                                    <i class="fas fa-clock me-1"></i>Rescheduled
                                                </span>
                                            }
                                        </div>
                                    </td>
                                    <td>
                                        <div class="d-flex flex-column">
                                            <div class="d-flex align-items-center mb-1">
                                                <i class="fas fa-plane text-muted me-2"></i>
                                                <strong>@booking.Flight?.FlightNumber</strong>
                                            </div>
                                            <div class="route-badge mb-1">
                                                <span class="badge bg-light text-dark border">
                                                    @booking.Flight?.DepartureCity → @booking.Flight?.ArrivalCity
                                                </span>
                                            </div>
                                            <small class="text-muted">
                                                <i class="fas fa-building me-1"></i>@booking.Flight?.Airline
                                            </small>
                                            @if (isFlightCompleted && booking.Status == "Completed")
                                            {
                                                <small class="text-info mt-1">
                                                    <i class="fas fa-check-circle me-1"></i>Flight completed
                                                </small>
                                            }
                                            else if (isUpcoming)
                                            {
                                                <small class="text-success mt-1">
                                                    <i class="fas fa-plane-departure me-1"></i>Upcoming flight
                                                </small>
                                            }
                                        </div>
                                    </td>
                                    <td>
                                        <div class="d-flex flex-column">
                                            @if (isRescheduled)
                                            {
                                                <!-- Rescheduled Flight Times -->
                                                <div class="rescheduled-flight-times mb-2 p-2 bg-warning bg-opacity-20 rounded border border-warning">
                                                    <small class="text-dark fw-bold d-block mb-1">
                                                        <i class="fas fa-clock me-1 text-warning"></i>New Schedule
                                                    </small>
                                                    <div class="d-flex align-items-center mb-1">
                                                        <i class="fas fa-plane-departure text-warning me-2"></i>
                                                        <strong class="text-dark">@booking.RescheduledDepartureTime?.ToString("MMM dd, yyyy")</strong>
                                                    </div>
                                                    <div class="d-flex justify-content-between small">
                                                        <span class="text-dark fw-bold">@booking.RescheduledDepartureTime?.ToString("HH:mm")</span>
                                                        <i class="fas fa-arrow-right text-dark mx-2"></i>
                                                        <span class="text-dark fw-bold">@booking.RescheduledArrivalTime?.ToString("HH:mm")</span>
                                                    </div>
                                                    <small class="text-dark d-block mt-1">
                                                        @booking.RescheduledArrivalTime?.ToString("MMM dd")
                                                    </small>
                                                </div>
                                                
                                                <!-- Original Flight Times -->
                                                <div class="original-flight-times p-2 bg-light rounded border">
                                                    <small class="text-muted d-block mb-1">Original Schedule</small>
                                                    <div class="d-flex justify-content-between small text-muted">
                                                        <span>@booking.Flight?.DepartureTime.ToString("MMM dd, HH:mm")</span>
                                                        <i class="fas fa-arrow-right mx-2"></i>
                                                        <span>@booking.Flight?.ArrivalTime.ToString("MMM dd, HH:mm")</span>
                                                    </div>
                                                </div>
                                            }
                                            else
                                            {
                                                <!-- Regular Flight Times -->
                                                <div class="regular-flight-times">
                                                    <div class="d-flex align-items-center mb-1">
                                                        <i class="fas fa-plane-departure text-primary me-2"></i>
                                                        <strong class="text-dark">@booking.Flight?.DepartureTime.ToString("MMM dd, yyyy")</strong>
                                                    </div>
                                                    <div class="d-flex justify-content-between align-items-center mb-1">
                                                        <span class="fw-bold text-dark">@booking.Flight?.DepartureTime.ToString("HH:mm")</span>
                                                        <i class="fas fa-arrow-right text-muted mx-2"></i>
                                                        <span class="fw-bold text-dark">@booking.Flight?.ArrivalTime.ToString("HH:mm")</span>
                                                    </div>
                                                    <div class="d-flex justify-content-between small text-muted">
                                                        <span>@booking.Flight?.DepartureCity</span>
                                                        <span>@booking.Flight?.ArrivalCity</span>
                                                    </div>
                                                    <small class="text-muted d-block mt-1">
                                                        Duration: @GetFlightDuration(booking.Flight?.DepartureTime, booking.Flight?.ArrivalTime)
                                                    </small>
                                                </div>
                                            }
                                        </div>
                                    </td>
                                    <td>
                                        <div class="text-center">
                                            <span class="passenger-count fw-bold fs-5 text-dark">@booking.NumberOfPassengers</span>
                                            <small class="d-block text-muted">
                                                passenger@(booking.NumberOfPassengers != 1 ? "s" : "")
                                            </small>
                                        </div>
                                    </td>
                                    <td>
                                        <div class="text-end">
                                            <strong class="text-success fs-6">$@booking.TotalAmount.ToString("N2")</strong>
                                            @if (booking.NumberOfPassengers > 1)
                                            {
                                                <small class="d-block text-muted">
                                                    $@((booking.TotalAmount / booking.NumberOfPassengers).ToString("N2")) each
                                                </small>
                                            }
                                        </div>
                                    </td>
                                    <td>
                                        <span class="badge @GetStatusBadgeClass(booking.Status) px-3 py-2">
                                            @if (isRescheduled && booking.Status == "Confirmed")
                                            {
                                                <i class="fas fa-clock me-1"></i>
                                            }
                                            else if (booking.Status == "Confirmed")
                                            {
                                                <i class="fas fa-check me-1"></i>
                                            }
                                            else if (booking.Status == "Cancelled")
                                            {
                                                <i class="fas fa-times me-1"></i>
                                            }
                                            else if (booking.Status == "Completed")
                                            {
                                                <i class="fas fa-flag-checkered me-1"></i>
                                            }
                                            @booking.Status
                                            @if (isFlightCompleted && booking.Status == "Completed")
                                            {
                                                <i class="fas fa-sync-alt ms-1" title="Auto-completed"></i>
                                            }
                                        </span>
                                    </td>
                                    <td>
                                        <div class="action-buttons">
                                            <!-- View Receipt Button - Available for ALL Statuses -->
                                            <div class="btn-group-vertical btn-group-sm w-100">
                                                <!-- View Receipt Button - Always Visible -->
                                                <a href="#" class="btn btn-outline-info mb-2" 
                                                   data-bs-toggle="modal" data-bs-target="#receiptModal"
                                                   onclick="setReceiptDetails('@booking.BookingId', '@booking.BookingReference', '@booking.Flight?.FlightNumber', '@booking.Flight?.DepartureCity', '@booking.Flight?.ArrivalCity', '@(isRescheduled && booking.RescheduledDepartureTime.HasValue ? booking.RescheduledDepartureTime.Value.ToString("MMM dd, yyyy HH:mm") : booking.Flight?.DepartureTime.ToString("MMM dd, yyyy HH:mm"))', '@(isRescheduled && booking.RescheduledArrivalTime.HasValue ? booking.RescheduledArrivalTime.Value.ToString("MMM dd, yyyy HH:mm") : booking.Flight?.ArrivalTime.ToString("MMM dd, yyyy HH:mm"))', '@booking.PassengerName', '@booking.NumberOfPassengers', '@booking.CarryOnBags', '@booking.CheckedBags', '@booking.TotalAmount.ToString("N2")', '@booking.BookingDate.ToString("MMM dd, yyyy")', '@booking.Status')">
                                                    <i class="fas fa-receipt me-1"></i> View Receipt
                                                </a>

                                                @if (booking.Status == "Confirmed")
                                                {
                                                    <!-- Reschedule and Cancel only for Confirmed bookings -->
                                                    <a asp-action="EditBooking" asp-route-id="@booking.BookingId" 
                                                       class="btn btn-warning text-dark mb-2" title="Reschedule Booking">
                                                        <i class="fas fa-clock me-1"></i> Reschedule
                                                    </a>
                                                    <button type="button" class="btn btn-outline-danger w-100" 
                                                            onclick="confirmCancelBooking('@booking.BookingId', '@booking.Flight?.FlightNumber', '@(isRescheduled ? booking.RescheduledDepartureTime?.ToString("MMM dd, yyyy HH:mm") : booking.Flight?.DepartureTime.ToString("MMM dd, yyyy HH:mm"))')"
                                                            title="Cancel Booking">
                                                        <i class="fas fa-times me-1"></i> Cancel
                                                    </button>
                                                }
                                                else
                                                {
                                                    <!-- Print Receipt for Completed/Cancelled bookings -->
                                                    <a asp-action="BookingReceipt" asp-route-bookingId="@booking.BookingId" class="btn btn-outline-secondary w-100" target="_blank">
                                                        <i class="fas fa-print me-1"></i> Print Receipt
                                                    </a>
                                                }
                                            </div>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="text-center py-5">
                    <div class="empty-state">
                        <i class="fas fa-ticket-alt fa-4x text-muted mb-4"></i>
                        <h3 class="text-muted">No Bookings Found</h3>
                        <p class="text-muted mb-4">
                            @if (!string.IsNullOrEmpty(statusFilter) || !string.IsNullOrEmpty(dateFilter))
                            {
                                <text>No bookings match your current filters.</text>
                            }
                            else
                            {
                                <text>You haven't made any flight bookings yet.</text>
                            }
                        </p>
                        @if (!string.IsNullOrEmpty(statusFilter) || !string.IsNullOrEmpty(dateFilter))
                        {
                            <a asp-action="MyBookings" class="btn btn-primary">
                                <i class="fas fa-refresh me-2"></i>Clear Filters
                            </a>
                        }
                        else
                        {
                            <a asp-action="Flights" class="btn btn-primary btn-lg">
                                <i class="fas fa-plane me-2"></i>Book Your First Flight
                            </a>
                        }
                    </div>
                </div>
            }
        </div>
    </div>
</div>

<!-- Receipt Modal -->
<div class="modal fade" id="receiptModal" tabindex="-1" aria-labelledby="receiptModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header bg-success text-white">
                <h5 class="modal-title" id="receiptModalLabel">
                    <i class="fas fa-receipt me-2"></i>Booking Receipt
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="receipt-content">
                    <div class="text-center mb-4">
                        <i class="fas fa-check-circle fa-3x text-success mb-3"></i>
                        <h4 class="text-success">Booking Confirmed</h4>
                        <p class="text-muted">Booking Reference: <strong id="receiptBookingReference"></strong></p>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-6">
                            <h6>Flight Details</h6>
                            <p class="mb-1"><strong>Flight:</strong> <span id="receiptFlightNumber"></span></p>
                            <p class="mb-1"><strong>Route:</strong> <span id="receiptRoute"></span></p>
                            <p class="mb-1"><strong>Departure:</strong> <span id="receiptDeparture"></span></p>
                            <p class="mb-1"><strong>Arrival:</strong> <span id="receiptArrival"></span></p>
                        </div>
                        <div class="col-md-6">
                            <h6>Passenger Details</h6>
                            <p class="mb-1"><strong>Name:</strong> <span id="receiptPassengerName"></span></p>
                            <p class="mb-1"><strong>Passengers:</strong> <span id="receiptPassengers"></span></p>
                            <p class="mb-1"><strong>Bags:</strong> <span id="receiptBags"></span></p>
                            <p class="mb-1"><strong>Status:</strong> <span id="receiptStatus"></span></p>
                        </div>
                    </div>

                    <div class="payment-section bg-light rounded p-3">
                        <h6>Payment Summary</h6>
                        <div class="row">
                            <div class="col-6">
                                <p class="mb-1">Total Amount:</p>
                            </div>
                            <div class="col-6 text-end">
                                <p class="mb-1 fw-bold text-success fs-5">$<span id="receiptTotalAmount"></span></p>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-6">
                                <p class="mb-0 text-muted">Booked on: <span id="receiptBookingDate"></span></p>
                            </div>
                            <div class="col-6 text-end">
                                <p class="mb-0 text-muted">Booking ID: <span id="receiptBookingId"></span></p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                <a href="#" class="btn btn-primary" id="printReceiptBtn">
                    <i class="fas fa-print me-2"></i>Print Receipt
                </a>
            </div>
        </div>
    </div>
</div>

<!-- Cancel Booking Confirmation Modal -->
<div class="modal fade" id="cancelBookingModal" tabindex="-1" aria-labelledby="cancelBookingModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header bg-warning text-dark">
                <h5 class="modal-title" id="cancelBookingModalLabel">
                    <i class="fas fa-exclamation-triangle me-2"></i>Confirm Cancellation
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p>Are you sure you want to cancel your booking for flight <strong id="modalFlightNumber"></strong> on <strong id="modalDepartureTime"></strong>?</p>
                <div class="alert alert-danger mb-0">
                    <i class="fas fa-info-circle me-2"></i>
                    <strong>This action cannot be undone.</strong> Any payment will be refunded according to our cancellation policy.
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                    <i class="fas fa-times me-1"></i>Keep Booking
                </button>
                <form id="confirmCancelForm" method="post" asp-action="CancelBooking">
                    <input type="hidden" name="id" id="cancelBookingId" />
                    <button type="submit" class="btn btn-danger">
                        <i class="fas fa-check me-1"></i>Yes, Cancel Booking
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

@functions {
    public string GetStatusBadgeClass(string status)
    {
        return status switch
        {
            "Confirmed" => "bg-success",
            "Cancelled" => "bg-danger",
            "Completed" => "bg-info",
            _ => "bg-secondary"
        };
    }

    public string GetFlightDuration(DateTime? departure, DateTime? arrival)
    {
        if (!departure.HasValue || !arrival.HasValue)
            return "N/A";

        var duration = arrival.Value - departure.Value;
        return $"{(int)duration.TotalHours}h {duration.Minutes}m";
    }
}

@section Scripts {
    <script>
        // Set receipt details for modal
        function setReceiptDetails(bookingId, bookingReference, flightNumber, departureCity, arrivalCity, departureTime, arrivalTime, passengerName, passengers, carryOnBags, checkedBags, totalAmount, bookingDate, status) {
            document.getElementById('receiptBookingId').textContent = bookingId.substring(0, 8) + '...';
            document.getElementById('receiptBookingReference').textContent = bookingReference;
            document.getElementById('receiptFlightNumber').textContent = flightNumber;
            document.getElementById('receiptRoute').textContent = departureCity + ' → ' + arrivalCity;
            document.getElementById('receiptDeparture').textContent = departureTime;
            document.getElementById('receiptArrival').textContent = arrivalTime;
            document.getElementById('receiptPassengerName').textContent = passengerName;
            document.getElementById('receiptPassengers').textContent = passengers + ' passenger' + (passengers > 1 ? 's' : '');
            document.getElementById('receiptBags').textContent = carryOnBags + ' carry-on, ' + checkedBags + ' checked';
            document.getElementById('receiptTotalAmount').textContent = totalAmount;
            document.getElementById('receiptBookingDate').textContent = bookingDate;
            document.getElementById('receiptStatus').textContent = status;

            // Set print button link
            document.getElementById('printReceiptBtn').href = '@Url.Action("BookingReceipt")?bookingId=' + bookingId;
        }

        function confirmCancelBooking(bookingId, flightNumber, departureTime) {
            document.getElementById('modalFlightNumber').textContent = flightNumber;
            document.getElementById('modalDepartureTime').textContent = departureTime;
            document.getElementById('cancelBookingId').value = bookingId;
            
            const modal = new bootstrap.Modal(document.getElementById('cancelBookingModal'));
            modal.show();
            
            return false;
        }
    </script>

    <style>
        .hover-scale {
            transition: transform 0.2s ease-in-out;
        }
        .hover-scale:hover {
            transform: scale(1.05);
        }
        a.text-decoration-none {
            text-decoration: none !important;
        }
        
        .receipt-content {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }
        
        .payment-section {
            border-left: 4px solid #28a745;
        }
    </style>
}