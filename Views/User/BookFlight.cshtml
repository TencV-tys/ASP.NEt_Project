@model AirlineReservationSystem.Models.Flight
@{
    ViewData["Title"] = "Book Flight";
    var flightDuration = Model.ArrivalTime - Model.DepartureTime;
    var durationString = $"{(int)flightDuration.TotalHours}h {flightDuration.Minutes}m";
}

<div class="container">
    <!-- Breadcrumb Navigation -->
    <nav aria-label="breadcrumb" class="mb-4">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-controller="User" asp-action="Flights"><i class="fas fa-arrow-left me-1"></i>Back to Flights</a></li>
            <li class="breadcrumb-item active">Book Flight</li>
        </ol> 
    </nav>
    
    @if (User.IsInRole("Admin")) 
    {
        <div class="alert alert-warning text-center py-4">
            <div class="mb-3">
                <i class="fas fa-exclamation-triangle fa-3x text-warning"></i>
            </div>
            <h4 class="mb-3">Admin Account Detected</h4>
            <p class="mb-3">Administrator accounts cannot book flights. Please switch to a regular user account to make reservations.</p>
            <a asp-controller="User" asp-action="Flights" class="btn btn-outline-primary">
                <i class="fas fa-plane me-2"></i>Browse Flights
            </a>
        </div>
    }
    else
    {
        <div class="row">
            <!-- Main Booking Section -->
            <div class="col-lg-8">
                <!-- Flight Summary Card -->
                <div class="card shadow-sm mb-4">
                    <div class="card-header bg-primary text-white">
                        <h4 class="mb-0"><i class="fas fa-plane me-2"></i>Flight Summary</h4>
                    </div>
                    <div class="card-body">
                        <div class="row align-items-center">
                            <div class="col-md-8">
                                <div class="flight-route mb-3">
                                    <div class="d-flex justify-content-between align-items-center mb-2">
                                        <div class="text-center">
                                            <h5 class="mb-1 text-dark">@Model.DepartureCity</h5>
                                            <small class="text-muted">@Model.DepartureTime.ToString("MMM dd, yyyy")</small>
                                            <div class="fw-bold text-primary">@Model.DepartureTime.ToString("HH:mm")</div>
                                        </div>
                                        <div class="flight-connection text-center mx-3">
                                            <div class="connection-line bg-primary"></div>
                                            <i class="fas fa-plane text-primary mt-2"></i>
                                            <div class="text-muted small mt-1">@durationString</div>
                                        </div>
                                        <div class="text-center">
                                            <h5 class="mb-1 text-dark">@Model.ArrivalCity</h5>
                                            <small class="text-muted">@Model.ArrivalTime.ToString("MMM dd, yyyy")</small>
                                            <div class="fw-bold text-primary">@Model.ArrivalTime.ToString("HH:mm")</div>
                                        </div>
                                    </div>
                                </div>
                                
                                <div class="flight-details">
                                    <div class="row">
                                        <div class="col-sm-6 mb-2">
                                            <small class="text-muted">Flight Number</small>
                                            <div class="fw-bold">@Model.FlightNumber</div>
                                        </div>
                                        <div class="col-sm-6 mb-2">
                                            <small class="text-muted">Airline</small>
                                            <div class="fw-bold">@Model.Airline</div>
                                        </div>
                                        <div class="col-sm-6 mb-2">
                                            <small class="text-muted">Aircraft</small>
                                            <div class="fw-bold">Boeing 737</div>
                                        </div>
                                        <div class="col-sm-6 mb-2">
                                            <small class="text-muted">Class</small>
                                            <div class="fw-bold">Economy</div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-4 text-center">
                                <div class="price-section">
                                    <div class="text-muted mb-1">Price per passenger</div>
                                    <h3 class="text-success mb-2">$@Model.Price.ToString("N2")</h3>
                                    <div class="availability-badge">
                                        @if (Model.AvailableSeats > 10)
                                        {
                                            <span class="badge bg-success">@Model.AvailableSeats seats available</span>
                                        }
                                        else if (Model.AvailableSeats > 0)
                                        {
                                            <span class="badge bg-warning">Only @Model.AvailableSeats seats left</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger">Fully booked</span>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Booking Form -->
                <div class="card shadow-sm">
                    <div class="card-header">
                        <h5 class="mb-0"><i class="fas fa-users me-2"></i>Passenger Details</h5>
                    </div>
                    <div class="card-body">
                        <form method="post" asp-action="BookFlight" id="bookingForm">
                            <input type="hidden" name="flightId" value="@Model.FlightId" />
                            
                            <!-- Passenger Name Input -->
                            <div class="form-section mb-4">
                                <label class="form-label fw-bold mb-3">Passenger Name</label>
                                <div class="row">
                                    <div class="col-md-8">
                                        <input type="text" class="form-control form-control-lg" name="passengerName" 
                                               placeholder="Enter full name" required
                                               >
                                        <div class="form-text">Enter the name of the primary passenger for this booking</div>
                                    </div>
                                </div>
                            </div>

                            <!-- Passenger Count Selection -->
                            <div class="form-section mb-4">
                                <label class="form-label fw-bold mb-3">How many passengers?</label>
                                <div class="passenger-selector">
                                    <div class="row g-2 justify-content-center">
                                        @for (int i = 1; i <= Math.Min(6, Model.AvailableSeats); i++)
                                        {
                                            <div class="col-4 col-sm-3 col-md-2">
                                                <input type="radio" name="numberOfPassengers" value="@i" id="passenger@(i)" class="btn-check" @(i == 1 ? "checked" : "")>
                                                <label class="btn btn-outline-primary w-100 passenger-option d-flex flex-column align-items-center justify-content-center" for="passenger@(i)" style="min-height: 80px;">
                                                    <span class="fw-bold fs-5">@i</span>
                                                    <small class="text-center">passenger@(i > 1 ? "s" : "")</small>
                                                </label>
                                            </div>
                                        }
                                    </div>
                                </div>
                            </div>

                            <!-- Baggage Selection -->
                            <div class="form-section mb-4">
                                <label class="form-label fw-bold mb-3">Baggage Options</label>
                                
                                <!-- Carry-on Bags -->
                                <div class="baggage-section mb-3">
                                    <div class="d-flex justify-content-between align-items-center mb-2">
                                        <div>
                                            <h6 class="mb-1">Carry-on Bags</h6>
                                            <small class="text-muted">Free (up to 7kg each)</small>
                                        </div>
                                        <div class="baggage-selector">
                                            <div class="btn-group" role="group">
                                                @for (int i = 0; i <= 4; i++)
                                                {
                                                    <input type="radio" class="btn-check" name="carryOnBags" value="@i" id="carryOn@(i)" @(i == 0 ? "checked" : "")>
                                                    <label class="btn btn-outline-secondary" for="carryOn@(i)">@i</label>
                                                }
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <!-- Checked Bags -->
                                <div class="baggage-section">
                                    <div class="d-flex justify-content-between align-items-center mb-2">
                                        <div>
                                            <h6 class="mb-1">Checked Bags</h6>
                                            <small class="text-muted">$30 per bag (up to 23kg each)</small>
                                        </div>
                                        <div class="baggage-selector">
                                            <div class="btn-group" role="group">
                                                @for (int i = 0; i <= 4; i++)
                                                {
                                                    <input type="radio" class="btn-check" name="checkedBags" value="@i" id="checked@(i)" @(i == 0 ? "checked" : "")>
                                                    <label class="btn btn-outline-secondary" for="checked@(i)">@i</label>
                                                }
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Booking Summary -->
                            <div class="booking-summary bg-light rounded p-4 mb-4">
                                <h6 class="mb-3"><i class="fas fa-receipt me-2"></i>Booking Summary</h6>
                                <div class="row mb-2">
                                    <div class="col-6">
                                        <small class="text-muted">Passenger Name</small>
                                        <div id="summaryPassengerName">@User.Identity?.Name</div>
                                    </div>
                                    <div class="col-6">
                                        <small class="text-muted">Passengers</small>
                                        <div id="summaryPassengers">1 passenger</div>
                                    </div>
                                </div>
                                <div class="row mb-2">
                                    <div class="col-6">
                                        <small class="text-muted">Carry-on Bags</small>
                                        <div id="summaryCarryOn">0 (Free)</div>
                                    </div>
                                    <div class="col-6">
                                        <small class="text-muted">Checked Bags</small>
                                        <div id="summaryChecked">0 ($0.00)</div>
                                    </div>
                                </div>
                                <div class="row mb-2">
                                    <div class="col-12 text-end">
                                        <small class="text-muted">Base Fare</small>
                                        <div id="summaryBaseFare">$@Model.Price.ToString("N2")</div>
                                    </div>
                                </div>
                                <hr>
                                <div class="row fw-bold">
                                    <div class="col-6">Total Amount</div>
                                    <div class="col-6 text-end text-success">
                                        <span id="summaryTotal">$@Model.Price.ToString("N2")</span>
                                    </div>
                                </div>
                            </div>

                            <!-- Action Buttons -->
                            <div class="d-grid gap-2">
                                <button type="button" class="btn btn-success btn-lg py-3" id="confirmBookingBtn" data-bs-toggle="modal" data-bs-target="#confirmationModal">
                                    <i class="fas fa-lock me-2"></i>Confirm & Pay Now
                                </button>
                                <a asp-controller="User" asp-action="Flights" class="btn btn-outline-secondary">
                                    <i class="fas fa-times me-2"></i>Cancel
                                </a>
                            </div>
                        </form>
                    </div>
                </div>
            </div>

            <!-- Sidebar Information -->
            <div class="col-lg-4">
                <!-- Quick Info Card -->
                <div class="card shadow-sm">
                    <div class="card-header bg-light">
                        <h6 class="mb-0"><i class="fas fa-info-circle me-2"></i>Quick Info</h6>
                    </div>
                    <div class="card-body">
                        <div class="info-item mb-3">
                            <div class="d-flex align-items-start">
                                <i class="fas fa-check-circle text-success me-2 mt-1"></i>
                                <div>
                                    <small class="fw-bold d-block">Free Cancellation</small>
                                    <small class="text-muted">Cancel for free within 24 hours</small>
                                </div>
                            </div>
                        </div>
                    
                        <div class="info-item">
                            <div class="d-flex align-items-start">
                                <i class="fas fa-check-circle text-success me-2 mt-1"></i>
                                <div>
                                    <small class="fw-bold d-block">Online Check-in</small>
                                    <small class="text-muted">24 hours before departure</small>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

<!-- Confirmation Modal -->
<div class="modal fade" id="confirmationModal" tabindex="-1" aria-labelledby="confirmationModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header bg-success text-white">
                <h5 class="modal-title" id="confirmationModalLabel">
                    <i class="fas fa-plane-circle-check me-2"></i>Confirm Booking
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="text-center mb-4">
                    <i class="fas fa-plane fa-3x text-primary mb-3"></i>
                    <h5 class="mb-3">Ready to book your flight?</h5>
                </div>
                
                <div class="confirmation-details bg-light rounded p-3 mb-4">
                    <div class="row mb-2">
                        <div class="col-6">
                            <small class="text-muted">Passenger Name</small>
                            <div class="fw-bold" id="modalPassengerName">@User.Identity?.Name</div>
                        </div>
                        <div class="col-6">
                            <small class="text-muted">Flight</small>
                            <div class="fw-bold">@Model.FlightNumber</div>
                        </div>
                    </div>
                    <div class="row mb-2">
                        <div class="col-6">
                            <small class="text-muted">Route</small>
                            <div class="fw-bold">@Model.DepartureCity → @Model.ArrivalCity</div>
                        </div>
                        <div class="col-6">
                            <small class="text-muted">Date</small>
                            <div class="fw-bold">@Model.DepartureTime.ToString("MMM dd, yyyy")</div>
                        </div>
                    </div>
                    <div class="row mb-2">
                        <div class="col-6">
                            <small class="text-muted">Passengers</small>
                            <div class="fw-bold" id="modalPassengers">1 passenger</div>
                        </div>
                        <div class="col-6">
                            <small class="text-muted">Bags</small>
                            <div class="fw-bold" id="modalBags">0 carry-on, 0 checked</div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-6">
                            <small class="text-muted">Base Fare</small>
                            <div class="fw-bold" id="modalBaseFare">$@Model.Price.ToString("N2")</div>
                        </div>
                        <div class="col-6">
                            <small class="text-muted">Total Amount</small>
                            <div class="fw-bold text-success" id="modalTotalAmount">$@Model.Price.ToString("N2")</div>
                        </div>
                    </div>
                </div>
                
                <div class="alert alert-info">
                    <small>
                        <i class="fas fa-info-circle me-2"></i>
                        Your booking will be confirmed immediately. E-ticket will be sent to your email.
                    </small>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                    <i class="fas fa-times me-2"></i>Cancel
                </button>
                <button type="button" class="btn btn-success" id="finalConfirmBtn">
                    <i class="fas fa-check me-2"></i>Confirm Booking
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const pricePerPassenger = @Model.Price;
            const checkedBagFee = 30; // $30 per checked bag
            
            const passengerNameInput = document.querySelector('input[name="passengerName"]');
            const passengerOptions = document.querySelectorAll('input[name="numberOfPassengers"]');
            const carryOnOptions = document.querySelectorAll('input[name="carryOnBags"]');
            const checkedOptions = document.querySelectorAll('input[name="checkedBags"]');
            
            const summaryPassengerName = document.getElementById('summaryPassengerName');
            const summaryPassengers = document.getElementById('summaryPassengers');
            const summaryBaseFare = document.getElementById('summaryBaseFare');
            const summaryCarryOn = document.getElementById('summaryCarryOn');
            const summaryChecked = document.getElementById('summaryChecked');
            const summaryTotal = document.getElementById('summaryTotal');
            
            const confirmBookingBtn = document.getElementById('confirmBookingBtn');
            const modalPassengerName = document.getElementById('modalPassengerName');
            const modalPassengers = document.getElementById('modalPassengers');
            const modalBags = document.getElementById('modalBags');
            const modalBaseFare = document.getElementById('modalBaseFare');
            const modalTotalAmount = document.getElementById('modalTotalAmount');
            const finalConfirmBtn = document.getElementById('finalConfirmBtn');
            const bookingForm = document.getElementById('bookingForm');

            function updateBookingSummary() {
                const passengerName = passengerNameInput.value;
                const selectedPassengers = parseInt(document.querySelector('input[name="numberOfPassengers"]:checked').value);
                const carryOnBags = parseInt(document.querySelector('input[name="carryOnBags"]:checked').value);
                const checkedBags = parseInt(document.querySelector('input[name="checkedBags"]:checked').value);
                
                const baseAmount = selectedPassengers * pricePerPassenger;
                const baggageFee = checkedBags * checkedBagFee;
                const totalAmount = baseAmount + baggageFee;
                
                // Update summary
                summaryPassengerName.textContent = passengerName || 'Not specified';
                summaryPassengers.textContent = selectedPassengers + ' passenger' + (selectedPassengers > 1 ? 's' : '');
                summaryBaseFare.textContent = '$' + baseAmount.toFixed(2);
                summaryCarryOn.textContent = carryOnBags + ' (Free)';
                summaryChecked.textContent = checkedBags + ' ($' + baggageFee.toFixed(2) + ')';
                summaryTotal.textContent = '$' + totalAmount.toFixed(2);
                
                // Update button text
                confirmBookingBtn.innerHTML = `<i class="fas fa-lock me-2"></i>Pay $${totalAmount.toFixed(2)} Now`;
                
                // Update modal details
                modalPassengerName.textContent = passengerName || 'Not specified';
                modalPassengers.textContent = selectedPassengers + ' passenger' + (selectedPassengers > 1 ? 's' : '');
                modalBags.textContent = carryOnBags + ' carry-on, ' + checkedBags + ' checked';
                modalBaseFare.textContent = '$' + baseAmount.toFixed(2);
                modalTotalAmount.textContent = '$' + totalAmount.toFixed(2);
            }

            // Add event listeners to all options
            passengerNameInput.addEventListener('input', updateBookingSummary);
            passengerOptions.forEach(option => {
                option.addEventListener('change', updateBookingSummary);
            });
            carryOnOptions.forEach(option => {
                option.addEventListener('change', updateBookingSummary);
            });
            checkedOptions.forEach(option => {
                option.addEventListener('change', updateBookingSummary);
            });

            // Initial update
            updateBookingSummary();

            // Final confirmation button click
            finalConfirmBtn.addEventListener('click', function() {
                // Validate passenger name
                if (!passengerNameInput.value.trim()) {
                    alert('Please enter a passenger name');
                    passengerNameInput.focus();
                    return;
                }

                // Show loading state
                this.innerHTML = '<i class="fas fa-spinner fa-spin me-2"></i>Processing...';
                this.disabled = true;
                
                // Submit the form after a brief delay to show loading state
                setTimeout(() => {
                    bookingForm.submit();
                }, 1500);
            });

            // Reset final confirm button when modal is hidden
            document.getElementById('confirmationModal').addEventListener('hidden.bs.modal', function() {
                finalConfirmBtn.innerHTML = '<i class="fas fa-check me-2"></i>Confirm Booking';
                finalConfirmBtn.disabled = false;
            });

            // Add animation for price update
            function animatePriceUpdate(element) {
                element.classList.add('price-update');
                setTimeout(() => {
                    element.classList.remove('price-update');
                }, 500);
            }

            // Enhanced selection with animation
            const allOptions = [...passengerOptions, ...carryOnOptions, ...checkedOptions];
            allOptions.forEach(option => {
                option.addEventListener('change', function() {
                    updateBookingSummary();
                    animatePriceUpdate(summaryTotal);
                    animatePriceUpdate(modalTotalAmount);
                });
            });
        });
    </script>
}

<style>
    .breadcrumb {
        background: transparent;
        padding: 0;
    }

    .breadcrumb-item a {
        text-decoration: none;
        color: #6c757d;
    }

    .breadcrumb-item a:hover {
        color: #3498db;
    }

    .flight-connection {
        position: relative;
        flex: 1;
    }

    .connection-line {
        height: 2px;
        width: 100%;
        position: absolute;
        top: 50%;
        transform: translateY(-50%);
        z-index: 1;
    }

    .flight-connection i {
        position: relative;
        z-index: 2;
        background: white;
        padding: 0 10px;
    }

    .passenger-option, .baggage-selector .btn {
        transition: all 0.3s ease;
        padding: 1rem 0.5rem;
    }

    .passenger-option:hover, .baggage-selector .btn:hover {
        transform: translateY(-2px);
        box-shadow: 0 4px 8px rgba(0,0,0,0.1);
    }

    .btn-check:checked + .passenger-option,
    .btn-check:checked + .btn {
        background: linear-gradient(135deg, #3498db, #2980b9);
        border-color: #2980b9;
        color: white;
        transform: translateY(-2px);
        box-shadow: 0 4px 12px rgba(52, 152, 219, 0.3);
    }

    .form-section {
        border-bottom: 1px solid #e9ecef;
        padding-bottom: 1.5rem;
    }

    .booking-summary {
        border-left: 4px solid #27ae60;
    }

    .info-item {
        border-left: 3px solid #17a2b8;
        padding-left: 1rem;
    }

    .confirmation-details {
        border: 1px solid #dee2e6;
    }

    .baggage-section {
        padding: 1rem;
        border: 1px solid #e9ecef;
        border-radius: 8px;
        background: #f8f9fa;
    }

    /* Animation for price update */
    .price-update {
        animation: pulse 0.5s ease-in-out;
    }

    @@keyframes pulse {
        0% { transform: scale(1); }
        50% { transform: scale(1.05); }
        100% { transform: scale(1); }
    }

    /* Modal styling */
    .modal-header.bg-success {
        background: linear-gradient(135deg, #27ae60, #219a52) !important;
    }

    /* Responsive adjustments */
    @@media (max-width: 768px) {
        .flight-route .d-flex {
            flex-direction: column;
            text-align: center;
        }
        
        .flight-connection {
            margin: 1rem 0;
        }
        
        .connection-line {
            width: 2px;
            height: 40px;
            left: 50%;
            top: auto;
        }
        
        .passenger-option, .baggage-selector .btn {
            padding: 0.75rem 0.25rem;
        }
        
        .baggage-section .d-flex {
            flex-direction: column;
            text-align: center;
        }
        
        .baggage-selector {
            margin-top: 1rem;
        }
    }
</style>