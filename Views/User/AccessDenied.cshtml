@{
    ViewData["Title"] = "Access Denied";
}

<div class="container">
    <div class="row justify-content-center">
        <div class="col-md-6 text-center">
            <i class="fas fa-user-shield fa-5x text-warning mb-4"></i>
            <h1 class="text-warning">Access Restricted</h1>
            <h3>This feature is for regular users only.</h3>
            <p class="lead">Admin users cannot access user booking features.</p>
            <div class="mt-4">
                <a href="/" class="btn btn-primary">Go to Homepage</a>
                @if (User.IsInRole("Admin"))
                {
                    <a href="/Admin/Dashboard" class="btn btn-outline-secondary">Go to Admin Dashboard</a>
                }
            </div>
        </div>
    </div>
</div>