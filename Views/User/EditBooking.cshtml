@model AirlineReservationSystem.Models.Booking
@{
    ViewData["Title"] = "Reschedule Flight";
}

<div class="container">
    <div class="row justify-content-center">
        <div class="col-md-10">
            <div class="card shadow-sm">
                <div class="card-header bg-warning text-white py-3">
                    <h3 class="card-title mb-0">
                        <i class="fas fa-clock me-2"></i> Reschedule Your Flight
                    </h3>
                </div>
                <div class="card-body p-4">
                    <!-- Current Flight Information -->
                    <div class="current-flight-card bg-light rounded p-4 mb-4">
                        <h5 class="mb-3 text-dark">
                            <i class="fas fa-plane me-2"></i>Current Booking Details
                        </h5>
                        <div class="row">
                            <div class="col-md-6">
                                <div class="flight-info-item mb-2">
                                    <small class="text-muted">Booking Reference</small>
                                    <div class="fw-bold text-primary">@Model.BookingReference</div>
                                </div>
                                <div class="flight-info-item mb-2">
                                    <small class="text-muted">Flight Number</small>
                                    <div class="fw-bold">@Model.Flight.FlightNumber</div>
                                </div>
                                <div class="flight-info-item mb-2">
                                    <small class="text-muted">Airline</small>
                                    <div class="fw-bold">@Model.Flight.Airline</div>
                                </div>
                                <div class="flight-info-item">
                                    <small class="text-muted">Route</small>
                                    <div class="fw-bold text-primary">@Model.Flight.DepartureCity → @Model.Flight.ArrivalCity</div>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="flight-info-item mb-2">
                                    <small class="text-muted">Original Departure</small>
                                    <div class="fw-bold">@Model.Flight.DepartureTime.ToString("MMM dd, yyyy HH:mm")</div>
                                </div>
                                <div class="flight-info-item mb-2">
                                    <small class="text-muted">Original Arrival</small>
                                    <div class="fw-bold">@Model.Flight.ArrivalTime.ToString("MMM dd, yyyy HH:mm")</div>
                                </div>
                                <div class="flight-info-item">
                                    <small class="text-muted">Price per seat</small>
                                    <div class="fw-bold text-success">$@Model.Flight.Price.ToString("N2")</div>
                                </div>
                            </div>
                        </div>
                        @if (Model.RescheduledDepartureTime.HasValue)
                        {
                            <div class="rescheduled-info mt-3 p-3 bg-warning rounded border border-warning">
                                <small class="fw-bold text-white d-block mb-2">
                                    <i class="fas fa-clock me-1"></i>Currently Rescheduled To
                                </small>
                                <div class="row">
                                    <div class="col-6">
                                        <small class="text-white">Departure</small>
                                        <div class="fw-bold text-white">@Model.RescheduledDepartureTime?.ToString("MMM dd, yyyy HH:mm")</div>
                                    </div>
                                    <div class="col-6">
                                        <small class="text-white">Arrival</small>
                                        <div class="fw-bold text-white">@Model.RescheduledArrivalTime?.ToString("MMM dd, yyyy HH:mm")</div>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>

                    <!-- Reschedule Form -->
                    <form method="post" asp-action="EditBooking" id="rescheduleForm">
                        <input type="hidden" name="id" value="@Model.BookingId" />
                        
                        <div class="form-section mb-4">
                            <h5 class="mb-3 text-dark">
                                <i class="fas fa-calendar-alt me-2"></i>Select New Schedule
                            </h5>
                            
                            <!-- New Departure Time -->
                            <div class="row">
                                <div class="col-md-6">
                                    <div class="form-group mb-3">
                                        <label for="newDepartureTime" class="form-label fw-bold">New Departure Time</label>
                                        <input type="datetime-local" 
                                               class="form-control form-control-lg" 
                                               id="newDepartureTime" 
                                               name="newDepartureTime" 
                                               value="@(Model.RescheduledDepartureTime?.ToString("yyyy-MM-ddTHH:mm") ?? Model.Flight.DepartureTime.ToString("yyyy-MM-ddTHH:mm"))"
                                               min="@DateTime.Now.ToString("yyyy-MM-ddTHH:mm")"
                                               required />
                                        <small class="form-text text-muted">
                                            Choose your preferred departure date and time
                                        </small>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="form-group mb-3">
                                        <label for="newArrivalTime" class="form-label fw-bold">New Arrival Time</label>
                                        <input type="datetime-local" 
                                               class="form-control form-control-lg" 
                                               id="newArrivalTime" 
                                               name="newArrivalTime" 
                                               value="@(Model.RescheduledArrivalTime?.ToString("yyyy-MM-ddTHH:mm") ?? Model.Flight.ArrivalTime.ToString("yyyy-MM-ddTHH:mm"))"
                                               min="@DateTime.Now.AddHours(1).ToString("yyyy-MM-ddTHH:mm")"
                                               required />
                                        <small class="form-text text-muted">
                                            Choose your preferred arrival date and time
                                        </small>
                                    </div>
                                </div>
                            </div>

                            <!-- Number of Passengers -->
                            <div class="form-group mb-4">
                                <label for="numberOfPassengers" class="form-label fw-bold">Number of Passengers</label>
                                <input type="number" 
                                       class="form-control form-control-lg" 
                                       id="numberOfPassengers" 
                                       name="numberOfPassengers" 
                                       value="@Model.NumberOfPassengers" 
                                       min="1" 
                                       max="@(Model.NumberOfPassengers + Model.Flight.AvailableSeats)"
                                       required />
                                <small class="form-text text-muted">
                                    Maximum @(Model.NumberOfPassengers + Model.Flight.AvailableSeats) passengers available
                                </small>
                            </div>

                            <!-- Baggage Selection -->
                            <div class="form-section mb-4">
                                <label class="form-label fw-bold mb-3">Update Baggage Options</label>
                                
                                <!-- Carry-on Bags -->
                                <div class="baggage-section mb-3">
                                    <div class="d-flex justify-content-between align-items-center mb-2">
                                        <div>
                                            <h6 class="mb-1">Carry-on Bags</h6>
                                            <small class="text-muted">Free (up to 7kg each)</small>
                                        </div>
                                        <div class="baggage-selector">
                                            <div class="btn-group" role="group">
                                                @for (int i = 0; i <= 4; i++)
                                                {
                                                    <input type="radio" class="btn-check" name="carryOnBags" value="@i" id="carryOn@(i)" @(i == Model.CarryOnBags ? "checked" : "")>
                                                    <label class="btn btn-outline-secondary" for="carryOn@(i)">@i</label>
                                                }
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <!-- Checked Bags -->
                                <div class="baggage-section">
                                    <div class="d-flex justify-content-between align-items-center mb-2">
                                        <div>
                                            <h6 class="mb-1">Checked Bags</h6>
                                            <small class="text-muted">$30 per bag (up to 23kg each)</small>
                                        </div>
                                        <div class="baggage-selector">
                                            <div class="btn-group" role="group">
                                                @for (int i = 0; i <= 4; i++)
                                                {
                                                    <input type="radio" class="btn-check" name="checkedBags" value="@i" id="checked@(i)" @(i == Model.CheckedBags ? "checked" : "")>
                                                    <label class="btn btn-outline-secondary" for="checked@(i)">@i</label>
                                                }
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Updated Schedule Preview -->
                        <div class="preview-card bg-success text-white rounded p-4 mb-4 border border-success">
                            <h6 class="mb-3">
                                <i class="fas fa-eye me-2"></i>Your Rescheduled Flight Preview
                            </h6>
                            <div class="row">
                                <div class="col-md-4">
                                    <div class="preview-item mb-3">
                                        <small class="text-white opacity-75">Booking Reference</small>
                                        <div class="fw-bold fs-6">@Model.BookingReference</div>
                                    </div>
                                    <div class="preview-item">
                                        <small class="text-white opacity-75">Route</small>
                                        <div class="fw-bold fs-6">@Model.Flight.DepartureCity → @Model.Flight.ArrivalCity</div>
                                    </div>
                                </div>
                                <div class="col-md-4">
                                    <div class="preview-item mb-3">
                                        <small class="text-white opacity-75">New Departure</small>
                                        <div class="fw-bold fs-6" id="previewDeparture">@(Model.RescheduledDepartureTime?.ToString("MMM dd, yyyy HH:mm") ?? Model.Flight.DepartureTime.ToString("MMM dd, yyyy HH:mm"))</div>
                                    </div>
                                    <div class="preview-item">
                                        <small class="text-white opacity-75">New Arrival</small>
                                        <div class="fw-bold fs-6" id="previewArrival">@(Model.RescheduledArrivalTime?.ToString("MMM dd, yyyy HH:mm") ?? Model.Flight.ArrivalTime.ToString("MMM dd, yyyy HH:mm"))</div>
                                    </div>
                                </div>
                                <div class="col-md-4">
                                    <div class="preview-item mb-3">
                                        <small class="text-white opacity-75">Passengers</small>
                                        <div class="fw-bold fs-6" id="previewPassengers">@Model.NumberOfPassengers</div>
                                    </div>
                                    <div class="preview-item">
                                        <small class="text-white opacity-75">Total Amount</small>
                                        <div class="fw-bold fs-5" id="previewTotal">$@Model.TotalAmount.ToString("N2")</div>
                                    </div>
                                </div>
                            </div>
                            <div class="row mt-2">
                                <div class="col-12">
                                    <small class="text-white opacity-75">Bags</small>
                                    <div class="fw-bold fs-6" id="previewBags">@Model.CarryOnBags carry-on, @Model.CheckedBags checked</div>
                                </div>
                            </div>
                        </div>

                        <!-- Quick Actions -->
                        <div class="quick-actions bg-light rounded p-3 mb-4">
                            <h6 class="mb-3"><i class="fas fa-bolt me-2"></i>Quick Actions</h6>
                            <div class="row g-2">
                                <div class="col-md-4">
                                    <a asp-action="MyBookings" class="btn btn-outline-primary w-100">
                                        <i class="fas fa-list me-1"></i> All Bookings
                                    </a>
                                </div>
                                <div class="col-md-4">
                                    <a href="#" class="btn btn-outline-info w-100" 
                                       data-bs-toggle="modal" data-bs-target="#receiptModal"
                                       onclick="setReceiptDetails('@Model.BookingId', '@Model.BookingReference', '@Model.Flight.FlightNumber', '@Model.Flight.DepartureCity', '@Model.Flight.ArrivalCity', '@(Model.RescheduledDepartureTime?.ToString("MMM dd, yyyy HH:mm") ?? Model.Flight.DepartureTime.ToString("MMM dd, yyyy HH:mm"))', '@(Model.RescheduledArrivalTime?.ToString("MMM dd, yyyy HH:mm") ?? Model.Flight.ArrivalTime.ToString("MMM dd, yyyy HH:mm"))', '@Model.PassengerName', '@Model.NumberOfPassengers', '@Model.CarryOnBags', '@Model.CheckedBags', '@Model.TotalAmount.ToString("N2")', '@Model.BookingDate.ToString("MMM dd, yyyy")', '@Model.Status')">
                                        <i class="fas fa-receipt me-1"></i> View Receipt
                                    </a>
                                </div>
                                <div class="col-md-4">
                                    <a asp-action="BookingReceipt" asp-route-bookingId="@Model.BookingId" class="btn btn-outline-secondary w-100" target="_blank">
                                        <i class="fas fa-print me-1"></i> Print Receipt
                                    </a>
                                </div>
                            </div>
                        </div>

                        <!-- Action Buttons -->
                        <div class="d-grid gap-2 d-md-flex justify-content-md-end">
                            <a asp-action="MyBookings" class="btn btn-outline-secondary btn-lg me-md-2">
                                <i class="fas fa-arrow-left me-2"></i>Back to Bookings
                            </a>
                            <button type="button" class="btn btn-warning btn-lg px-4" id="confirmRescheduleBtn" data-bs-toggle="modal" data-bs-target="#confirmationModal">
                                <i class="fas fa-calendar-check me-2"></i>Confirm Reschedule
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Receipt Modal -->
<div class="modal fade" id="receiptModal" tabindex="-1" aria-labelledby="receiptModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header bg-success text-white">
                <h5 class="modal-title" id="receiptModalLabel">
                    <i class="fas fa-receipt me-2"></i>Booking Receipt
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="receipt-content">
                    <div class="text-center mb-4">
                        <i class="fas fa-check-circle fa-3x text-success mb-3"></i>
                        <h4 class="text-success">Booking Confirmed</h4>
                        <p class="text-muted">Booking Reference: <strong id="receiptBookingReference"></strong></p>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-6">
                            <h6>Flight Details</h6>
                            <p class="mb-1"><strong>Flight:</strong> <span id="receiptFlightNumber"></span></p>
                            <p class="mb-1"><strong>Route:</strong> <span id="receiptRoute"></span></p>
                            <p class="mb-1"><strong>Departure:</strong> <span id="receiptDeparture"></span></p>
                            <p class="mb-1"><strong>Arrival:</strong> <span id="receiptArrival"></span></p>
                        </div>
                        <div class="col-md-6">
                            <h6>Passenger Details</h6>
                            <p class="mb-1"><strong>Name:</strong> <span id="receiptPassengerName"></span></p>
                            <p class="mb-1"><strong>Passengers:</strong> <span id="receiptPassengers"></span></p>
                            <p class="mb-1"><strong>Bags:</strong> <span id="receiptBags"></span></p>
                            <p class="mb-1"><strong>Status:</strong> <span id="receiptStatus"></span></p>
                        </div>
                    </div>

                    <div class="payment-section bg-light rounded p-3">
                        <h6>Payment Summary</h6>
                        <div class="row">
                            <div class="col-6">
                                <p class="mb-1">Total Amount:</p>
                            </div>
                            <div class="col-6 text-end">
                                <p class="mb-1 fw-bold text-success fs-5">$<span id="receiptTotalAmount"></span></p>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-6">
                                <p class="mb-0 text-muted">Booked on: <span id="receiptBookingDate"></span></p>
                            </div>
                            <div class="col-6 text-end">
                                <p class="mb-0 text-muted">Booking ID: <span id="receiptBookingId"></span></p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                <a href="#" class="btn btn-primary" id="printReceiptBtn">
                    <i class="fas fa-print me-2"></i>Print Receipt
                </a>
            </div>
        </div>
    </div>
</div>

<!-- Confirmation Modal -->
<div class="modal fade" id="confirmationModal" tabindex="-1" aria-labelledby="confirmationModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header bg-warning text-white">
                <h5 class="modal-title" id="confirmationModalLabel">
                    <i class="fas fa-clock me-2"></i>Confirm Reschedule
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="text-center mb-4">
                    <i class="fas fa-plane fa-3x text-warning mb-3"></i>
                    <h5 class="mb-3">Ready to reschedule your flight?</h5>
                </div>
                
                <div class="confirmation-details bg-warning bg-opacity-10 rounded p-4 mb-4 border border-warning">
                    <h6 class="mb-3 text-dark">Rescheduled Flight Details</h6>
                    <div class="row mb-3">
                        <div class="col-6">
                            <small class="text-muted">Booking Reference</small>
                            <div class="fw-bold">@Model.BookingReference</div>
                        </div>
                        <div class="col-6">
                            <small class="text-muted">Flight</small>
                            <div class="fw-bold">@Model.Flight.FlightNumber</div>
                        </div>
                    </div>
                    <div class="row mb-3">
                        <div class="col-6">
                            <small class="text-muted">Route</small>
                            <div class="fw-bold">@Model.Flight.DepartureCity → @Model.Flight.ArrivalCity</div>
                        </div>
                        <div class="col-6">
                            <small class="text-muted">New Departure</small>
                            <div class="fw-bold text-dark" id="modalDeparture">@(Model.RescheduledDepartureTime?.ToString("MMM dd, yyyy HH:mm") ?? Model.Flight.DepartureTime.ToString("MMM dd, yyyy HH:mm"))</div>
                        </div>
                    </div>
                    <div class="row mb-3">
                        <div class="col-6">
                            <small class="text-muted">New Arrival</small>
                            <div class="fw-bold text-dark" id="modalArrival">@(Model.RescheduledArrivalTime?.ToString("MMM dd, yyyy HH:mm") ?? Model.Flight.ArrivalTime.ToString("MMM dd, yyyy HH:mm"))</div>
                        </div>
                        <div class="col-6">
                            <small class="text-muted">Passengers</small>
                            <div class="fw-bold text-dark" id="modalPassengers">@Model.NumberOfPassengers</div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-6">
                            <small class="text-muted">Bags</small>
                            <div class="fw-bold text-dark" id="modalBags">@Model.CarryOnBags carry-on, @Model.CheckedBags checked</div>
                        </div>
                        <div class="col-6">
                            <small class="text-muted">Total Amount</small>
                            <div class="fw-bold text-success" id="modalTotalAmount">$@Model.TotalAmount.ToString("N2")</div>
                        </div>
                    </div>
                </div>
                
                <div class="alert alert-info">
                    <small>
                        <i class="fas fa-info-circle me-2"></i>
                        Your flight will be rescheduled immediately. You'll receive an updated e-ticket via email.
                    </small>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                    <i class="fas fa-times me-2"></i>Cancel
                </button>
                <button type="button" class="btn btn-warning" id="finalConfirmBtn">
                    <i class="fas fa-check me-2"></i>Confirm Reschedule
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Set receipt details for modal
        function setReceiptDetails(bookingId, bookingReference, flightNumber, departureCity, arrivalCity, departureTime, arrivalTime, passengerName, passengers, carryOnBags, checkedBags, totalAmount, bookingDate, status) {
            document.getElementById('receiptBookingId').textContent = bookingId.substring(0, 8) + '...';
            document.getElementById('receiptBookingReference').textContent = bookingReference;
            document.getElementById('receiptFlightNumber').textContent = flightNumber;
            document.getElementById('receiptRoute').textContent = departureCity + ' → ' + arrivalCity;
            document.getElementById('receiptDeparture').textContent = departureTime;
            document.getElementById('receiptArrival').textContent = arrivalTime;
            document.getElementById('receiptPassengerName').textContent = passengerName;
            document.getElementById('receiptPassengers').textContent = passengers + ' passenger' + (passengers > 1 ? 's' : '');
            document.getElementById('receiptBags').textContent = carryOnBags + ' carry-on, ' + checkedBags + ' checked';
            document.getElementById('receiptTotalAmount').textContent = totalAmount;
            document.getElementById('receiptBookingDate').textContent = bookingDate;
            document.getElementById('receiptStatus').textContent = status;

            // Set print button link
            document.getElementById('printReceiptBtn').href = '@Url.Action("BookingReceipt", "User")?bookingId=' + bookingId;
        }

        // Real-time preview updates
        const departureInput = document.getElementById('newDepartureTime');
        const arrivalInput = document.getElementById('newArrivalTime');
        const passengersInput = document.getElementById('numberOfPassengers');
        const carryOnOptions = document.querySelectorAll('input[name="carryOnBags"]');
        const checkedOptions = document.querySelectorAll('input[name="checkedBags"]');
        const pricePerSeat = @Model.Flight.Price;
        const checkedBagFee = 30; // $30 per checked bag

        function updatePreview() {
            const departureDate = new Date(departureInput.value);
            const arrivalDate = new Date(arrivalInput.value);
            const passengerCount = parseInt(passengersInput.value) || 0;
            const carryOnBags = parseInt(document.querySelector('input[name="carryOnBags"]:checked').value);
            const checkedBags = parseInt(document.querySelector('input[name="checkedBags"]:checked').value);
            
            // Format dates for display
            const options = { 
                year: 'numeric', 
                month: 'short', 
                day: 'numeric',
                hour: '2-digit', 
                minute: '2-digit'
            };
            
            const formattedDeparture = departureDate.toLocaleDateString('en-US', options);
            const formattedArrival = arrivalDate.toLocaleDateString('en-US', options);
            const baseAmount = passengerCount * pricePerSeat;
            const baggageFee = checkedBags * checkedBagFee;
            const totalAmount = baseAmount + baggageFee;
            
            // Update preview with animation
            animateUpdate('previewDeparture', formattedDeparture);
            animateUpdate('previewArrival', formattedArrival);
            animateUpdate('previewPassengers', passengerCount.toString());
            animateUpdate('previewBags', carryOnBags + ' carry-on, ' + checkedBags + ' checked');
            animateUpdate('previewTotal', '$' + totalAmount.toFixed(2));
            
            // Update modal details
            animateUpdate('modalDeparture', formattedDeparture);
            animateUpdate('modalArrival', formattedArrival);
            animateUpdate('modalPassengers', passengerCount.toString());
            animateUpdate('modalBags', carryOnBags + ' carry-on, ' + checkedBags + ' checked');
            animateUpdate('modalTotalAmount', '$' + totalAmount.toFixed(2));
            
            // Validate arrival is after departure
            if (arrivalDate <= departureDate) {
                arrivalInput.setCustomValidity('Arrival time must be after departure time');
                arrivalInput.classList.add('is-invalid');
            } else {
                arrivalInput.setCustomValidity('');
                arrivalInput.classList.remove('is-invalid');
            }
        }

        function animateUpdate(elementId, newValue) {
            const element = document.getElementById(elementId);
            element.style.transform = 'scale(1.05)';
            element.style.transition = 'transform 0.2s ease';
            element.textContent = newValue;
            
            setTimeout(() => {
                element.style.transform = 'scale(1)';
            }, 200);
        }

        // Event listeners for real-time updates
        departureInput.addEventListener('change', updatePreview);
        arrivalInput.addEventListener('change', updatePreview);
        passengersInput.addEventListener('input', updatePreview);
        carryOnOptions.forEach(option => {
            option.addEventListener('change', updatePreview);
        });
        checkedOptions.forEach(option => {
            option.addEventListener('change', updatePreview);
        });

        // Final confirmation button click
        document.getElementById('finalConfirmBtn').addEventListener('click', function() {
            // Show loading state
            this.innerHTML = '<i class="fas fa-spinner fa-spin me-2"></i>Processing...';
            this.disabled = true;
            
            // Submit the form after a brief delay to show loading state
            setTimeout(() => {
                document.getElementById('rescheduleForm').submit();
            }, 1500);
        });

        // Reset final confirm button when modal is hidden
        document.getElementById('confirmationModal').addEventListener('hidden.bs.modal', function() {
            const finalConfirmBtn = document.getElementById('finalConfirmBtn');
            finalConfirmBtn.innerHTML = '<i class="fas fa-check me-2"></i>Confirm Reschedule';
            finalConfirmBtn.disabled = false;
        });

        // Initialize preview on page load
        document.addEventListener('DOMContentLoaded', function() {
            updatePreview();
        });
    </script>
}

<style>
    .card {
        border: none;
        border-radius: 12px;
    }

    .card-header {
        border-radius: 12px 12px 0 0 !important;
    }

    .current-flight-card {
        border-left: 4px solid #17a2b8;
    }

    .flight-info-item {
        padding: 0.25rem 0;
    }

    .form-section {
        background: #f8f9fa;
        padding: 1.5rem;
        border-radius: 8px;
        border: 1px solid #e9ecef;
